{
  "name": "NSH Gallery UI",
  "cssVars": {
    "theme": {
      "radius": "12px",
      "radius-card": "16px",
      "radius-control": "10px",
      "brand-fill": "#c8f26d",
      "on-brand": "#13160c"
    },
    "light": {
      "background": "#f4f4f2",
      "foreground": "#16171a",
      "card": "#ffffff",
      "card-foreground": "var(--foreground)",
      "popover": "#ffffff",
      "popover-foreground": "var(--foreground)",
      "primary": "#16171a",
      "primary-foreground": "#ffffff",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#f0f0ec",
      "muted-foreground": "#5f636a",
      "accent": "#e2e2dd",
      "accent-foreground": "var(--foreground)",
      "destructive": "#d43a4a",
      "border": "#d8d8d1",
      "input": "#cfcfc8",
      "ring": "var(--brand)",
      "chart-1": "var(--brand)",
      "chart-2": "var(--info)",
      "chart-3": "var(--warn)",
      "chart-4": "var(--up)",
      "chart-5": "var(--destructive)",
      "sidebar": "var(--inset)",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-accent": "var(--accent)",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "var(--line)",
      "sidebar-ring": "var(--ring)",
      "inset": "#f0f0ec",
      "raised": "#fbfbf9",
      "field": "#e8e8e3",
      "line": "#e2e2dc",
      "hover": "#ffffff",
      "faint": "#9a9ea4",
      "brand": "#4f6e0c",
      "track": "#e2e2dd",
      "knob": "#ffffff",
      "code": "#2a2d33",
      "info": "#3d63d1",
      "warn": "#b26a00",
      "up": "#138a5a",
      "down": "var(--destructive)",
      "brand-tint": "rgba(124, 170, 20, 0.14)",
      "info-tint": "color-mix(in srgb, var(--info) 10%, transparent)",
      "warn-tint": "color-mix(in srgb, var(--warn) 11%, transparent)",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "up-tint": "color-mix(in srgb, var(--up) 10%, transparent)",
      "down-tint": "color-mix(in srgb, var(--down) 10%, transparent)",
      "violet": "#6e56c4"
    },
    "dark": {
      "background": "#101113",
      "foreground": "#eceef1",
      "card": "#18191c",
      "popover": "#1d1f22",
      "primary": "#eef0f2",
      "primary-foreground": "#111214",
      "muted": "#24262a",
      "muted-foreground": "#8d9198",
      "accent": "#24262a",
      "destructive": "#ff6170",
      "border": "#2c2e33",
      "input": "#2c2e33",
      "inset": "#0c0d0f",
      "raised": "#24262a",
      "field": "#0c0d0f",
      "line": "#24262a",
      "hover": "#1f2124",
      "faint": "#5a5e65",
      "brand": "#c8f26d",
      "track": "#24262a",
      "knob": "#8d9198",
      "code": "#d9dde3",
      "info": "#7ea8ff",
      "warn": "#ffb547",
      "up": "#45d49a",
      "brand-tint": "color-mix(in srgb, var(--brand) 14%, transparent)",
      "info-tint": "color-mix(in srgb, var(--info) 16%, transparent)",
      "warn-tint": "color-mix(in srgb, var(--warn) 16%, transparent)",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 16%, transparent)",
      "up-tint": "color-mix(in srgb, var(--up) 16%, transparent)",
      "down-tint": "color-mix(in srgb, var(--down) 16%, transparent)",
      "violet": "#b9a2ff",
      "card-foreground": "var(--foreground)",
      "popover-foreground": "var(--foreground)",
      "accent-foreground": "var(--foreground)",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "chart-1": "var(--brand)",
      "chart-2": "var(--up)",
      "chart-3": "var(--info)",
      "chart-4": "var(--warn)",
      "chart-5": "var(--down)",
      "ring": "var(--brand)",
      "sidebar": "var(--inset)",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-accent": "var(--raised)",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "var(--line)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-ring": "var(--ring)",
      "down": "var(--destructive)"
    }
  }
}
