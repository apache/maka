<script>
  // The language panel: Rust first, TSX beside it, as the docs' code tabs.
  for (const langs of document.querySelectorAll<HTMLElement>('[data-langs]')) {
    const tabs = [...langs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const file = langs.querySelector<HTMLElement>('[data-lang-file]');
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) {
          panel.hidden = !on;
          if (on && file) file.textContent = panel.dataset.file ?? '';
        }
      }
    };
    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        const next = tabs[(tabs.indexOf(tab) + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
        next.focus();
      });
    }
  }
  // The hero's chat follows the page's theme: the player's `?theme=` when
  // it loads, a message when the theme changes. Replay reloads it, which
  // plays the scenario again.
  for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
    const frame = stage.querySelector<HTMLIFrameElement>('[data-chat]');
    if (!frame) continue;
    const theme = () => (document.documentElement.classList.contains('light') ? 'light' : 'dark');
    const themed = (src: string) => src.replace(/theme=(dark|light)/, `theme=${theme()}`);
    // The URL waits in `data-player-src` until the theme is known, so the
    // chat loads once, in the page's theme.
    frame.src = themed(frame.dataset.playerSrc!);
    new MutationObserver(() => frame.contentWindow?.postMessage({ theme: theme() }, '*')).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
    stage.querySelector('[data-replay]')?.addEventListener('click', () => (frame.src = themed(frame.src)));
  }
</script>

<style>
  /* Layout: one container per band (gpui-kit DESIGN.md). */
  .home { --section-gap: 6rem; }
  section { position: relative; border-top: 1px solid var(--line); }
  section:first-child { border-top: 0; }
  /* Same left edge and width as the nav and the footer (x=80, w=1280 at 1440px). */
  .band__inner {
    position: relative;
    width: min(1280px, calc(100% - 3rem));
    margin: 0 auto;
    padding: var(--section-gap) 0;
  }
  .band--tinted { background: var(--band-tinted); }
  .section-head { max-width: 44rem; margin-bottom: 3rem; }
  h1, h2 { text-wrap: balance; }
  .kicker { display: block; color: var(--citrus); font: 600 0.68rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }
  html[lang^="zh"] .kicker { letter-spacing: 0.06em; }
  .section-head h2, .principle h2 { margin: 0.9rem 0 0; font-size: clamp(1.9rem, 3.6vw, 2.75rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 700; }
  html[lang^="zh"] .section-head h2, html[lang^="zh"] .principle h2 { letter-spacing: 0; line-height: 1.2; }
  .section-head p { margin: 1rem 0 0; color: var(--muted-foreground); font-size: 1.02rem; line-height: 1.6; }

  /* Buttons as in the gallery: dark raised secondary, light primary. */
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; height: 2.5rem; padding: 0 1.05rem; border: 1px solid var(--border); border-radius: var(--radius-control); background: var(--finish-raised-bg); box-shadow: var(--finish-raised); color: var(--foreground); font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: border-color .15s, filter .15s; }
  .btn:hover { border-color: var(--border-hover); filter: brightness(1.08); }
  .btn--primary { border-color: transparent; background: var(--finish-primary-bg); box-shadow: var(--finish-primary); color: var(--brand-contrast); }
  .btn--primary:hover { border-color: transparent; background: var(--finish-primary-hover-bg); filter: none; }

  /* Hero */
  .hero { overflow: hidden; }
  /* The accent's glow behind the device, as behind the app icon's mark. */
  .hero__inner { z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4rem; padding-top: 4.5rem; padding-bottom: 4.5rem; }
  .hero__copy { min-width: 0; max-width: 36rem; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.7rem; border: 1px solid color-mix(in srgb, var(--citrus) 28%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--citrus) 9%, transparent); color: var(--citrus); font-size: 0.78rem; font-weight: 600; }
  .eyebrow__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--citrus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--citrus) 20%, transparent); }
  h1 { margin: 1.25rem 0 0; font-size: clamp(2.6rem, 5.2vw, 4.1rem); line-height: 1.02; letter-spacing: -0.045em; font-weight: 750; }
  html[lang^="zh"] h1 { letter-spacing: -0.01em; line-height: 1.16; font-size: clamp(1.9rem, 4.2vw, 2.9rem); }
  .hero__lead { margin: 1.25rem 0 0; color: var(--muted-foreground); font-size: 1.1rem; line-height: 1.6; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__platforms { display: grid; gap: 0.6rem; margin-top: 1.75rem; }
  .hero__platforms > span { display: flex; align-items: center; gap: 0.55rem; color: var(--muted-foreground); font-size: 0.85rem; }
  .hero__platforms > span :global(svg) { flex-shrink: 0; color: var(--faint); }
  .hero__platforms ul { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .hero__platforms li { padding: 0.25rem 0.65rem; border: 1px solid var(--border); border-radius: 999px; background: var(--finish-raised-bg); box-shadow: var(--finish-raised); font-size: 0.8rem; font-weight: 600; }
  .hero__points { display: grid; gap: 0.7rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .hero__points li { display: flex; align-items: flex-start; gap: 0.65rem; color: var(--muted-foreground); font-size: 0.93rem; line-height: 1.5; }
  .hero__points :global(svg) { flex-shrink: 0; margin-top: 0.15rem; color: var(--citrus); }
  .hero__points strong { margin-right: 0.5rem; color: var(--foreground); font-weight: 650; }
  .hero__meta { display: flex; flex-wrap: wrap; column-gap: 1.25rem; row-gap: 0.45rem; margin: 1.25rem 0 0; padding: 0; list-style: none; color: var(--muted-foreground); font-size: 0.85rem; }
  .hero__meta li { display: flex; align-items: center; gap: 0.55rem; }
  .hero__meta :global(svg) { flex-shrink: 0; color: var(--faint); }
  .hero__snippet { display: inline-flex; align-items: stretch; margin-top: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--code-bg); box-shadow: var(--finish-inset); font: 0.78rem/1 var(--font-mono); overflow: hidden; max-width: 100%; }
  .hero__snippet span { padding: 0.55rem 0.65rem; border-right: 1px solid var(--line); color: var(--faint); }
  .hero__snippet code { padding: 0.55rem 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--code-fg); }

  /* The live chat in a card frame of the site's design (the card finish),
     a slim bar with the file and a live badge, the app on an inset surface;
     phone width, so the app lays out as on a phone. */
  .stage { --w: 392px; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .device {
    width: var(--w); padding: 0 8px 8px; border: 1px solid var(--border); border-radius: 20px;
    background: var(--card) var(--finish-card-bg); box-shadow: var(--finish-card), var(--shadow-window);
  }
  .device__bar { display: flex; align-items: center; gap: 8px; height: 40px; margin: 0 -8px; padding: 0 14px; border-radius: 20px 20px 0 0; background: linear-gradient(180deg, color-mix(in srgb, var(--foreground) 3%, transparent), transparent); }
  .device__tile { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid var(--accent-border); border-radius: 7px; background: var(--finish-accent-bg); box-shadow: var(--finish-accent); color: var(--on-citrus); }
  .device__title { color: var(--muted-foreground); font: 0.75rem/1 var(--font-mono); }
  .device__badge { display: inline-flex; align-items: center; gap: 5px; margin-left: auto; padding: 2px 8px; border-radius: 999px; background: color-mix(in srgb, var(--success) 14%, transparent); box-shadow: inset 0 1px 0 var(--highlight), inset 0 0 0 1px color-mix(in srgb, var(--success) 18%, transparent); color: var(--success); font-size: 11px; font-weight: 600; }
  .device__badge i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .device__screen {
    position: relative; height: 600px; border-radius: 14px; overflow: hidden;
    background: var(--inset); box-shadow: 0 0 0 1px var(--line);
  }
  .device__screen::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: var(--finish-inset); pointer-events: none; }
  .device__screen iframe { display: block; width: 100%; height: 100%; border: 0; }
  .device__pending { display: grid; place-items: center; height: 100%; margin: 0; padding: 2rem; color: var(--muted-foreground); font-size: 0.85rem; text-align: center; }

  .legend { display: grid; gap: 8px; justify-items: start; max-width: var(--w); font-size: 0.8rem; line-height: 1.5; color: var(--muted-foreground); }
  .legend__replay { padding: 0; border: 0; background: none; color: var(--foreground); font: inherit; font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--brand-line); }

  /* Capability grid: hairline cells, one diagram box each. */
  .caps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .cap { display: flex; flex-direction: column; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-surface); background: var(--finish-card-bg); box-shadow: var(--finish-card); }
  .cap h3 { display: flex; align-items: center; gap: 0.55rem; margin: 0; font-size: 1rem; font-weight: 650; letter-spacing: -0.01em; }
  .cap h3 :global(svg) { flex-shrink: 0; color: var(--citrus); }
  .cap p { margin: 0.6rem 0 0; color: var(--muted-foreground); font-size: 0.9rem; line-height: 1.6; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 1rem 0 1.25rem; padding: 0; list-style: none; }
  .chips li { padding: 0.15rem 0.5rem; border: 1px solid var(--border); border-radius: 6px; background: var(--raised); color: var(--muted-foreground); font: 0.7rem/1.4 var(--font-mono); }
  .mini { margin-top: auto; height: 104px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--inset); box-shadow: var(--finish-inset); overflow: hidden; }

  .mini-code { position: relative; display: grid; gap: 7px; padding-top: 22px; }
  .mini-file { position: absolute; top: 0; left: 0; font: 600 10px/1 var(--font-mono); color: var(--muted-foreground); }
  .mini-code i { display: block; height: 6px; width: var(--w); margin-left: var(--x, 0); border-radius: 3px; background: color-mix(in srgb, var(--c) 55%, transparent); }
  .mini-plugin { display: grid; place-items: center; height: 100%; }
  .mini-plugin .app { display: grid; gap: 8px; width: 100%; max-width: 240px; padding: 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--finish-raised-bg); box-shadow: var(--finish-raised); }
  .mini-plugin .app i { display: block; height: 5px; width: var(--w); border-radius: 3px; background: color-mix(in srgb, var(--foreground) 18%, transparent); }
  .mini-plugin .slot { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 8px; border: 1.5px dashed color-mix(in srgb, var(--data-3) 55%, transparent); border-radius: 7px; color: var(--data-3); font: 600 10.5px/1 var(--font-mono); white-space: nowrap; }
  .mini-plugin .slot code { font: inherit; }
  .mini-plugin .slot span { display: grid; place-items: center; }
  .mini-fast { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 14px; height: 100%; }
  .mini-fast .frames { position: relative; display: flex; align-items: flex-end; gap: 4px; height: 64px; }
  .mini-fast .frames i { flex: 1; height: var(--h); border-radius: 2px 2px 0 0; background: color-mix(in srgb, var(--citrus) 55%, transparent); }
  .mini-fast .budget { position: absolute; left: 0; right: 0; top: 18%; border-top: 1px dashed color-mix(in srgb, var(--muted-foreground) 60%, transparent); }
  .mini-fast .budget code { position: absolute; right: 0; top: -16px; font: 10px var(--font-mono); color: var(--muted-foreground); }
  .mini-fast .fps { display: grid; justify-items: end; line-height: 1; }
  .mini-fast .fps strong { font-size: 28px; font-weight: 700; color: var(--citrus); }
  .mini-fast .fps code { font: 11px var(--font-mono); color: var(--muted-foreground); }
  .mini-checks { display: grid; gap: 10px; margin: 6px 0 0; padding: 0; list-style: none; }
  .mini-checks li { display: grid; grid-template-columns: 14px 44px 1fr; align-items: center; gap: 8px; }
  .mini-checks span { display: grid; place-items: center; color: var(--success); }
  .mini-checks code { font: 11px var(--font-mono); color: var(--muted-foreground); }
  .mini-checks i { display: block; height: 5px; width: var(--w); border-radius: 3px; background: color-mix(in srgb, var(--success) 40%, transparent); }
  .mini-sandbox { display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: center; height: 100%; }
  .meters { display: grid; gap: 9px; }
  .meters span { display: grid; grid-template-columns: 48px 1fr; align-items: center; gap: 8px; }
  .meters code { font: 10.5px var(--font-mono); color: var(--muted-foreground); }
  .meters i { position: relative; display: block; height: 5px; border-radius: 3px; background: color-mix(in srgb, var(--foreground) 8%, transparent); overflow: hidden; }
  .meters i::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: 3px; background: var(--citrus); }
  .grants { display: grid; gap: 6px; }
  .grant { padding: 3px 7px; border-radius: 4px; font: 10.5px/1.3 var(--font-mono); white-space: nowrap; }
  .grant--ok { background: color-mix(in srgb, var(--success) 12%, transparent); color: color-mix(in srgb, var(--success) 85%, var(--foreground)); }
  .grant--no { background: color-mix(in srgb, var(--foreground) 6%, transparent); color: var(--muted-foreground); text-decoration: line-through; }
  .mini-signed { display: flex; align-items: center; justify-content: center; height: 100%; gap: 8px; }
  .mini-signed .node { display: inline-flex; align-items: center; gap: 5px; padding: 6px 9px; border: 1px solid var(--border); border-radius: 7px; background: var(--finish-raised-bg); box-shadow: var(--finish-raised); font: 600 10.5px/1 var(--font-mono); white-space: nowrap; }
  .mini-signed .node--key { color: var(--data-3); border-color: color-mix(in srgb, var(--data-3) 35%, var(--border)); }
  .mini-signed .node--ok { color: var(--success); border-color: color-mix(in srgb, var(--success) 35%, var(--border)); }
  .mini-signed .dash { flex: 1; max-width: 26px; border-top: 1.5px dashed color-mix(in srgb, var(--foreground) 30%, transparent); }
  .mini-native { position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; height: 100%; gap: 8px; }
  .mini-native .menu { display: inline-flex; border-radius: 8px; background: #1c1c1e; color: #fff; font-size: 11px; box-shadow: 0 4px 12px rgb(0 0 0 / 18%); overflow: hidden; }
  .mini-native .menu span { padding: 5px 8px; border-right: 0.5px solid rgb(255 255 255 / 18%); }
  .mini-native .menu span:last-child { border-right: 0; }
  .mini-native p { margin: 0; font-size: 12.5px; color: var(--foreground); }
  .mini-native mark { background: color-mix(in srgb, var(--selection) 30%, transparent); color: inherit; border-radius: 2px; box-shadow: -1px 0 0 var(--selection), 1px 0 0 var(--selection); }

  /* Rust or TSX: one panel, a tab per language. */
  .langs-band { display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: 3rem; align-items: start; }
  .langs-band .use__cta { padding-top: 1.25rem; }
  .langs { min-width: 0; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--code-bg); box-shadow: var(--finish-inset); overflow: hidden; }
  .langs__tabs { display: flex; align-items: center; gap: 0.25rem; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--line); }
  .langs__tabs button { padding: 0.35rem 0.75rem; border: 1px solid transparent; border-radius: 6px; background: none; color: var(--muted-foreground); font: 600 0.78rem/1 var(--font-mono); cursor: pointer; }
  .langs__tabs button[aria-selected="true"] { border-color: var(--border); background: var(--finish-raised-bg); box-shadow: var(--finish-raised); color: var(--foreground); }
  .langs__file { margin-left: auto; padding-right: 0.4rem; color: var(--faint); font: 0.72rem/1 var(--font-mono); }
  .langs__code { margin: 0; padding: 1rem 1.1rem; font: 0.78rem/1.65 var(--font-mono); color: var(--code-fg); overflow-x: auto; white-space: pre; }
  /* Three uses */
  .uses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .use { display: flex; flex-direction: column; padding: 1.75rem; border: 1px solid var(--border); border-radius: var(--radius-surface); background: var(--finish-card-bg); box-shadow: var(--finish-card); }
  .use--primary { border-color: color-mix(in srgb, var(--citrus) 40%, var(--border)); }
  .use__label { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font: 600 0.72rem/1 var(--font-mono); color: var(--muted-foreground); }
  .use__tag { padding: 3px 8px; border-radius: 999px; background: color-mix(in srgb, var(--citrus) 14%, transparent); color: var(--citrus); font-size: 0.66rem; letter-spacing: 0.02em; }
  .use h3 { margin: 1.1rem 0 0; font-size: 1.2rem; font-weight: 650; letter-spacing: -0.015em; }
  .use p { margin: 0.6rem 0 0; color: var(--muted-foreground); font-size: 0.9rem; line-height: 1.6; min-height: 4.3em; }
  .use__code { margin: 1.25rem 0 0; padding: 0.9rem 1rem; height: 9.2rem; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--code-bg); box-shadow: var(--finish-inset); font: 0.74rem/1.65 var(--font-mono); color: var(--code-fg); overflow: hidden; white-space: pre; }
  .use__checks { display: grid; gap: 0.55rem; margin: 1.25rem 0 0; padding: 0; list-style: none; font-size: 0.85rem; color: var(--muted-foreground); }
  .use__checks li { display: flex; align-items: center; gap: 0.55rem; }
  .use__checks :global(svg) { color: var(--success); flex-shrink: 0; }
  .use__cta { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: auto; padding-top: 1.75rem; color: var(--foreground); font-size: 0.88rem; font-weight: 600; text-decoration: none; }
  .use__cta:hover { color: var(--citrus); }
  :global(.c-k) { color: var(--code-keyword); }
  :global(.c-s) { color: var(--code-string); }
  :global(.c-f) { color: var(--code-fn); }
  :global(.c-t) { color: var(--code-type); }
  :global(.c-c) { color: var(--code-comment); }

  /* How it works */
  .diagram { padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-surface); background: var(--finish-card-bg); box-shadow: var(--finish-card); }
  /* At its natural size at most (never upscaled), centred. */
  .diagram img { display: block; width: 100%; max-width: 880px; height: auto; margin-inline: auto; }
  .diagram--dark { display: none !important; }
  :global(.dark) .diagram--light { display: none !important; }
  :global(.dark) .diagram--dark { display: block !important; }

  /* Platforms */
  .section-head--side { margin-bottom: 0; }
  .platforms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border: 1px solid var(--border); border-radius: var(--radius-surface); overflow: hidden; background: var(--finish-card-bg); box-shadow: var(--finish-card); }
  .platform { display: grid; align-content: start; gap: 0.35rem; padding: 1.25rem 1.25rem 1.4rem; border-right: 1px solid var(--line); }
  .platform:nth-child(3n) { border-right: 0; }
  .platform:not(:last-child) { border-bottom: 1px solid var(--line); }
  /* A last platform alone in its row spans it, as the web does after the six apps. */
  .platform:last-child { grid-column: 1 / -1; border-right: 0; }
  .platform__name { font-size: 1.05rem; font-weight: 650; }
  .platform__detail { font: 0.75rem/1.4 var(--font-mono); color: var(--muted-foreground); }
  .platform__cmd { font: 0.72rem/1.4 var(--font-mono); color: var(--faint); }

  /* Principle */
  .principle { overflow: hidden; }
  .principle__grid { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(to right, color-mix(in srgb, var(--foreground) 5%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--foreground) 5%, transparent) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(60% 90% at 85% 50%, black 10%, transparent 70%); }
  .principle__inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
  .principle p { margin: 0 0 1.5rem; color: var(--muted-foreground); line-height: 1.65; }


  /* Native, in two ways: two numbered layers, then a backend per platform. */
  .layers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .layer { padding: 1.75rem; border: 1px solid var(--border); border-radius: var(--radius-surface); background: var(--finish-card-bg); box-shadow: var(--finish-card); }
  .layer__n { color: var(--citrus); font: 600 0.75rem/1 var(--font-mono); letter-spacing: 0.08em; }
  .layer h3 { margin: 0.9rem 0 0; font-size: 1.2rem; font-weight: 650; letter-spacing: -0.015em; }
  .layer p { margin: 0.6rem 0 0; color: var(--muted-foreground); font-size: 0.92rem; line-height: 1.65; }
  .platforms-head { margin: 2.5rem 0 1rem; color: var(--muted-foreground); font: 600 0.72rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .caps--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .caps-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.75rem; margin: 0 0 1rem; color: var(--citrus); font: 600 0.72rem/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .caps-head span { color: var(--muted-foreground); font: 400 0.85rem/1.4 var(--font-sans, inherit); letter-spacing: 0; text-transform: none; }
  .caps--three + .caps-head { margin-top: 2.5rem; }

  /* Minis of the cross-platform band: wide and narrow frames of one app. */
  .mini-layout, .mini-adapt { display: flex; align-items: flex-end; justify-content: center; gap: 12px; height: 100%; }
  .mini-layout .frame, .mini-adapt .frame { position: relative; display: flex; gap: 4px; padding: 5px; border: 1px solid var(--border); border-radius: 7px; background: var(--finish-raised-bg); box-shadow: var(--finish-raised); overflow: hidden; }
  .frame--wide { width: 128px; height: 72px; }
  .frame--narrow { width: 52px; height: 72px; border-radius: 9px !important; }
  .mini-layout .col { display: block; border-radius: 3px; background: color-mix(in srgb, var(--foreground) 12%, transparent); }
  .mini-layout .col--side { width: 18%; background: color-mix(in srgb, var(--citrus) 35%, transparent); }
  .mini-layout .col--list { width: 30%; }
  .mini-layout .col--main { flex: 1; background: color-mix(in srgb, var(--data-3) 28%, transparent); }
  .mini-adapt .popup, .mini-adapt .sheet { position: absolute; display: grid; gap: 1px; padding: 3px; border: 1px solid var(--border); background: var(--card); box-shadow: 0 4px 10px rgb(0 0 0 / 22%); }
  .mini-adapt .popup { top: 14px; left: 34px; border-radius: 6px; }
  .mini-adapt .sheet { left: 3px; right: 3px; bottom: 3px; border-radius: 6px 6px 5px 5px; }
  .mini-adapt i { padding: 2px 6px; border-radius: 3px; color: var(--foreground); font: normal 8.5px/1.3 var(--font-sans, inherit); white-space: nowrap; }
  .mini-adapt .popup i:first-child { background: color-mix(in srgb, var(--citrus) 22%, transparent); }
  .mini-adapt .sheet i { padding: 2px 3px; font-size: 7px; text-align: center; }

  /* Minis of the foundations band. */
  .mini-dom { display: grid; gap: 4px; align-content: center; height: 100%; }
  .mini-dom code { margin-left: var(--x); font: 10.5px/1.2 var(--font-mono); color: var(--code-type); }
  .mini-base { display: flex; align-items: center; justify-content: center; gap: 12px; height: 100%; }
  .mini-base .trigger { padding: 6px 12px; border: 1.5px dashed color-mix(in srgb, var(--foreground) 30%, transparent); border-radius: 7px; color: var(--muted-foreground); font: 600 11px/1 var(--font-mono); }
