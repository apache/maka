---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Brand from '../components/Brand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/site';
---

<BaseLayout
  lang="en"
  title="Brand"
  description="The Native Shell logo, app icon, banners and social previews, ready to download, with its colors and typeface."
  alternates={{ en: '/brand', 'zh-CN': '/zh-CN/brand' }}
>
  <Nav lang="en" currentPath={Astro.url.pathname} langHref={url('zh-CN/brand')} />
  <main id="main">
    <Brand lang="en" />
  </main>
  <SiteFooter lang="en" />
</BaseLayout>
