# ============================================================
# account-registration-script 环境变量模板
# 复制为 .env 并填入真实值。.env 已被 gitignore,不会提交。
# ============================================================

# ---- 短信渠道 ----
REG_SMS_PROVIDER=herosms           # herosms | fivesim
HERO_SMS_API_KEY=
HERO_SMS_SERVICE=dr                # OpenAI 的服务码
HERO_SMS_COUNTRY=16                # 英国
FIVE_SIM_API_KEY=
FIVE_SIM_PRODUCT=openai
FIVE_SIM_COUNTRY=england
FIVE_SIM_OPERATOR=any

# ---- 邮箱渠道 ----
REG_MAIL_PROVIDER=legacy           # legacy | yyds
MAIL_BASE_URL=
MAIL_ADMIN_PASSWORD=
MAIL_SITE_PASSWORD=
MAIL_DOMAIN=
YYDS_MAIL_BASE_URL=
YYDS_MAIL_API_KEY=
YYDS_MAIL_DOMAIN=
YYDS_MAIL_SUBDOMAIN=

# ---- IMAP 外部邮箱(用已有邮箱收验证码) ----
# REG_MAIL_PROVIDER=imap
# IMAP_USER=your_email@gmail.com
# IMAP_PASSWORD=your_app_specific_password
# IMAP_HOST=                      # 可选,自动根据域名推断(Gmail→imap.gmail.com,Outlook→outlook.office365.com,...)
# IMAP_PORT=993                   # 可选,默认 993(IMAPS)
# IMAP_TLS=true                   # 可选,默认 true
# 注意:Gmail 需在 Google 账号设置中生成「应用专用密码」
#      Outlook/Hotmail 需使用应用专用密码或改用 mail-sdk 的 GraphProvider
#      QQ/163 需在邮箱设置中开启 IMAP/SMTP 服务并使用授权码(非登录密码)

# ---- CDK API 邮箱(CDK 兑换的 Outlook 长效邮箱) ----
# REG_MAIL_PROVIDER=cdk
# CDK_KEY=Mail-82621d2b42074af8ba17dc007
# CDK_EMAIL=p4P0E5lhL9@outlook.com
# CDK_API_BASE_URL=https://cdk.hhnto.top   # 可选,默认值

# ---- 浏览器 ----
BROWSER_ENGINE=puppeteer-real      # puppeteer-real | playwright
BROWSER_HEADLESS=false
BROWSER_LANG=zh-CN
# BROWSER_EXECUTABLE_PATH=

# ---- OAuth ----
OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OAUTH_REDIRECT_PORT=1455
# TOKEN_OUTPUT_DIRS=data/gpt-free;data/tokens
# DB_PATH=data/app.db
# LOG_DIR=data/logs

# ---- 代理(可选) ----
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_LIST=host1:port1:user1:pass1,host2:port2:user2:pass2  # 代理池(逗号分隔,优先于单一代理)
# PROXY_STRATEGY=round-robin                                     # round-robin | random | least-used

# ---- CPA 上传(可选) ----
# CPA_BASE_URL=
# CPA_MANAGEMENT_KEY=
CPA_UPLOAD_ENABLED=false

# ---- 合规护栏 ----
COMPLIANCE_MAX_ACCOUNTS_PER_HOUR=5
COMPLIANCE_MIN_DELAY_MS=60000
COMPLIANCE_REQUIRE_CONFIRMATION=true
