# mail-sdk 环境变量示例。复制为 .env,examples/ 脚本通过 dotenv 读取。

# ---- IMAP(通用:Gmail/QQ/163/Outlook 等)----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_address@gmail.com
IMAP_PASS=your_app_specific_password

# ---- temp-mail(Mail.tm,无需自有账号)----
TEMPMAIL_DOMAIN=

# ---- 集成测试开关(留空则跑 mail.tm 集成测试;=1 跳过)----
SKIP_INTEGRATION=1
