{
  "project": {
    "name": "agent-suite",
    "repo_type": "monorepo",
    "description": "ggbdpq 微服务总仓迁移项目，目标是将现有子项目工程化为可长期维护的微服务总仓结构。",
    "stack": {
      "frontend": "React 19 + TypeScript + Vite 8 + React Router 7 + Tailwind CSS v4",
      "state": "Zustand + TanStack Query",
      "schema": "Zod",
      "ui_components": "shadcn/ui (cva + tailwind-merge + clsx + lucide-react)",
      "desktop_shell": "Tauri v2",
      "backend": "NestJS / Hono / Fastify (按服务选型)",
      "pkg_manager": "pnpm"
    },
    "ssot": {
      "prd": ".ggbdpq/actions/agent-suite/prd.json",
      "progress": ".ggbdpq/actions/agent-suite/progress.txt"
    }
  },
  "items": [
    {
      "id": "001",
      "title": "生成 stack-inventory 与 stack-contract 并完成文档校对",
      "priority": "P1",
      "passes": true,
      "steps": [
        {
          "desc": "扫描 apps/*, tools/*, services/*, packages/* 目录结构",
          "commands": [
            "ls -la apps/ tools/ packages/ 2>/dev/null || true",
            "ls -la services/ 2>/dev/null || echo 'services/ 不存在'"
          ],
          "touched_paths": []
        },
        {
          "desc": "收集所有子项目的 package.json 依赖信息",
          "commands": [
            "find . -name 'package.json' -not -path './node_modules/*' | head -30"
          ],
          "touched_paths": []
        },
        {
          "desc": "生成 docs/stack-inventory.md 清点表",
          "commands": [
            "cat docs/stack-inventory.md | head -50"
          ],
          "touched_paths": [
            "docs/stack-inventory.md"
          ]
        },
        {
          "desc": "生成 docs/stack-contract.md 技术栈契约",
          "commands": [
            "cat docs/stack-contract.md | head -50"
          ],
          "touched_paths": [
            "docs/stack-contract.md"
          ]
        },
        {
          "desc": "人工校对文档内容与格式",
          "commands": [
            "test -f docs/stack-inventory.md && test -f docs/stack-contract.md && echo 'PASS'"
          ],
          "touched_paths": []
        }
      ],
      "acceptance": [
        "docs/stack-inventory.md 存在且包含所有子项目清点信息",
        "docs/stack-contract.md 存在且包含目标技术栈定义",
        "两个文档格式正确，无 markdown 语法错误"
      ],
      "risks": [
        "部分子项目可能缺少 package.json"
      ],
      "notes": "已于 2026-01-26 完成"
    },
