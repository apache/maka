{
  "meta": {
    "product": "cc-switch",
    "version": "2.1.0",
    "owner": "ggbdpq",
    "language": "zh-CN",
    "positioning": "一个企业级、可审计、可回滚的 Claude Code settings.json 桌面控制平面",
    "core_principle": [
      "真实文件读写",
      "禁止 mock / 假数据",
      "任何写入必须可回滚",
      "任何变更必须可审计"
    ],
    "runtime": {
      "desktop": "Tauri 2.x (macOS 优先)",
      "frontend": "React 19 + TypeScript + Vite 7",
      "ui": "Tailwind CSS 4 + macOS 原生风格",
      "state": "Zustand 5",
      "data": "真实 settings.json（非模拟）",
      "validation": "Zod",
      "test": "Vitest + Rust unit test"
    },
    "last_updated": "2026-01-14"
  },
  "global_constraints": {
    "no_mock": true,
    "language_rule": "除非用户明确要求英文，否则所有解释、日志、提交信息、进度记录必须为简体中文",
    "security": [
      "env 中的 TOKEN / KEY / SECRET / PASSWORD 必须脱敏显示",
      "禁止在日志、progress、commit message 中输出明文凭据",
      "任何异常情况下不得写空 settings.json"
    ]
  },
  "data_model": {
    "settings_json": {
      "source": "~/.claude/settings.json",
      "schema_rules": {
        "enabledPlugins": "Record<string, boolean>",
        "env": "Record<string, string>",
        "language": "string",
        "includeCoAuthoredBy": "boolean",
        "others": "unknown but preserved (via extra field)"
      },
      "sensitive_keys_match": [
        "TOKEN",
        "KEY",
        "SECRET",
        "PASSWORD",
        "CREDENTIAL",
        "AUTH"
      ]
    },
    "backup": {
      "location": "~/.claude/backups/",
      "format": "settings.json.bak-YYYYMMDD_HHMMSS"
    },
    "audit_log": {
      "location": "~/.claude/audit/",
      "format": "audit.jsonl",
      "fields": [
        "timestamp",
        "action",
        "before_hash",
        "after_hash",
        "changed_keys",
        "backup_file"
      ]
    }
  },
