{
  "name": "@maka-agent/plugin-sdk",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.acceptance.json",
    "schema:generate": "node scripts/generate.mjs generate",
    "schema:check": "node scripts/generate.mjs check"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  }
}
