{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // The generated service contracts are 1.8 MB; accept the same 4 MiB
    // output supported by the SDK generator instead of silently skipping them.
    "maxSize": 4194304,
    // Broad include; VCS integration (useIgnoreFile) already skips anything
    // in .gitignore (node_modules, dist, etc). The excludes below cover
    // tracked files that still shouldn't be touched by Biome.
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!package-lock.json",
      "!plugins/agent/providers/data/*.json",
      "!plugins/settings/store/data/*.json",
      "!website/**",
      // Vendored NSH keeps upstream formatting; provenance is recorded in SOURCE.md.
      "!third-party/nsh/**"
    ]
  },
  // Formatter enabled together with the one-time whole-tree baseline commit
  // in this PR (see .git-blame-ignore-revs) and a `biome format` check-mode
  // CI gate. Style matches the dominant existing conventions so the baseline
  // diff is minimal churn, not a restyle.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    // The extracted Playwright payload is checked against its recorded upstream
    // hash. Format the authored adapter files without rewriting that payload.
    "includes": [
      "**",
      "!third-party/playwright/injected.js",
      // Rust embeds these as expressions; module formatting adds a trailing semicolon.
      "!platform/computer-use/src/browser/capability/*.js",
      "!platform/computer-use/src/browser/playwright/readonly-evaluate.js",
      "!platform/computer-use/src/browser/playwright/download_media.js"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "markdown": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
