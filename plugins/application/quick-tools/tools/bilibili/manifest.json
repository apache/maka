{
  "apiVersion": 1,
  "id": "maka.web.bilibili",
  "name": "哔哩哔哩",
  "version": "0.3.0",
  "icon": "data:image/png;base64,",
  "description": "使用 Chrome 当前账号查看、搜索收藏夹与观看历史；搜索视频和 UP 主，打开常用 B站页面",
  "permissions": ["web.run", "web.connect", "system.open"],
  "web": {
    "runtime": "opencli",
    "commands": [
      {
        "id": "search",
        "site": "bilibili",
        "command": "search",
        "domain": "bilibili.com",
        "access": "read"
      },
      {
        "id": "me",
        "site": "bilibili",
        "command": "me",
        "domain": "bilibili.com",
        "access": "read"
      },
      {
        "id": "folders",
        "site": "bilibili",
        "command": "folders",
        "domain": "bilibili.com",
        "access": "read",
        "request": {
          "origin": "https://api.bilibili.com",
          "path": "/x/v3/fav/folder/created/list-all",
          "params": ["up_mid"]
        }
      },
      {
        "id": "favorite-items",
        "site": "bilibili",
        "command": "favorite-items",
        "domain": "bilibili.com",
        "access": "read",
        "request": {
          "origin": "https://api.bilibili.com",
          "path": "/x/v3/fav/resource/list",
          "params": ["media_id", "pn", "ps", "keyword", "type"]
        }
      },
      {
        "id": "history-items",
        "site": "bilibili",
        "command": "history-items",
        "domain": "bilibili.com",
        "access": "read",
        "request": {
          "origin": "https://api.bilibili.com",
          "path": "/x/web-interface/history/cursor",
          "params": ["ps", "view_at", "type"]
        }
      },
      {
        "id": "history-search",
        "site": "bilibili",
        "command": "history-search",
        "domain": "bilibili.com",
        "access": "read",
        "request": {
          "origin": "https://api.bilibili.com",
          "path": "/x/web-interface/history/search",
          "params": ["keyword", "pn", "business"]
        }
      }
    ]
  },
  "commands": [
    {
      "id": "open",
      "name": "哔哩哔哩",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 open",
      "actions": [
        {
          "id": "open",
          "title": "打开"
        }
      ]
    },
    {
      "id": "home",
      "name": "打开 B站首页",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 home",
      "actions": [
        {
          "id": "home",
          "title": "打开"
        }
      ]
    },
    {
      "id": "dynamic",
      "name": "打开 B站动态",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 dynamic",
      "actions": [
        {
          "id": "dynamic",
          "title": "打开"
        }
      ]
    },
    {
      "id": "space",
      "name": "打开我的 B站空间",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 个人空间 uid",
      "actions": [
        {
          "id": "space",
          "title": "打开"
        }
      ]
    },
    {
      "id": "watchlater",
      "name": "打开 B站稍后再看",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 watchlater",
      "actions": [
        {
          "id": "watchlater",
          "title": "打开"
        }
      ]
    },
    {
      "id": "videos",
      "name": "搜索 B站视频",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 videos",
      "actions": [
        {
          "id": "open-video",
          "title": "打开"
        }
      ]
    },
    {
      "id": "users",
      "name": "搜索 B站 UP 主",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 UP up主 users",
      "actions": [
        {
          "id": "open-user",
          "title": "打开"
        }
      ]
    },
    {
      "id": "favorites",
      "name": "B站收藏夹",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 favorites",
      "actions": [
        {
          "id": "library-favorites",
          "title": "打开"
        }
      ]
    },
    {
      "id": "history",
      "name": "B站观看历史",
      "kind": "哔哩哔哩",
      "keywords": "bilibili bili b站 history",
      "actions": [
        {
          "id": "library-history",
          "title": "打开"
        }
      ]
    }
  ],
  "locales": {
    "en": {
      "name": "Bilibili",
      "description": "Open Home, Feed, My Space and Watch Later; search videos and creators in the quick panel",
      "commands": {
