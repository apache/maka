{
  "manifest_version": 3,
  "name": "Maka Tabs",
  "version": "0.1.0",
  "description": "Search and manage Chrome tabs from Maka Quick Tools. Local connection only.",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reconnect to Maka"
  },
  "incognito": "not_allowed",
  "key": ""
}
