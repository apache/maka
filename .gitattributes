# Preserve deterministic source and license bytes on every platform.
* text=auto eol=lf

# Unified diffs require a leading space for context, including empty and tab-indented lines.
/patches/*.patch whitespace=-space-before-tab,-blank-at-eol
/patches/*.diff whitespace=-space-before-tab,-blank-at-eol
# Empty trailing columns belong to the generated cargo-deny TSV schema.
/products/maka/cli/DEPENDENCIES.rust.tsv whitespace=-blank-at-eol
# Preserve whitespace in redistributed upstream license texts.
/products/maka/cli/THIRD_PARTY_NOTICES.txt whitespace=-blank-at-eol
/scripts/rust/licenses/*.txt whitespace=-blank-at-eol
/third-party/gpui-fast/assets/fonts/ibm-plex-sans/license.txt whitespace=-blank-at-eol
/third-party/gpui-fast/assets/fonts/lilex/OFL.txt whitespace=-blank-at-eol

# Repository-local agent configuration, visual review evidence, and incubation
# working notes are not source-release inputs.
/.claude export-ignore
/.maka-shots export-ignore

# Preserve verbatim whitespace in the pinned NSH source snapshot.
/third-party/nsh/.gitattributes whitespace=-blank-at-eof
/third-party/nsh/examples/gallery/TitleBar.tsx whitespace=-blank-at-eof
/third-party/nsh/examples/gallery/demos/chat/markdown.tsx whitespace=-blank-at-eof
/third-party/nsh/third-party/icy_sixel/Cargo.toml whitespace=-blank-at-eof
/third-party/nsh/website/demos/hero-chat/chat/markdown.tsx whitespace=-blank-at-eof
/third-party/nsh/website/demos/hero-chat/ui.tsx whitespace=-blank-at-eof
/third-party/nsh/examples/gallery-rs/native/assets/fonts/OFL.txt whitespace=-blank-at-eol
/third-party/nsh/examples/gallery/fonts/OFL.txt whitespace=-blank-at-eol
/third-party/nsh/tests/compat/cases/layout/fonts/OFL.txt whitespace=-blank-at-eol
/third-party/nsh/third-party/icy_sixel/src/decoder.rs whitespace=-blank-at-eol

# The pinned upstream license checksum includes its published CRLF bytes.
/third-party/playwright/LICENSE -text whitespace=cr-at-eol
