{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maka.dev/schemas/skin-manifest-v2.json",
  "title": "Maka Skin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "minimumApiVersion", "permissions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "minimumApiVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "author": {
      "type": "string",
      "maxLength": 128
    },
    "styles": {
      "type": "string",
      "pattern": "^[^\\\\]*\\.css$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[^\\\\]*\\.m?js$"
    },
    "preview": {
      "type": "string",
      "pattern": "^[^\\\\]*\\.(png|jpe?g|webp|gif|svg)$"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "dom",
          "canvas",
          "audio",
          "storage",
          "data.sessions",
          "data.conversation",
          "data.tools",
          "data.interactions",
          "data.composer",
          "actions.navigation",
          "actions.task",
          "actions.submit",
          "actions.stop",
          "actions.composer",
          "actions.answer"
        ]
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "appearance.v1",
          "parts.v1",
          "slots.v1",
          "events.semantic.v1",
          "actions.navigation.v1",
          "actions.task.v1",
          "actions.submit.v1",
          "actions.stop.v1",
          "sessions.v1",
          "conversation.v1",
          "tools.detail.v1",
          "interactions.question.v1",
          "composer.control.v1",
          "navigation.lifecycle.v1",
          "slots.items.v1"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["entry"] },
      "then": {
        "properties": {
          "permissions": { "contains": { "const": "dom" } }
        }
      }
    }
  ],
  "anyOf": [{ "required": ["styles"] }, { "required": ["entry"] }]
}
