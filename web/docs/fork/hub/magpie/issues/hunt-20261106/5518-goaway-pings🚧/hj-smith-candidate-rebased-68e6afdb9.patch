+package netproxy
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"testing"
+	"time"
+)
+
+// Observe the transport selected by the real dispatcher, without leaving
+// the machine. Google's quiet model streams must not inherit the 10s
+// health PING, while other hosts and the base transport still have it.
+func TestCodeAssistDoesNotSendHealthPings(t *testing.T) {
+	for _, host := range []string{"cloudcode-pa.googleapis.com", "daily-cloudcode-pa.googleapis.com", "DAILY-CLOUDCODE-PA.GOOGLEAPIS.COM."} {
+		for _, proxy := range []string{"", "direct"} {
+			t.Run(host+"/"+proxy, func(t *testing.T) {
+				stop := errors.New("test: no network")
+				base := &http.Transport{
+					HTTP2:       &http.HTTP2Config{SendPingTimeout: time.Second, PingTimeout: 2 * time.Second, WriteByteTimeout: 3 * time.Second},
+					DialContext: func(context.Context, string, string) (net.Conn, error) { return nil, stop },
+				}
+				d := Dispatch(base).(*dispatch)
+				req, err := http.NewRequestWithContext(With(context.Background(), proxy), "POST", "https://"+host+"/v1internal:streamGenerateContent?alt=sse", nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err := d.RoundTrip(req); !errors.Is(err, stop) {
+					t.Fatalf("request: %v", err)
+				}
+				defer d.CloseIdleConnections()
+				if len(d.own) != 1 {
+					t.Fatalf("Code Assist used %d isolated transports; want 1", len(d.own))
+				}
+				for _, got := range d.own {
+					if got.HTTP2 == nil || got.HTTP2.SendPingTimeout != 0 {
+						t.Fatalf("Google stream still gets health pings: %+v", got.HTTP2)
+					}
+					if got.HTTP2.PingTimeout != 2*time.Second || got.HTTP2.WriteByteTimeout != 3*time.Second {
+						t.Fatalf("other HTTP/2 limits changed: %+v", got.HTTP2)
+					}
+				}
+				if base.HTTP2.SendPingTimeout != time.Second {
+					t.Fatal("Google's policy changed the shared base transport")
+				}
+			})
+		}
+	}
+}
+
+func TestCodeAssistPingPolicyLeavesOtherHostsAlone(t *testing.T) {
+	for _, host := range []string{"example.com", "generativelanguage.googleapis.com", "cloudcode-pa.googleapis.com.example.com", "not-cloudcode-pa.googleapis.com"} {
+		t.Run(host, func(t *testing.T) {
+			if codeAssistHost(host) {
+				t.Fatal("unrelated host matched Code Assist")
+			}
+		})
+	}
+}
