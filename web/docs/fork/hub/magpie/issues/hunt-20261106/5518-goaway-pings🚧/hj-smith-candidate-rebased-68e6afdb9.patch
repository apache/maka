+// codeAssistHost names Google's production and daily Code Assist edges,
+// used by Gemini CLI and Antigravity. Other Google APIs keep their health
+// checks, as do hosts whose names merely contain one of these names.
+func codeAssistHost(host string) bool {
+	switch strings.TrimSuffix(strings.ToLower(host), ".") {
+	case "cloudcode-pa.googleapis.com", "daily-cloudcode-pa.googleapis.com":
+		return true
+	}
+	return false
+}
