+// fieldIn reads a body's format field out, by its path as it went as sent.
+func fieldIn(sent map[string]any, field string) any {
+	got := any(sent)
+	for _, k := range strings.Split(field, ".") {
+		m, _ := got.(map[string]any)
+		got = m[k]
+	}
+	return got
+}
