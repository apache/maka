+func (v *ignoredVendor) sent() (string, map[string]any) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if len(v.bodies) == 0 {
+		return "", nil
+	}
+	return v.paths[len(v.paths)-1], v.bodies[len(v.bodies)-1]
+}
