From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aryz <aryz0713@gmail.com>
Date: Thu, 12 Nov 2026 20:37:21 +0800
Subject: [PATCH 08/11] library: reproduce website grouping losing origins and
 ports

Require distinct HTTP and non-default-port sources to keep their full address as grouping identity, and assert the actual group Open requests in a browser. This exercises both the backend identity and frontend link construction before their fix.

The preceding catalog-only candidate regression now passes in Actions 43213792487 attempt 4.
---
 docs/subsystems/library.md                    |  6 ++-
 .../gui/tests/library-well-known.test.cjs     | 37 +++++++++++++++++--
 .../library/skillwellknown_catalog_test.go    | 16 ++++++++
 3 files changed, 54 insertions(+), 5 deletions(-)

diff --git a/docs/subsystems/library.md b/docs/subsystems/library.md
index 7631f61af..424528410 100644
--- a/docs/subsystems/library.md
+++ b/docs/subsystems/library.md
@@ -59,8 +59,10 @@ well-known file-list index: `skills` entries with `name`, `description` and
 The website address is kept as the source; discovery never visits its home
 page to replace it with a redirect's destination. A scoped address stays in
 that scope. Every listed supporting file is installed with `SKILL.md`, after
-the manifest's paths and limits have been checked. No downloaded content is
-executed, and no GitHub token or agent credential is sent to the website.
+the manifest's paths and limits have been checked. Only the declared catalog
+entries are offered as skills; supporting `SKILL.md` templates stay files of
+their entry. No downloaded content is executed, and no GitHub token or agent
+credential is sent to the website.
 
 These skills are grouped by their website, with a source link and the same
 update controls as repository skills. Checks compare the fetched content
diff --git a/internal/gui/tests/library-well-known.test.cjs b/internal/gui/tests/library-well-known.test.cjs
index 15b7d2b0e..89d218c3b 100644
--- a/internal/gui/tests/library-well-known.test.cjs
+++ b/internal/gui/tests/library-well-known.test.cjs
@@ -16,17 +16,21 @@ const library = () => ({
   skills: [{ name: "ui-taste", description: "UI taste", kind: "well-known", source, repo: "uizze.sh", agents: [] }],
 });
 
-function serve(lang, posts) {
+function serve(lang, posts, data = library(), opened = []) {
   return async (route) => {
     const req = route.request(), url = new URL(req.url());
     if (url.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: `window.bootPrefs = {lang:"${lang}",theme:"light",web:true};` });
     if (url.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
     if (url.pathname === "/api/state") return route.fulfill({ json: { agents: [], profiles: [], settings: { lang } } });
     if (url.pathname === "/api/plugins") return route.fulfill({ json: { plugins: [] } });
-    if (url.pathname === "/api/library") return route.fulfill({ json: library() });
+    if (url.pathname === "/api/library") return route.fulfill({ json: data });
+    if (url.pathname === "/api/open") {
+      opened.push(req.postDataJSON().url);
+      return route.fulfill({ json: {} });
+    }
     if (url.pathname === "/api/library/skills/update") {
       posts.push(req.postDataJSON());
-      return route.fulfill({ json: { ...library(), result: { updated: ["ui-taste"], changed: [], problems: [] } } });
+      return route.fulfill({ json: { ...data, result: { updated: ["ui-taste"], changed: [], problems: [] } } });
     }
     if (url.pathname === "/api/usage/quotas") return route.fulfill({ json: [] });
     if (url.pathname === "/api/groups") return route.fulfill({ json: { groups: [] } });
@@ -73,4 +77,31 @@ for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium",
       }
     }
   });
+
+  test(`${engine}: website groups preserve HTTP origins and ports`, async (t) => {
+    const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: "chromium" }));
+    t.after(() => browser.close());
+    const context = await browser.newContext({ viewport: { width: 980, height: 800 } });
+    t.after(() => context.close());
+    await context.addInitScript(() => { try { localStorage.setItem("magpie.libTab", "skills"); } catch {} });
+    const origins = ["http://localhost:8080/kit", "http://example.com:8080/kit", "http://example.com:8081/kit", "https://example.com:8443/Kit"];
+    const data = library(), opened = [];
+    data.skills = origins.map((address, i) => ({ name: `website-${i}`, description: "Website skill", kind: "well-known", source: address, repo: address, agents: [] }));
+    const page = await context.newPage();
+    page.setDefaultTimeout(5000);
+    await page.route("**/*", serve("en", [], data, opened));
+    await page.goto("http://magpie.test/");
+    await page.locator('button[data-view="library"]').click();
+    const groups = page.locator("#view-library .lib-group");
+    await groups.first().waitFor();
+    assert.equal(await groups.count(), origins.length, "different origins must remain different groups");
+    for (const address of origins) {
+      const group = groups.filter({ has: page.getByText(address, { exact: true }) });
+      await Promise.all([
+        page.waitForResponse((response) => new URL(response.url()).pathname === "/api/open"),
+        group.locator(".lib-grouphead .lib-rowacts > button.lib-icon").click(),
+      ]);
+    }
+    assert.deepEqual(opened, origins, "opening a website group must preserve its scheme, host, port and path");
+  });
 }
diff --git a/internal/library/skillwellknown_catalog_test.go b/internal/library/skillwellknown_catalog_test.go
index 60ba0ec43..9b5b5ef6d 100644
--- a/internal/library/skillwellknown_catalog_test.go
+++ b/internal/library/skillwellknown_catalog_test.go
@@ -18,3 +18,19 @@ func TestWellKnownCatalogListsOnlyItsEntries(t *testing.T) {
 		t.Fatalf("only entries declared by the website are installable; supporting examples are files: %+v", p.Candidates)
 	}
 }
+
+func TestWellKnownGroupingKeepsWebsiteOrigin(t *testing.T) {
+	for _, address := range []string{
+		"http://localhost:8080/kit",
+		"http://example.com:8080/kit",
+		"http://example.com:8081/kit",
+		"https://example.com:8443/Kit",
+	} {
+		t.Run(address, func(t *testing.T) {
+			s := &Skill{Source: &Source{Kind: "well-known", Repo: address}}
+			if got := (&tracer{}).repoOf(s); got != address {
+				t.Fatalf("website grouping must keep the origin and path: got %q, want %q", got, address)
+			}
+		})
+	}
+}
