From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aryz <aryz0713@gmail.com>
Date: Thu, 12 Nov 2026 21:07:19 +0800
Subject: [PATCH 10/11] library: retain website origins and parse only skill
 metadata

Preserve scheme, port and path case in website group identities and Open requests without GitHub owner folding. Listed support files are opaque bytes: validate index JSON and root SKILL.md front matter with their parsers instead of rejecting Markdown documents that start with HTML comments.

RED evidence: Actions 43213792487 attempts 5 and 6 show the grouping and Markdown cases fail before these fixes; the real browser test merges five complete website addresses into two groups. Re-run the platform checks, race tests and full Library suite for this tree; reproduce the unrelated root guard failure on the original baseline separately.
---
 docs/subsystems/library.md                     | 5 +++--
 internal/gui/assets/plugins/library/client.js  | 6 +++---
 internal/gui/tests/library-well-known.test.cjs | 4 ++--
 internal/library/skill_from.go                 | 4 ++--
 internal/library/skillwellknown.go             | 8 +-------
 5 files changed, 11 insertions(+), 16 deletions(-)

diff --git a/docs/subsystems/library.md b/docs/subsystems/library.md
index 424528410..ea04a68e8 100644
--- a/docs/subsystems/library.md
+++ b/docs/subsystems/library.md
@@ -64,8 +64,9 @@ entries are offered as skills; supporting `SKILL.md` templates stay files of
 their entry. No downloaded content is executed, and no GitHub token or agent
 credential is sent to the website.
 
-These skills are grouped by their website, with a source link and the same
-update controls as repository skills. Checks compare the fetched content
+These skills are grouped by their complete website address, retaining the
+scheme, port and path case, with a source link and the same update controls
+as repository skills. Checks compare the fetched content
 with the installed hash. Updates retain the existing protection for local
 edits and the existing backup and replacement path. An unreadable or invalid
 index, an incomplete download or an invalid skill is an error, not evidence
diff --git a/internal/gui/assets/plugins/library/client.js b/internal/gui/assets/plugins/library/client.js
index e0e9394bb..b570101b1 100644
--- a/internal/gui/assets/plugins/library/client.js
+++ b/internal/gui/assets/plugins/library/client.js
@@ -5615,7 +5615,7 @@ magpie.plugin("library", (ctx) => {
   // Immortal on Discord). owner/repo on GitHub, host/path elsewhere.
   const skillRepo = (s) => s.repo || (s.kind === "github" ? repoOf(s.source) : s.origin ? repoOf(s.origin) : "");
   // a host's (with a path, or a site's kit of skills alone, #1862) or GitHub's
-  const repoURL = (r) => (/^[^/]+\.[^/]+(\/|$)/.test(r) ? "https://" + r : "https://github.com/" + r);
+  const repoURL = (r) => (/^https?:\/\//i.test(r) ? r : /^[^/]+\.[^/]+(\/|$)/.test(r) ? "https://" + r : "https://github.com/" + r);
   const MANY = 40;   // a group bigger than this starts folded, and so do its parts
   const SPLIT = 8;   // a group bigger than this is split by folder, or by name
   // Heights the rows are held to (library.css): a list's room is known
@@ -5653,7 +5653,7 @@ magpie.plugin("library", (ctx) => {
       const own = inMine.get(s.name);
       if (own) { own.skills.push(s); continue; }
       const repo = skillRepo(s);
-      const key = repo ? "gh:" + repo.toLowerCase() : "local";
+      const key = repo ? "gh:" + (s.kind === "well-known" ? repo : repo.toLowerCase()) : "local";
       let g = by.get(key);
       if (!g) by.set(key, (g = { key, repo, skills: [] }));
       g.skills.push(s);
@@ -5670,7 +5670,7 @@ magpie.plugin("library", (ctx) => {
     const up = repos.filter((g) => g.skills.some(online)), down = repos.filter((g) => !g.skills.some(online));
     const owners = new Map();
     for (const g of up) {
-      if (/^[^/]+\.[^/]+(\/|$)/.test(g.repo)) continue; // another git host or a website
+      if (/^https?:\/\//i.test(g.repo) || /^[^/]+\.[^/]+(\/|$)/.test(g.repo)) continue; // another git host or a website
       const o = g.repo.split("/")[0].toLowerCase();
       if (!owners.has(o)) owners.set(o, []);
       owners.get(o).push(g);
