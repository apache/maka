 // (%LOCALAPPDATA%\hermes on Windows, ~/.hermes elsewhere), which a
 // HERMES_HOME under it is a profile of; a HERMES_HOME elsewhere is the root itself, or, as
 // <root>/profiles/<name>, a profile of <root> (get_default_hermes_root).
-// A profile with no config.yaml yet is left out: magpie doesn't make one.
 func hermesProfiles(at place) []string {
 	root := at.hermesDefault()
 	if env := at.getenv("HERMES_HOME"); env != "" {
 		if rel, err := filepath.Rel(root, env); err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
-			root = env
-			if filepath.Base(filepath.Dir(env)) == "profiles" {
-				root = filepath.Dir(filepath.Dir(env))
-			}
+			root = hermesRoot(env)
 		}
 	}
+	return hermesProfileConfigs(root)
+}
+
+// HermesProfiles is the config.yaml of each of the profiles (its bots) of
+// the Hermes whose folder is dir, as Hermes lists them (hermesProfileConfigs):
+// the resource library gives each of them the library's MCP servers, which
+// a profile reads from its own config.yaml alone (#2540). A profile with no
+// config.yaml yet is left out: magpie doesn't make one.
+func HermesProfiles(dir string) []string { return hermesProfileConfigs(hermesRoot(dir)) }
+
+// hermesRoot is the root of Hermes's profiles: dir itself, or, as
+// <root>/profiles/<name>, the root it is a profile of.
+func hermesRoot(dir string) string {
+	if filepath.Base(filepath.Dir(dir)) == "profiles" {
+		return filepath.Dir(filepath.Dir(dir))
+	}
+	return dir
+}
+
+// hermesProfileConfigs is every profile's config.yaml under root: the
+// root's own, and <root>/profiles/<name>'s for each name Hermes allows that
+// holds a file only a profile has and isn't deleted (a tombstone at
+// profiles/.deleted/<name>). A profile with no config.yaml yet is left
+// out: magpie doesn't make one.
+func hermesProfileConfigs(root string) []string {
 	paths := []string{filepath.Join(root, "config.yaml")}
 	ps := filepath.Join(root, "profiles")
 	es, _ := os.ReadDir(ps)
diff --git a/internal/library/hermes_mcp_test.go b/internal/library/hermes_mcp_test.go
index 34dc82e2..2fd44cad 100644
--- a/internal/library/hermes_mcp_test.go
+++ b/internal/library/hermes_mcp_test.go
@@ -129,6 +129,59 @@ func TestHermesMCP(t *testing.T) {
 	}
 }
 
+// sryimnoob123 (#2540): every bot is a profile with its own config.yaml,
+// which reads no other home's (hermes.go hermesProfiles), so the library's
+// servers go into each profile's config as well — a profile's own settings
+// stay as its user set them, and only magpie's come out again.
+func TestHermesProfilesGetMCP(t *testing.T) {
+	h := sandbox(t)
+	dir := filepath.Join(h, "hermes-home")
+	t.Setenv("HERMES_HOME", dir)
+	p := filepath.Join(dir, "config.yaml")
+	write(t, p, hermesConfig)
+	holdCLI(t, h, "hermes") // the config alone is gone (#2173, #2177)
+
+	// one bot profile beside the default home, and another
+	alpha := filepath.Join(dir, "profiles", "alpha", "config.yaml")
+	beta := filepath.Join(dir, "profiles", "beta", "config.yaml")
+	write(t, alpha, "# alpha's own\nmodel:\n  default: mine/other\n")
+	write(t, beta, "# beta's own\nmodel:\n  default: mine/else\n")
+
+	agents := []string{"hermes"}
+	ok(t)(SaveServer("", Server{Name: "web", Transport: "http", URL: "https://example.com/mcp", Agents: agents}))
+
+	for _, c := range []struct{ name, model string }{{"alpha", "mine/other"}, {"beta", "mine/else"}} {
+		got := read(t, filepath.Join(dir, "profiles", c.name, "config.yaml"))
+		if !strings.Contains(got, "web") || !strings.Contains(got, "https://example.com/mcp") {
+			t.Errorf("%s's config.yaml got nothing:\n%s", c.name, got)
+		}
+		if !strings.Contains(got, c.model) {
+			t.Errorf("%s lost its own model:\n%s", c.name, got)
+		}
+	}
+	if got := read(t, p); !strings.Contains(got, "web") {
+		t.Errorf("the main home's config.yaml lost it:\n%s", got)
+	}
+
+	// a profile that is as the library has it isn't written again
+	before := read(t, alpha)
+	ok(t)(Sync())
+	if read(t, alpha) != before {
+		t.Errorf("a sync rewrote a profile that is as the library has it:\n%s", read(t, alpha))
+	}
+
+	ok(t)(RemoveServer("web"))
+	for _, c := range []struct{ name, model string }{{"alpha", "mine/other"}, {"beta", "mine/else"}} {
+		got := read(t, filepath.Join(dir, "profiles", c.name, "config.yaml"))
+		if strings.Contains(got, "web") {
+			t.Errorf("%s's config.yaml still has it:\n%s", c.name, got)
+		}
+		if !strings.Contains(got, c.model) {
+			t.Errorf("%s lost its own model:\n%s", c.name, got)
+		}
+	}
+}
