diff --git a/internal/gateway/fallback.go b/internal/gateway/fallback.go
index cc1c24495..c73f3d001 100644
--- a/internal/gateway/fallback.go
+++ b/internal/gateway/fallback.go
@@ -2310,6 +2310,10 @@ type holdWriter struct {
 	// through as it comes. A refusal isn't a failure of the account, so
 	// nobody rests for it, whatever its timing (#248)
 	refusedAfter bool
+	// calls: a tool call of some kind has gone by in the reply, so a
+	// refusal after it is not handed over (handsOff): the call the agent
+	// has would sit beside the next member's, broken or doubled
+	calls bool
 	// after is what came of the reply once it began, for a refusal in it
 	// to be read event by event
 	after []byte
@@ -3063,30 +3067,55 @@ func (h *holdWriter) sent(b []byte) {
 // the scan that reads a stream held for its first content never sees an
 // event that comes after it, and the filter refusing a turn it had begun
 // is no failure of the account, as one it refuses before any of it is said
-// is not (#248). What is read is kept only as far as the event it is in is
-// whole, as a write may end in the middle of one.
+// is not (#248). A refusal that is the vendor's own finish code — Chat
+// Completions' content_filter, Anthropic's stop_reason refusal — on a
+// client reading Chat chunks hands the try over (#5075, handOffAfter):
+// the line the vendor put out first stays, as the reasoning of a
+// handed-over try does. What is read is kept only as far as the event it
+// is in is whole, as a write may end in the middle of one.
 func (h *holdWriter) refusalAfter(b []byte) {
 	// Every write is read, not only one that looks like a refusal: an
 	// event's name may come in one write and its data in the next (#2400).
 	// Only an unfinished event's bytes are kept.
+	if !h.calls {
+		h.calls = mayCall(b)
+	}
 	buf := b
 	if len(h.after) > 0 {
 		h.after = append(h.after, b...)
 		buf = h.after
 	}
+	at := len(buf) - len(b) // where this write's bytes begin in buf
+	gone := 0               // how much of buf whole events have taken
 	for {
-		end := eventEnd(buf)
+		end := eventEnd(buf[gone:])
 		if end < 0 {
 			break
 		}
-		ev := buf[:end]
-		buf = buf[end:]
+		ev := buf[gone : gone+end]
+		gone += end
 		if mayRefuse(ev) {
-			if kind, _, _ := streamEvent(ev); kind == eventRefusal || kind == eventRefusalError {
+			if kind, status, msg := streamEvent(ev); kind == eventRefusal || kind == eventRefusalError {
 				h.refusedAfter = true
+				// an error event mid-reply is a stream's accident, kept as
+				// it came (#733); the finish code is the vendor's word that
+				// the turn it had begun was never answered (#5075)
+				if kind == eventRefusal && h.handsOff() {
+					// what of this write went by before the code — the
+					// reply's last words — goes out with the rest; the
+					// code, and what came with it, does not
+					if start := gone - len(ev); start > at {
+						pre := buf[at:start]
+						h.sent(pre)
+						h.w.Write(pre)
+					}
+					h.handOffAfter(status, msg)
+					return
+				}
 			}
 		}
 	}
+	buf = buf[gone:]
 	if len(buf) == 0 || len(buf) > holdMost {
 		h.after = nil
 		return
@@ -3094,6 +3123,17 @@ func (h *holdWriter) refusalAfter(b []byte) {
 	h.after = append([]byte(nil), buf...)
 }
 
+// mayCall says whether a write of the reply carries a tool call of some
+// kind: Chat's delta.tool_calls or its legacy function_call, Anthropic's
+// tool_use, Responses' function_call. A word of it in plain text counts
+// too — the cost of missing one, a call the agent would run beside the
+// next member's, is the greater.
+func mayCall(b []byte) bool {
+	return bytes.Contains(b, []byte(`"tool_calls"`)) ||
+		bytes.Contains(b, []byte(`"tool_use"`)) ||
+		bytes.Contains(b, []byte(`"function_call"`))
+}
+
 // mayRefuse is whether an event may be the safety filter's refusal, by the
 // words its shapes carry, before it is read as JSON at all: every event of
 // a reply that has begun goes through this.
diff --git a/internal/gateway/refusal_handover.go b/internal/gateway/refusal_handover.go
index 238267db4..14e7f5e52 100644
--- a/internal/gateway/refusal_handover.go
+++ b/internal/gateway/refusal_handover.go
@@ -119,7 +119,9 @@ func (h *holdWriter) passOver(b []byte) {
 		rest := o.pending
 		o.pending = nil
 		h.refusalAfter(rest)
-		h.out(rest)
+		if !h.handedOver { // the refusal in it handed the try over (handOffAfter)
+			h.out(rest)
+		}
 	}
 	h.flush()
 }
@@ -133,6 +135,43 @@ func (h *holdWriter) out(b []byte) {
 	h.w.Write(b)
 }
 
+// handsOff says whether a refusal that is the vendor's own finish code,
+// once its answer has gone out (refusalAfter), may hand the try over: the
+// reply is passing — what is still held goes through the scan, whose own
+// refusal paths (flow, handOver) ask the next candidate without it — a
+// candidate stands behind it reading Chat chunks, whose pieces carry no
+// index for the next stream's to collide with, and no call of the reply
+// has gone by, for the agent to be left holding beside the next member's.
+// An Anthropic or Responses client's stream is numbered, and what of it
+// has gone by untracked would number the next one's blocks wrong; its
+// refusal goes as it came, as before.
+func (h *holdWriter) handsOff() bool {
+	return h.passing && h.over != nil && h.over.proto == provider.Chat && !h.calls
+}
+
+// handOffAfter ends a passing try at the vendor's finish code saying the
+// turn it had begun was filtered (#5075): whatever it said first — the
+// canned line a word-list filter answers with — the code says the turn
+// was never answered, and a client that reads finish reasons fails the
+// whole turn on it, so the members left are asked in the same stream, as
+// a refusal after reasoning is (handOver). What went out first stays, as
+// that reasoning does; the refusal's own end (the finish chunk, usage,
+// [DONE]) isn't sent, and the next one's chunks follow without a second
+// 200. Its account doesn't rest: the request was refused, not the
+// account (#248).
+func (h *holdWriter) handOffAfter(status int, msg string) {
+	h.flush()
+	h.handedOver, h.passing = true, false
+	h.refused, h.failure, h.failMsg = true, status, msg
+	h.ended, h.tail = false, nil
+	if h.alive != nil {
+		h.alive.sent = true
+	}
+	if h.stop != nil {
+		h.stop()
+	}
+}
+
 // handOver ends a passing try at its refusal (passOver): the agent has
 // what went before it, an Anthropic block still open is stopped, and the
 // try fails as a refusal with nothing said does, for the next candidate's
