diff --git a/internal/gui/providers_desktop_test.go b/internal/gui/providers_desktop_test.go
new file mode 100644
index 00000000..f78debfb
--- /dev/null
+++ b/internal/gui/providers_desktop_test.go
@@ -0,0 +1,75 @@
+package gui
+
+import (
+	"encoding/json"
+	"os"
+	"regexp"
+	"testing"
+
+	"github.com/yetone/magpie/internal/gateway"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// The number Claude Desktop brackets a model's menu row with (#2578) is
+// said on the Providers page too, on the model's own row, so a menu row
+// there can be matched back to its provider: the number the page says is
+// the one in the id Claude Desktop is shown (gateway.DesktopID).
+func TestProviderModelsSayDesktopNumber(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("USERPROFILE", os.Getenv("HOME"))
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	p := provider.Provider{ID: "relay", Name: "Relay", Key: "k", Chat: "http://127.0.0.1:1/v1", Models: []string{"claude-opus-5-5", "m2", "sonnet-5-1m"}}
+	if err := provider.Save(p); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.SetModelEfforts("relay/claude-opus-5-5", []string{"low", "high"}); err != nil {
+		t.Fatal(err)
+	}
+	var num = regexp.MustCompile(`magpie-(\d+)`)
+	// the number in the id Claude Desktop is shown, "" when the id there
+	// is the model's own
+	want := func(id string) string {
+		desktop := ""
+		for _, e := range provider.Catalog() {
+			if e.ID == id {
+				if m := num.FindStringSubmatch(gateway.DesktopID(e)); m != nil {
+					desktop = m[1]
+				}
+			}
+		}
+		return desktop
+	}
+	raw, err := json.Marshal(providerInfo(p, nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var page struct {
+		Models []map[string]any `json:"models"`
+	}
+	if err := json.Unmarshal(raw, &page); err != nil {
+		t.Fatal(err)
+	}
+	said := map[string]any{}
+	for _, m := range page.Models {
+		said[m["id"].(string)] = m["desktop"]
+	}
+	for _, c := range []struct{ id, form string }{
+		// an effort Claude model: magpie-<n>.anthropic.claude-opus-5-5,
+		// the shape the issue's menu row folds into a catalog name
+		{"relay/claude-opus-5-5", "magpie-<n>.anthropic.<model>"},
+		// no efforts and no Claude word in it: anthropic/magpie-<n>
+		{"relay/m2", "anthropic/magpie-<n>"},
+		// a Claude word but no level and no Claude model's shape: its own
+		// id, which carries no number
+		{"relay/sonnet-5-1m", "own"},
+	} {
+		w := want(c.id)
+		if c.form == "own" && w != "" {
+			t.Fatalf("%s: Desktop is shown %q, want its own id", c.id, w)
+		}
+		if got := said[c.id[len("relay/"):]]; got != w && !(w == "" && got == nil) {
+			t.Errorf("%s: the page says desktop %v, want %q (%s)", c.id, got, w, c.form)
+		}
+	}
+}
diff --git a/internal/gui/tests/model-desktop-number.test.cjs b/internal/gui/tests/model-desktop-number.test.cjs
new file mode 100644
index 00000000..0336725b
--- /dev/null
+++ b/internal/gui/tests/model-desktop-number.test.cjs
@@ -0,0 +1,89 @@
+// Run with Node's test runner and Playwright on the module path; see README.md.
+// Claude Desktop folds the rows of one catalog name into one and brackets
+// them with the ten digits of the model's id (#2578), so two providers'
+// Claude model read alike there. The Providers page says the number on the
+// model's own chip, so a row of that menu can be matched back to its
+// provider. A model Desktop shows by its own id carries no number, and no
+// badge. In English and Chinese, Chromium and WebKit.
+const assert = require("node:assert/strict");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { test } = require("node:test");
+const { chromium, webkit } = require("playwright");
+
+const assets = path.resolve(__dirname, "../assets");
+const fetched = new Date(Date.now() - 3600e3).toISOString();
+const relay = (models) => ({
+  id: "relay", name: "Relay", icon: "generic", host: "relay.example.com", chat: "https://relay.example.com/v1", responses: "", anthropic: "", catalog: "",
+  models, chosen: [], fetched, agents: [], fallback: [], headers: {},
+  key: { set: true, masked: "sk-…one" }, keyList: [], balanceToken: { takes: false, set: false }, proxy: "",
+});
+// the number is the one the gateway puts in the id Claude Desktop is shown:
+// two providers' same Claude model, one carrying it, one its own id
+const models = [
+  { id: "claude-opus-5-5", name: "Opus 5.5", on: true, desktop: "3233491987" },
+  { id: "claude-sonnet-5", name: "Sonnet 5", on: true },
+];
+
+function serve(lang) {
+  const providers = { providers: [relay(models)], presets: [], excluded: [], gateway: { running: true, window: true } };
+  const state = { agents: [], profiles: [], settings: { lang, theme: "light" } };
+  return async (route) => {
+    const req = route.request(), url = new URL(req.url());
+    const json = (data) => route.fulfill({ json: data });
+    if (url.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: `window.bootPrefs = {lang:"${lang}",theme:"light",web:true};` });
+    if (url.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
+    if (url.pathname === "/api/state") return json(state);
+    if (url.pathname === "/api/plugins") return json({ plugins: [] });
+    if (url.pathname === "/api/providers") return json(providers);
+    if (url.pathname === "/api/groups") return json({ groups: [] });
+    if (url.pathname.startsWith("/api/")) return json({});
+    const file = path.join(assets, url.pathname === "/" ? "index.html" : url.pathname);
+    const contentType = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml", ".png": "image/png" }[path.extname(file)];
+    await route.fulfill({ body: await fs.readFile(file), contentType });
+  };
+}
+
+const words = {
+  en: "The number Claude Desktop's menu shows beside this model",
+  zh: "Claude Desktop 菜单在该模型旁显示的编号",
+};
+
+for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium", "webkit"])) {
+  for (const lang of ["en", "zh"]) {
+    test(`${engine} ${lang}: the Desktop number is said on the model's chip`, async (t) => {
+      const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: "chromium" }));
+      const page = await (await browser.newContext({ viewport: { width: 900, height: 600 }, reducedMotion: "reduce" })).newPage();
+      t.after(async () => {
+        if (process.env.ARTIFACT_DIR) {
+          await fs.mkdir(process.env.ARTIFACT_DIR, { recursive: true });
+          await page.screenshot({ path: path.join(process.env.ARTIFACT_DIR, `${engine}-${lang}-model-desktop-number.png`) });
+        }
+        await browser.close();
+      });
+      page.setDefaultTimeout(5000);
+      const errors = [];
+      page.on("pageerror", (e) => errors.push(e.message));
+      await page.route("**/*", serve(lang));
+      await page.goto("http://magpie.test/?view=providers");
+
+      const editor = page.locator("#modal:not([hidden]) .editor");
+      await page.locator(".row.provider", { hasText: "Relay" }).click();
+      await editor.locator(".ehead b", { hasText: "Relay" }).waitFor();
+      await editor.locator(".mchips .mchip").first().waitFor();
+
+      // the number on its model's chip, said where a hover reads it
+      const chip = editor.locator(".mchips .mchip", { hasText: "Opus 5.5" });
+      const badge = chip.locator(".badge", { hasText: "3233491987" });
+      assert.equal(await badge.count(), 1, "the number is on the chip");
+      assert.equal(await badge.getAttribute("title"), words[lang]);
+
+      // a model Desktop shows by its own id carries no number
+      assert.equal(await editor.locator(".mchips .mchip", { hasText: "Sonnet 5" }).locator(".badge").count(), 0, "no number on its own id");
+
+      const missing = await page.evaluate(() => ["The number Claude Desktop's menu shows beside this model"].filter((k) => !I18N.zh[k]));
+      assert.deepEqual(missing, [], "every string has its Chinese");
+      assert.deepEqual(errors, []);
+    });
+  }
+}
-- 
