+		if !seen[realDir(sharedSkillsDir())] {
+			p := filepath.Join(sharedSkillsDir(), s.Name)
+			if ours(p, s.Name) && !linked(p) {
+				made, ok := copiedAt(p)
+				if ok {
+					at, err := changedAt(p)
+					switch {
+					case err != nil:
+						failed("agents", s.Name, p, err)
+					case !at.After(made):
+						if l.untouched == nil {
+							l.untouched = map[string]bool{}
+						}
+						l.untouched[p] = true
+					case !sameTree(p, lib):
+						edits = append(edits, edit{"agents", p, at})
+					}
+				}
+			}
+		}
 		if len(edits) == 0 {
 			continue
 		}
