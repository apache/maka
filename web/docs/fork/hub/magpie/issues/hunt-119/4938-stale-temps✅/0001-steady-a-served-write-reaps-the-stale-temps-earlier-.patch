 func WriteFile(p string, b []byte, perm fs.FileMode) error {
 	tmp, err := os.CreateTemp(filepath.Dir(p), "."+filepath.Base(p)+".*")
 	if err != nil {
@@ -173,6 +176,50 @@ func WriteFile(p string, b []byte, perm fs.FileMode) error {
