From 6070432f6c55a213b9e25ceb7a65fdd936406249 Mon Sep 17 00:00:00 2001
From: ggbdpq <ggbdpq@gmail.com>
Date: Wed, 14 Oct 2026 23:42:43 +0800
Subject: [PATCH] tui: the library page keeps the row picked in view, however
 many section heads the window holds
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

What changed: viewLibrary sized its window from the row picked down in
rows (`start = lrow - visible + 3`), but the loop it feeds spends the
same budget in lines: every section head it crosses takes a line and
the blank before it, two the row count never paid for. With two or
more heads between the window's start and the row picked (servers,
then skills, then those found in the agents — a handful of each on a
terminal some thirty lines tall), the loop stopped above the row
picked: the highlight vanished, and j and down did nothing the screen
could see until the row count brought it back. The window now starts
where the lines to the row picked still fit, counted the way the loop
spends them.

Run: go test -tags nogui -count=1 ./internal/tui/ (the new
TestLibraryViewKeepsTheRowPicked is red without the change, watched on
a36319d6); gofmt -l internal/tui; go vet ./internal/tui/
---
 internal/tui/library.go           | 22 ++++++++++--
 internal/tui/library_view_test.go | 56 +++++++++++++++++++++++++++++++
 2 files changed, 75 insertions(+), 3 deletions(-)
 create mode 100644 internal/tui/library_view_test.go

diff --git a/internal/tui/library.go b/internal/tui/library.go
index c7b859fc..87db0115 100644
--- a/internal/tui/library.go
+++ b/internal/tui/library.go
@@ -548,9 +548,25 @@ func (m model) viewLibrary() string {
 	}
 	// the rows around the cursor, as many as fit
 	visible := max(4, m.h-6)
-	start := 0
-	if m.lrow >= visible-2 {
-		start = m.lrow - visible + 3
+	// where the window starts is counted in the lines it draws — counted in
+	// rows alone, a list of several sections drew heads the budget never
+	// paid for, and the row picked fell off the bottom of the page
+	spend := func(from int) int {
+		lines := 0
+		for i := from; i <= m.lrow && lines <= visible; i++ {
+			lines++
+			if i == from || m.lib[i].kind != m.lib[i-1].kind {
+				lines += 2 // the head, and the blank before it
+				if i == 0 {
+					lines-- // the list's first section has no blank above it
+				}
+			}
+		}
+		return lines
+	}
+	start := m.lrow
+	for start > 0 && spend(start-1) <= visible {
+		start--
 	}
 	last, lines := "", 0
 	for i := start; i < len(m.lib) && lines < visible; i++ {
diff --git a/internal/tui/library_view_test.go b/internal/tui/library_view_test.go
new file mode 100644
index 00000000..c036097a
--- /dev/null
+++ b/internal/tui/library_view_test.go
@@ -0,0 +1,56 @@
+package tui
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/library"
+)
+
+// The library page keeps the row picked in view: its window is counted in
+// the lines it draws — a row a line, a section's head and the blank before
+// it two more — not in the rows alone, so a list of several sections (the
+// servers, the skills, those found in the agents) can't scroll the row
+// picked off the bottom of a short terminal.
+func TestLibraryViewKeepsTheRowPicked(t *testing.T) {
+	var lib []libRow
+	lib = append(lib, libRow{kind: "instructions", name: "shared instructions"})
+	for i := 0; i < 10; i++ {
+		lib = append(lib, libRow{kind: "mcp", name: fmt.Sprintf("srv-%02d", i)})
+	}
+	for i := 0; i < 20; i++ {
+		lib = append(lib, libRow{kind: "skill", name: fmt.Sprintf("skill-%02d", i)})
+	}
+	for i := 0; i < 3; i++ {
+		lib = append(lib, libRow{kind: "found-mcp", name: fmt.Sprintf("own-mcp-%d", i)})
+	}
+	for i := 0; i < 5; i++ {
+		lib = append(lib, libRow{kind: "found-skill", name: fmt.Sprintf("own-skill-%d", i)})
+	}
+	lib = append(lib, libRow{kind: "rtk", name: "RTK"})
+	// a terminal some thirty lines tall: the skills alone are more than the
+	// page shows at once
+	m := model{w: 120, h: 30, lib: lib, libView: &library.View{Dir: "/x"}}
+	for _, pick := range []string{"skill-10", "own-mcp-0", "own-skill-4", "RTK"} {
+		m.lrow = libIndexOf(lib, pick)
+		v := m.viewLibrary()
+		if !strings.Contains(v, "▸ "+pick) {
+			t.Fatalf("row %d (%s) picked, but the view stops short of it:\n%s", m.lrow, pick, v)
+		}
+	}
+	// the page starts at its top while it all fits
+	m.lrow = 0
+	if v := m.viewLibrary(); !strings.Contains(v, "shared instructions") {
+		t.Fatalf("the top of the list isn't shown:\n%s", v)
+	}
+}
+
+func libIndexOf(lib []libRow, name string) int {
+	for i, r := range lib {
+		if r.name == name {
+			return i
+		}
+	}
+	return -1
+}
