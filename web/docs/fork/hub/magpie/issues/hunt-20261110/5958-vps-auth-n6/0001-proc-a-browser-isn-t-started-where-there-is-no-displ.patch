diff --git a/internal/proc/browser.go b/internal/proc/browser.go
index 10403a292..fc6272303 100644
--- a/internal/proc/browser.go
+++ b/internal/proc/browser.go
@@ -1,21 +1,63 @@
 package proc
 
 import (
+	"errors"
 	"os"
 	"os/exec"
 	"path/filepath"
 	"runtime"
+	"strings"
 )
 
 // OpenBrowser opens url in the user's default browser. The error is the
-// launcher's failing to start, for the caller to show with the link to open
-// by hand: a sign-in that waits on a page that never opened only times out
-// (#2043).
-func OpenBrowser(url string) error {
-	name, args := browserCommand(runtime.GOOS, os.Getenv("SystemRoot"), url)
+// launcher's failing to start, or there being no display to open one on,
+// for the caller to show with the link to open by hand: a sign-in that
+// waits on a page that never opened only times out (#2043), and a browser
+// started on a machine with no screen only comes up and goes away there
+// (#5958).
+func OpenBrowser(url string) error { return openBrowserOn(runtime.GOOS, url) }
+
+// openBrowserOn is OpenBrowser for the system goos names; tests stand in
+// the start and the kernel's name.
+func openBrowserOn(goos, url string) error {
+	if why := noDisplay(goos, os.Getenv("DISPLAY"), os.Getenv("WAYLAND_DISPLAY"), inWSL()); why != "" {
+		return errors.New(why)
+	}
+	name, args := browserCommand(goos, os.Getenv("SystemRoot"), url)
 	return startBrowser(Command(name, args...))
 }
 
+// noDisplay says why a browser can't be shown on the machine magpie runs
+// on, "" when one can: where the launcher is xdg-open (the default here),
+// a server, a container or an SSH session with neither DISPLAY nor
+// WAYLAND_DISPLAY has no browser to start, short of WSL, whose xdg-open
+// (wslview) opens Windows' own browser. darwin's open, Windows' rundll32
+// and termux-open-url all reach a screen of theirs without a display here.
+func noDisplay(goos, display, wayland string, wsl bool) string {
+	switch goos {
+	case "darwin", "windows", "android":
+		return ""
+	}
+	if display != "" || wayland != "" || wsl {
+		return ""
+	}
+	return "there is no display on this machine to open a browser on"
+}
+
+// inWSL says whether magpie runs inside WSL, by the kernel's name: WSL1
+// and WSL2 both report a microsoft one.
+func inWSL() bool {
+	b, ok := osrelease()
+	return ok && strings.Contains(strings.ToLower(b), "microsoft")
+}
+
+// osrelease is this machine's kernel name, whether it could be read;
+// tests stand in for it.
+var osrelease = func() (string, bool) {
+	b, err := os.ReadFile("/proc/sys/kernel/osrelease")
+	return string(b), err == nil
+}
+
 // startBrowser starts cmd and reaps it once it ends; tests stand in for it.
 var startBrowser = func(cmd *exec.Cmd) error {
 	if err := cmd.Start(); err != nil {
diff --git a/internal/proc/browser_test.go b/internal/proc/browser_test.go
index d6a64b78c..b52e3047f 100644
--- a/internal/proc/browser_test.go
+++ b/internal/proc/browser_test.go
@@ -1,7 +1,9 @@
 package proc
 
 import (
+	"os/exec"
 	"path/filepath"
+	"strings"
 	"testing"
 )
 
@@ -27,3 +29,74 @@ func TestBrowserNamesRundll32ByItsPath(t *testing.T) {
 		}
 	}
 }
+
+// A magpie on a server, in a container or over SSH has no display for
+// xdg-open, and a browser started there only comes up and goes away
+// (#5958): none starts, and the error says why, for the caller to show
+// with the link it prints. A display keeps the browser, as do WSL (its
+// xdg-open is wslview, which opens Windows' own browser with no Linux
+// display) and the systems whose launcher reaches a screen of its own:
+// darwin's open, Windows' rundll32 and termux-open-url.
+func TestBrowserWithoutDisplayStartsNoneAndSaysWhy(t *testing.T) {
+	t.Setenv("DISPLAY", "")
+	t.Setenv("WAYLAND_DISPLAY", "")
+	start := startBrowser
+	defer func() { startBrowser = start }()
+	var started int
+	startBrowser = func(*exec.Cmd) error { started++; return nil }
+	kernel := osrelease
+	defer func() { osrelease = kernel }()
+
+	// WSL is spared: its launcher opens Windows' own browser
+	osrelease = func() (string, bool) { return "5.15.167.4-microsoft-standard-WSL2", true }
+	if err := openBrowserOn("linux", "https://accounts.google.com/o/oauth2/authorize"); err != nil {
+		t.Fatalf("WSL: %v", err)
+	}
+	// a plain server's launcher has no display to open a browser on
+	osrelease = func() (string, bool) { return "6.8.0-85-generic", true }
+	err := openBrowserOn("linux", "https://accounts.google.com/o/oauth2/authorize")
+	if err == nil || started != 1 || !strings.Contains(err.Error(), "no display") {
+		t.Fatalf("no display: err %v, started %d", err, started)
+	}
+	// a display, X11's or Wayland's, keeps the browser
+	t.Setenv("DISPLAY", ":0")
+	if err := openBrowserOn("linux", "https://accounts.google.com/o/oauth2/authorize"); err != nil || started != 2 {
+		t.Fatalf("X11: err %v, started %d", err, started)
+	}
+	t.Setenv("DISPLAY", "")
+	t.Setenv("WAYLAND_DISPLAY", "wayland-0")
+	if err := openBrowserOn("linux", "https://accounts.google.com/o/oauth2/authorize"); err != nil || started != 3 {
+		t.Fatalf("Wayland: err %v, started %d", err, started)
+	}
+	t.Setenv("WAYLAND_DISPLAY", "")
+	// darwin's open, Windows' rundll32 and termux-open-url need no display here
+	for _, goos := range []string{"darwin", "windows", "android"} {
+		if err := openBrowserOn(goos, "https://accounts.google.com/o/oauth2/authorize"); err != nil {
+			t.Fatalf("%s: %v", goos, err)
+		}
+	}
+	if started != 6 {
+		t.Fatalf("browsers started: %d", started)
+	}
+}
+
+// inWSL reads the kernel's name: WSL1 and WSL2 both report a microsoft
+// one; anything else, or a name that can't be read, is not WSL.
+func TestInWSL(t *testing.T) {
+	kernel := osrelease
+	defer func() { osrelease = kernel }()
+	for name, want := range map[string]bool{
+		"5.15.167.4-microsoft-standard-WSL2": true,
+		"4.4.0-19041-Microsoft":              true,
+		"6.8.0-85-generic":                   false,
+	} {
+		osrelease = func() (string, bool) { return name, true }
+		if got := inWSL(); got != want {
+			t.Errorf("%s: %v, want %v", name, got, want)
+		}
+	}
+	osrelease = func() (string, bool) { return "", false }
+	if inWSL() {
+		t.Error("a kernel whose name can't be read: WSL")
+	}
+}
