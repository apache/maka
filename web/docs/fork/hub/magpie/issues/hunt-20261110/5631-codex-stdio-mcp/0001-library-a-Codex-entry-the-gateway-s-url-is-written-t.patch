From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ggbdpq <ggbdpq@gmail.com>
Date: Sun, 8 Nov 2026 01:29:41 +0800
Subject: [PATCH] library: a Codex entry the gateway's url is written to keeps
 no type (#5631)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Phoenix0531-sudo on #5631: ms, a local stdio server, given to Codex from
the library came out in ~/.codex/config.toml as

  [mcp_servers.ms]
  url = "http://127.0.0.1:3425/mcp/run/ms"
  type = "stdio"

The url is what a shared server is given to Codex on magpie as (#3885,
magpie starts the command when a session uses it); the type beside it is
not. The user's hand-written stdio entry had it, and merged kept every old
key magpie doesn't own: type is neither magpie's (owned) nor one Codex
refuses (codexRefused), so it outlived the entry's becoming a URL. Codex
reads no type at all — RawMcpServerConfig has no such field (codex-rs/
config/src/mcp_types.rs), the config docs take none, and codex-cli 0.167.0
here drops the key when it rewrites config.toml itself — but the entry
contradicts itself all the same, and the reporter's codex read it as
stdio. The command form stays the user's other choice: a server kept
direct is given to Codex as its command (#4382).

Now codexRefused names type from either transport, so merged drops it when
magpie writes the entry and behind reports an entry holding one, and the
next sync (and a project's .codex/config.toml) rewrites it. The user's
keys that both transports take stay.

Siblings: runVia, the only place a command becomes a URL, has one caller
(syncMCP); every Codex entry is built by merged, which the tools-off and
project writes go through too. The other formats either write type
themselves, have it among owned (Grok), or are never switched between
transports by magpie, so a type there stays what the user wrote.

Run (mote): go test -tags nogui ./internal/library -count=1 ok (122.5s);
the two new tests against the old mcp.go are red with the reporter's
exact shape (url + type = "stdio" beside it), the repair one too (an
entry already broken is written again); -race over the Codex entry
family ok; gofmt -l clean; go vet and go build -tags nogui clean on
darwin, linux and windows. Real codex-cli 0.167.0: a url + type = "stdio"
entry loads as streamable_http (the key ignored), and codex mcp add's own
rewrite of config.toml takes the key out.
---
 internal/library/codex_transport_keys_test.go | 67 +++++++++++++++++++
 internal/library/mcp.go                       | 10 ++-
 2 files changed, 74 insertions(+), 3 deletions(-)

diff --git a/internal/library/codex_transport_keys_test.go b/internal/library/codex_transport_keys_test.go
index eafa8beba..c5c3e18d6 100644
--- a/internal/library/codex_transport_keys_test.go
+++ b/internal/library/codex_transport_keys_test.go
@@ -5,6 +5,8 @@ import (
 	"slices"
 	"strings"
 	"testing"
+
+	"github.com/yetone/magpie/internal/agent"
 )
 
 // codexLoads fails the test when Codex would refuse the entry: a key of
@@ -115,6 +117,71 @@ func TestCodexEntryWithOtherTransportKeysRepaired(t *testing.T) {
 	}
 }
 
+// The reporter's shape (#5631, Phoenix0531-sudo): Codex's config took the
+// user's hand-written stdio entry, then the library gave the server to
+// Codex on magpie as the gateway's url and kept the entry's type =
+// "stdio" beside it. Codex reads no type at all (codex-rs/config/src/
+// mcp_types.rs has no such field; codex's own rewrite of config.toml drops
+// it), and one left from the entry's former shape names the transport the
+// entry no longer is — the reporter's codex read the url entry as stdio.
+func TestRunCodexEntryLeavesStaleType(t *testing.T) {
+	h := sandbox(t)
+	resetRuns(t)
+	runOn = true
+	was := runWired
+	runWired = func(a *agent.Agent) bool { return true }
+	t.Cleanup(func() { runOn, runWired = false, was })
+	cfg := filepath.Join(h, ".codex/config.toml")
+	write(t, cfg, "[mcp_servers.ms]\ntype = \"stdio\"\ncommand = \"ms.exe\"\nargs = [\"mcp\", \"serve\"]\n")
+	if _, err := SaveServer("", Server{Name: "ms", Transport: "stdio", Command: "ms.exe", Args: []string{"mcp", "serve"}, Agents: []string{"codex"}}); err != nil {
+		t.Fatal(err)
+	}
+	e := codexEntry(t, cfg, "ms")
+	if e == nil || e["url"] == nil || e["command"] != nil {
+		t.Fatalf("not the gateway's url entry:\n%s", read(t, cfg))
+	}
+	if e["type"] != nil {
+		t.Errorf("the stdio type stayed beside the url:\n%s", read(t, cfg))
+	}
+	// and the shape holds on the next sync
+	if _, err := Sync(); err != nil {
+		t.Fatal(err)
+	}
+	if e = codexEntry(t, cfg, "ms"); e["url"] == nil || e["type"] != nil {
+		t.Errorf("the next sync wrote the type back:\n%s", read(t, cfg))
+	}
+}
+
+// An entry already holding the stale type — the reporter's config.toml
+// after an older sync — is written again without it, though the server
+// itself reads as unchanged; the converse (a type naming a url transport
+// beside a command) too, and the user's own keys stay.
+func TestCodexEntryWithStaleTypeRepaired(t *testing.T) {
+	h := sandbox(t)
+	cfg := filepath.Join(h, ".codex/config.toml")
+	ok(t)(SaveServer("", Server{Name: "remote", Transport: "http", URL: "https://r.example/mcp", Agents: []string{"codex"}}))
+	ok(t)(SaveServer("", Server{Name: "local", Transport: "stdio", Command: "npx", Args: []string{"-y", "l"}, Agents: []string{"codex"}}))
+	s := read(t, cfg)
+	s = strings.Replace(s, "url = ", "type = \"stdio\"\ntool_timeout_sec = 90\nurl = ", 1)
+	s = strings.Replace(s, "command = ", "type = \"streamable_http\"\ncommand = ", 1)
+	write(t, cfg, s)
+
+	ok(t)(Sync())
+	if r := codexEntry(t, cfg, "remote"); r["url"] == nil {
+		t.Fatalf("not the url entry:\n%s", read(t, cfg))
+	} else if r["type"] != nil {
+		t.Errorf("the stale stdio type stayed beside the url:\n%s", read(t, cfg))
+	}
+	if r := codexEntry(t, cfg, "remote"); !isNumber(r["tool_timeout_sec"], 90) {
+		t.Errorf("the user's tool_timeout_sec went:\n%s", read(t, cfg))
+	}
+	if l := codexEntry(t, cfg, "local"); l["command"] != "npx" {
+		t.Fatalf("not the command entry:\n%s", read(t, cfg))
+	} else if l["type"] != nil {
+		t.Errorf("the stale http type stayed beside the command:\n%s", read(t, cfg))
+	}
+}
+
 // A project's .codex/config.toml is held to the same: a server made remote
 // there leaves its command's keys.
 func TestCodexProjectEntryLeavesCommandKeys(t *testing.T) {
diff --git a/internal/library/mcp.go b/internal/library/mcp.go
index cb2fb1e2b..49ce052be 100644
--- a/internal/library/mcp.go
+++ b/internal/library/mcp.go
@@ -1463,12 +1463,16 @@ func (f *mcpFile) merged(s *Server, old map[string]any) ordered {
 // other kind, goes when magpie writes the entry; the user's keys of s's
 // own transport stay (codex-rs/config/src/mcp_types.rs, TryFrom
 // RawMcpServerConfig). bearer_token, which Codex refuses for both, is the
-// user's to take out.
+// user's to take out. type goes from either: Codex's config takes no type
+// at all (RawMcpServerConfig has no such field, and Codex's own rewrite of
+// config.toml drops it), so a type left from the entry's former shape only
+// names the transport the entry no longer is — a url entry read as "stdio"
+// (#5631).
 func codexRefused(s *Server) []string {
 	if s.Remote() {
-		return []string{"args", "env", "env_vars", "cwd"}
+		return []string{"args", "env", "env_vars", "cwd", "type"}
 	}
-	return []string{"url", "bearer_token_env_var", "http_headers", "env_http_headers", "http_headers_helper", "oauth", "oauth_resource", "auth"}
+	return []string{"url", "bearer_token_env_var", "http_headers", "env_http_headers", "http_headers_helper", "oauth", "oauth_resource", "auth", "type"}
 }
 
 // put writes the server into the file, in place of one by its name.
