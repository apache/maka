diff --git a/internal/agent/dsh_dsbot_home_test.go b/internal/agent/dsh_dsbot_home_test.go
new file mode 100644
index 000000000..93ddadc0a
--- /dev/null
+++ b/internal/agent/dsh_dsbot_home_test.go
@@ -0,0 +1,69 @@
+package agent
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/yetone/magpie/internal/sessions"
+)
+
+// #5624 (BErrybearl): DS Bot's app runs its own DSH with DSH_HOME at its
+// data folder — a value the registry holds on Windows, which appdir.Getenv
+// follows while magpie sits in the tray. With DSH_HOME naming DS Bot's data
+// folder, dsh's row bound there and the serving round wrote magpie's route
+// into ~/.ds-bot/profiles/ds-bot/cordis.patch.yml over DS Bot's own
+// provider, and its sessions and usage were the harness's. The folder is
+// DS Bot's (DsbotHome): dsh keeps ~/.dsh whatever DSH_HOME says when it
+// says that, and DS Bot's row keeps the folder.
+func TestDshLeavesDsBotsFolder(t *testing.T) {
+	home, dshDir, _, _ := dsbotSandbox(t)
+	data := filepath.Join(home, ".ds-bot")
+	file := dsbotFile(data)
+	// the app's own profile, as its first start makes it
+	if err := os.MkdirAll(filepath.Dir(file), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, []byte(dshProfileTemplate), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("DSH_HOME", data)
+
+	a := dsh(home)
+	if a.Dir != dshDir {
+		t.Fatalf("dsh bound to DS Bot's data folder: %s", a.Dir)
+	}
+	if a.Path != filepath.Join(dshDir, "profiles", "web", "cordis.patch.yml") {
+		t.Fatalf("dsh's patch list is %s", a.Path)
+	}
+	if dir := dshHome(); dir != dshDir {
+		t.Fatalf("the serving round keeps %s", dir)
+	}
+	if dir := sessions.DshDir(); dir != dshDir {
+		t.Fatalf("sessions read %s", dir)
+	}
+	// DS Bot's row still owns its folder
+	if b := dsbot(home); b.Path != file {
+		t.Fatalf("DS Bot's row names %s", b.Path)
+	}
+
+	// DS_BOT_HOME moves the folder; DSH_HOME there is still its
+	thrown := filepath.Join(home, "throwaway")
+	if err := os.MkdirAll(filepath.Join(thrown, "profiles", "ds-bot"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(dsbotFile(thrown), []byte(dshProfileTemplate), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("DS_BOT_HOME", thrown)
+	t.Setenv("DSH_HOME", thrown)
+	if dir := dshHome(); dir != dshDir {
+		t.Fatalf("the serving round keeps %s with DS_BOT_HOME set", dir)
+	}
+	if a := dsh(home); a.Dir != dshDir {
+		t.Fatalf("dsh bound to %s with DS_BOT_HOME set", a.Dir)
+	}
+	if b := dsbot(home); b.Path != dsbotFile(thrown) {
+		t.Fatalf("DS Bot's row names %s with DS_BOT_HOME set", b.Path)
+	}
+}
diff --git a/internal/appdir/dsbot.go b/internal/appdir/dsbot.go
new file mode 100644
index 000000000..623955d5e
--- /dev/null
+++ b/internal/appdir/dsbot.go
@@ -0,0 +1,75 @@
+package appdir
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// DS Bot (github.com/Fei2411/DS-Bot) is a DSH plugin and an Electron
+// desktop app built on it. The app ships its own DSH and runs it with
+// DSH_HOME at a data folder of its own, booting the profile ds-bot, and
+// never reads ~/.dsh. Its folder is chosen by chooseLocations
+// (app/src/first-run.mjs): DS_BOT_HOME, which runs the app on throwaway
+// folders, else locations.json's dataDir in the app's Electron userData
+// (DS_BOT_SHELL_DATA when set, else <appData>/DS Bot, or <appData>/DeepSeek
+// Bot, its name before, while that one is there and DS Bot's has no
+// locations.json: configureIdentity in app/src/legacy.mjs), else ~/.ds-bot,
+// the folder its first run saves when the user keeps the default.
+
+// DsbotHome is DS Bot's data folder, the DSH_HOME its own DSH runs on, and
+// whether it is known. A locations.json that can't be read or names no
+// folder is unknown: never taken for the default, where an agent would be
+// wired onto a folder the app doesn't run on.
+func DsbotHome() (string, bool) {
+	if dir := Getenv("DS_BOT_HOME"); dir != "" {
+		return dir, true
+	}
+	userData := Getenv("DS_BOT_SHELL_DATA")
+	if userData == "" {
+		cfg, err := os.UserConfigDir()
+		if err != nil {
+			return "", false
+		}
+		userData = filepath.Join(cfg, "DS Bot")
+		if legacy := filepath.Join(cfg, "DeepSeek Bot"); !isFile(filepath.Join(userData, "locations.json")) && isDir(legacy) {
+			userData = legacy
+		}
+	}
+	b, err := os.ReadFile(filepath.Join(userData, "locations.json"))
+	if errors.Is(err, os.ErrNotExist) {
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return "", false
+		}
+		return filepath.Join(home, ".ds-bot"), true
+	}
+	if err != nil {
+		return "", false
+	}
+	var places struct {
+		DataDir string `json:"dataDir"`
+	}
+	if json.Unmarshal(b, &places) != nil || strings.TrimSpace(places.DataDir) == "" {
+		return "", false
+	}
+	return places.DataDir, true
+}
+
+// DsbotOwns is whether dir is DS Bot's data folder: what its own DSH runs
+// on, and no other agent's to bind, read or write. DS Bot's app exports
+// DSH_HOME at that folder — a registry value on Windows, which Getenv
+// follows while magpie runs — and DeepSeek Harness took it for its own
+// home, writing its route over DS Bot's own (#5624).
+func DsbotOwns(dir string) bool {
+	if dir == "" {
+		return false
+	}
+	home, ok := DsbotHome()
+	return ok && sameDir(home) == sameDir(dir)
+}
+
+func isFile(p string) bool { st, err := os.Stat(p); return err == nil && !st.IsDir() }
+func isDir(p string) bool  { st, err := os.Stat(p); return err == nil && st.IsDir() }
