From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: apple-ouyang <apple-ouyang@users.noreply.github.com>
Date: Fri, 6 Nov 2026 11:21:05 +0800
Subject: [PATCH] usage: a session still at work no longer writes the whole
 request cache again

The file of the session files' chunks (requests-v1.bin) is written whole
whenever requestDiskLeast chunks have been made again since the last
write. A session still at work is made again at every page read, so 64
pages of the same growing session reached the threshold: on a long history
one working agent wrote the whole cache again and again (#4276: 97.4 MB in
96 seconds over a 24 MB cache), and an app reading the Usage page of a
114 MB cache wrote ~200 KB/s to disk while a `serve --no-web` daemon on the
same traffic wrote nothing (#5440).

Count the session files whose chunk was made again, not the chunks made,
so only requestDiskLeast different files justify writing the whole file
again. The rows branch, the sources' validity and the file's format are
unchanged: a chunk is still written when its source's size or mtime moved.

Test: TestRequestDiskOneGrowingSessionWritesOnce (new). Without the change
it fails with "the file was written again for one session file made again
5 times" (request_disk_dirty_test.go). With it, four cached sessions with
one of them rewritten five times write nothing, while three other session
files changing still write the file, and every page's rows are checked.

Run: gofmt -l internal/usage/ (nothing), go vet ./..., GOOS=linux go vet
-tags nogui ./..., GOOS=windows go vet ./..., go build ./...,
go test ./internal/usage/ (ok, 25.9s).
---
 internal/usage/request_disk_dirty_test.go | 126 ++++++++++++++++++++++
 internal/usage/request_page.go            |  54 ++++++----
 2 files changed, 158 insertions(+), 22 deletions(-)
 create mode 100644 internal/usage/request_disk_dirty_test.go

diff --git a/internal/usage/request_disk_dirty_test.go b/internal/usage/request_disk_dirty_test.go
new file mode 100644
index 000000000..20309b0f1
--- /dev/null
+++ b/internal/usage/request_disk_dirty_test.go
@@ -0,0 +1,126 @@
+package usage
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/sessions"
+)
+
+// codexCall is one request of a session file the test writes whole each
+// time, as a session still at work grows.
+type codexCall struct {
+	respID        string
+	at            time.Time
+	input, output int
+}
+
+// writeCodexSession writes one Codex rollout holding calls, each with its
+// turn.
+func writeCodexSession(t *testing.T, path, id, session string, calls []codexCall) {
+	t.Helper()
+	lines := []any{map[string]any{"timestamp": "2026-09-30T10:00:00Z", "type": "session_meta", "payload": map[string]any{"id": id, "session_id": session, "source": "cli"}}}
+	for _, c := range calls {
+		lines = append(lines,
+			map[string]any{"timestamp": c.at.Add(-time.Second).Format(time.RFC3339Nano), "type": "turn_context", "payload": map[string]any{"turn_id": "turn-" + c.respID, "model": "m", "effort": "high"}},
+			map[string]any{"timestamp": c.at.Format(time.RFC3339Nano), "type": "token_usage_record", "payload": map[string]any{
+				"response_id": c.respID, "session_id": session, "thread_id": id, "turn_id": "turn-" + c.respID,
+				"usage": map[string]int{"input_tokens": c.input, "cached_input_tokens": 0, "cache_write_input_tokens": 0, "output_tokens": c.output, "reasoning_output_tokens": 0, "total_tokens": c.input + c.output},
+			}})
+	}
+	var data []byte
+	for _, line := range lines {
+		b, err := json.Marshal(line)
+		if err != nil {
+			t.Fatal(err)
+		}
+		data = append(data, b...)
+		data = append(data, '\n')
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// A session still at work is made again at every page, and its chunk is
+// new each time. The file of the chunks is written again once
+// requestDiskLeast of them are made, and the chunks of one session file,
+// made again over and over, counted as many: a cache of a long history was
+// written whole again and again while one agent worked (#4276, 97.4 MB in
+// 96 seconds). The threshold counts the session files that changed, not
+// the chunks made.
+func TestRequestDiskOneGrowingSessionWritesOnce(t *testing.T) {
+	pageHome(t)
+	now := holdClock(t, time.Date(2026, 9, 30, 12, 0, 0, 0, time.Local))
+	least, rows := requestDiskLeast, requestDiskLeastRows
+	requestDiskLeast, requestDiskLeastRows = 3, 20000
+	requestCache.Lock()
+	requestCache.savedRows = false
+	requestCache.Unlock()
+	t.Cleanup(func() {
+		requestDiskLeast, requestDiskLeastRows = least, rows
+		requestCache.Lock()
+		requestCache.savedRows = false
+		requestCache.Unlock()
+	})
+	dir := filepath.Join(sessions.CodexDir(), "sessions", "2026", "09", "30")
+	rollout := func(i int) string {
+		return filepath.Join(dir, fmt.Sprintf("rollout-2026-09-30T10-00-0%d-s%d.jsonl", i, i))
+	}
+	calls := make([][]codexCall, 4)
+	page := func() RequestPage {
+		t.Helper()
+		got := queryPage(All, Filter{}, 0, 100, sessions.ReadCallSource)
+		requestDiskSaves.Wait()
+		return got
+	}
+	// four session files: the first page makes a chunk of each, and writes
+	// them (requestDiskLeast of them)
+	for i := range 4 {
+		calls[i] = []codexCall{{fmt.Sprintf("resp-%d", i), now.Add(-time.Duration(i+1) * time.Minute), 10, 1}}
+		writeCodexSession(t, rollout(i), fmt.Sprintf("s%d", i), fmt.Sprintf("s%d", i), calls[i])
+	}
+	if p := page(); p.Total != 4 {
+		t.Fatalf("first page: %d rows, want 4", p.Total)
+	}
+	written, err := os.ReadFile(requestDiskPath())
+	if err != nil {
+		t.Fatalf("4 chunks of 4 files made, and no file of them: %v", err)
+	}
+	// one of them grows, and grows again: its chunk is made again at every
+	// page, more often than requestDiskLeast, and the file of them is not
+	// written again, since only one session file changed
+	later := time.Now().Add(time.Minute)
+	for i := range 5 {
+		calls[0] = append(calls[0], codexCall{fmt.Sprintf("resp-0-%d", i), now.Add(time.Duration(i) * time.Second), 100 + i, 1})
+		writeCodexSession(t, rollout(0), "s0", "s0", calls[0])
+		later = later.Add(time.Minute)
+		os.Chtimes(rollout(0), later, later)
+		if p := page(); p.Total != 4+i+1 {
+			t.Fatalf("page %d: %d rows, want %d", i, p.Total, 4+i+1)
+		}
+	}
+	if again, _ := os.ReadFile(requestDiskPath()); string(again) != string(written) {
+		t.Fatalf("the file was written again for one session file made again 5 times")
+	}
+	// three session files changed: the file of their chunks is written
+	for i := 1; i < 4; i++ {
+		calls[i] = append(calls[i], codexCall{fmt.Sprintf("resp-%d-more", i), now.Add(time.Minute), 10, 1})
+		writeCodexSession(t, rollout(i), fmt.Sprintf("s%d", i), fmt.Sprintf("s%d", i), calls[i])
+		later = later.Add(time.Minute)
+		os.Chtimes(rollout(i), later, later)
+	}
+	if p := page(); p.Total != 9+3 {
+		t.Fatalf("page after three files changed: %d rows, want 12", p.Total)
+	}
+	if same, _ := os.ReadFile(requestDiskPath()); string(same) == string(written) {
+		t.Fatalf("the file was not written for three session files made again")
+	}
+}
diff --git a/internal/usage/request_page.go b/internal/usage/request_page.go
index b92468ce9..d072e3d1b 100644
--- a/internal/usage/request_page.go
+++ b/internal/usage/request_page.go
@@ -734,12 +734,13 @@ type requestIndex struct {
 	// pairs are the last pairing of each of a few periods (pairMemo),
 	// kept as parts are
 	pairs map[Period]*pairMemo
-	// on are the paths the last read listed; unsaved counts the chunks
-	// made since the file of them was last written (toDisk), and saving
-	// says a write is under way; unsavedRows counts their rows, and
-	// savedRows says a write was made for them (once a run)
+	// on are the paths the last read listed; dirty are the session files
+	// whose chunk was made since the file of them was last written
+	// (toDisk), and saving says a write is under way; unsavedRows counts
+	// their rows, and savedRows says a write was made for them (once a
+	// run)
 	on          map[string]bool
-	unsaved     int
+	dirty       map[string]struct{}
 	unsavedRows int
 	saving      bool
 	savedRows   bool
@@ -1135,9 +1136,10 @@ type requestBlocks struct {
 	gateways, chunks, others []*rowChunk
 	on                       map[string]bool
 	priced                   *blockPricer
-	// built counts the session files' chunks made again, and builtRows
-	// their rows
-	built, builtRows int
+	// built are the session files whose chunk was made again, which
+	// builtRows counts the rows of
+	built     []string
+	builtRows int
 }
 
 // readRequestBlocks reads the blocks of p at now into idx, a private copy
@@ -1235,7 +1237,7 @@ func readRequestBlocks(idx *requestIndex, st requestState, p Period, now, settle
 		idx.fromDisk(want)
 		spill = newArchiveSpill()
 	}
-	built, builtRows := 0, 0
+	built, builtRows := []string{}, 0
 	// A file's rows are made by the reader that read it: made one after
 	// another, they were most of a cold build's wait (#3493).
 	makeChunk := func() func(sessions.CallSource) *rowChunk {
@@ -1276,7 +1278,7 @@ func readRequestBlocks(idx *requestIndex, st requestState, p Period, now, settle
 		if reused := c != nil && c.Source.Size == s.Size && c.Source.Modified.Equal(s.Modified); !reused {
 			c = read(i)
 			c.serial = sourceSerial(st.root, st.meta, s)
-			built++
+			built = append(built, s.Path)
 			builtRows += c.Count
 			c.used = useAt(idx.tick)
 			put = spill.put(c, i)
@@ -1482,20 +1484,28 @@ func (idx *requestIndex) keep(read *requestIndex, on map[string]bool) bool {
 	return true
 }
 
-// noteBuilt counts the chunks b made, and writes the file of them once
-// they are requestDiskLeast or more (a first read of the history): fewer
-// are a few shard reads at the next start, and not worth writing the
-// whole file (~44MB for 15.6k sessions) again. Or once a run, when they
-// hold requestDiskLeastRows rows: a few long sessions that ended since
-// the last write (9 files, 84.6k calls, ~1s) were made again at every
-// start, and the next ones that end joined them, until they were
-// requestDiskLeast files. Once, as a session still at work grows with
-// every call and is made again for each. idx is locked.
+// noteBuilt counts the session files b made chunks of again, and writes
+// the file of them once they are requestDiskLeast or more (a first read of
+// the history): fewer are a few shard reads at the next start, and not
+// worth writing the whole file (~44MB for 15.6k sessions) again. Counting
+// the files rather than the chunks made is what keeps one session still at
+// work, made again at every page, from writing the whole file again and
+// again (#4276: 97.4 MB in 96 seconds over a 24 MB cache). Or once a run,
+// when they hold requestDiskLeastRows rows: a few long sessions that ended
+// since the last write (9 files, 84.6k calls, ~1s) were made again at
+// every start, and the next ones that end joined them, until they were
+// requestDiskLeast files, and not again for the rows of a session still at
+// work, made again at every page. idx is locked.
 func (idx *requestIndex) noteBuilt(b requestBlocks) {
 	idx.on = b.on
-	idx.unsaved += b.built
+	if idx.dirty == nil {
+		idx.dirty = make(map[string]struct{}, len(b.built))
+	}
+	for _, path := range b.built {
+		idx.dirty[path] = struct{}{}
+	}
 	idx.unsavedRows += b.builtRows
-	if idx.unsaved >= requestDiskLeast {
+	if len(idx.dirty) >= requestDiskLeast {
 		idx.save()
 	} else if !idx.savedRows && idx.unsavedRows >= requestDiskLeastRows {
 		idx.savedRows = true
@@ -1520,7 +1530,7 @@ func (idx *requestIndex) save() {
 		return
 	}
 	idx.saving = true
-	idx.unsaved, idx.unsavedRows = 0, 0 // a write that fails is tried again only for new chunks
+	idx.dirty, idx.unsavedRows = nil, 0 // a write that fails is tried again only for new chunks
 	root, meta, chunks, on := idx.root, idx.meta, maps.Clone(idx.chunks), idx.on
 	requestDiskSaves.Add(1)
 	go func() {
-- 
