 }
 
-// mayLoop: body has results enough to hold a loop.
+// mayLoop: body has calls or results enough to hold a loop.
 func mayLoop(from provider.Protocol, body []byte) bool {
 	n := 0
 	for _, m := range toolResultMarks[from] {
