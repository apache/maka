@@ -132,9 +134,18 @@
       try {
         const url = String((input && input.url) || input);
         const headers = new Headers((init && init.headers) || (input && input.headers) || undefined);
+        const main = headers.get("x-claude-code-request-class") === "main" && /\/v1\/messages(\?|$)/.test(url);
