index ba636294a..d09da0c39 100644
--- a/docs/subsystems/claude-subscription-bridge.md
+++ b/docs/subsystems/claude-subscription-bridge.md
@@ -224,6 +224,21 @@ The tap parses the other and writes one JSON line per event to the file:
 `{tap: "on"}`, or `{tap: "none"}` when there is no `FetchSession` to
 replace.
 
+For every reply to such a main-turn `/v1/messages` request, streamed or
+not, the tap also writes `{limits}`: its `anthropic-ratelimit-unified-*`
+headers, keyed without that prefix. The transcript keeps a reply's
+`rate_limit_info` only for a request turned away, so without them an
+account that can't run `/usage` (a setup-token's) stayed unknown in
+interactive mode. The helper tells them as the `rate_limit_event` `-p`
+tells for the same reply (`limitsInfo`): `status`, `rateLimitType` and
+`resetsAt` from `status`, `representative-claim` and `reset`, and each of
+`5h`, `7d` and `7d_oi` whose `-utilization` parses as the
+`unifiedWindows` entry `five_hour`, `seven_day` and
+`seven_day_overage_included`, as Claude Code itself maps them. A share that
+doesn't parse is a window not told, never one unused, and headers that tell
+no share and no refusal tell nothing (`TestTapTellsLimits`,
+`TestTapLimitsUnsaid`).
+
 The helper reads the file every time round the tail loop, every 10ms
 while a stream is open, and tells each event as `-p` does: a
 `stream_event` line. Order is kept two ways:
diff --git a/internal/claudetui/tap.go b/internal/claudetui/tap.go
index ae499823e..7ac76c5b7 100644
--- a/internal/claudetui/tap.go
+++ b/internal/claudetui/tap.go
@@ -146,11 +146,12 @@ func (t *tap) read() {
 
 func (t *tap) line(b []byte) {
 	var l struct {
-		Tap   string          `json:"tap"`
-		S     int             `json:"s"`
-		Open  bool            `json:"open"`
-		End   string          `json:"end"`
-		Event json.RawMessage `json:"e"`
+		Tap    string            `json:"tap"`
+		S      int               `json:"s"`
+		Open   bool              `json:"open"`
+		End    string            `json:"end"`
+		Event  json.RawMessage   `json:"e"`
+		Limits map[string]string `json:"limits"`
 	}
 	if json.Unmarshal(b, &l) != nil || t.ended[l.S] {
 		return
@@ -158,6 +159,10 @@ func (t *tap) line(b []byte) {
 	switch {
 	case l.Tap != "":
 		t.on = l.Tap == "on"
+	case len(l.Limits) > 0:
+		if info := limitsInfo(l.Limits); info != nil {
+			t.out.emit(map[string]any{"type": "rate_limit_event", "rate_limit_info": info, "session_id": t.sid})
+		}
 	case l.Open:
 		t.open[l.S] = &tapStream{}
 	case len(l.Event) > 0:
@@ -207,6 +212,47 @@ func (t *tap) event(e json.RawMessage) {
 	t.out.emit(map[string]any{"type": "stream_event", "event": e, "session_id": t.sid, "parent_tool_use_id": nil})
 }
 
+// limitWindows are the windows a reply's anthropic-ratelimit-unified-*
+// headers name, by the short name in the header (5h-utilization), as
+// Claude Code reads them into a rate_limit_event's unifiedWindows.
+var limitWindows = [][2]string{{"five_hour", "5h"}, {"seven_day", "7d"}, {"seven_day_overage_included", "7d_oi"}}
+
+// limitsInfo is the rate_limit_info -p tells for a reply whose
+// anthropic-ratelimit-unified-* headers are h, keyed without that prefix:
+// its status, the window it is about and when that renews, and each
+// window whose share used is said. Nil when h says none of that.
+func limitsInfo(h map[string]string) map[string]any {
+	info := map[string]any{}
+	windows := map[string]any{}
+	for _, w := range limitWindows {
+		used, err := strconv.ParseFloat(h[w[1]+"-utilization"], 64)
+		if err != nil {
+			continue // not said: unknown, not none used
+		}
+		win := map[string]any{"utilization": used}
+		if at, err := strconv.ParseFloat(h[w[1]+"-reset"], 64); err == nil {
+			win["resetsAt"] = int64(at + 0.5)
+		}
+		windows[w[0]] = win
+	}
+	if len(windows) > 0 {
+		info["unifiedWindows"] = windows
+	}
+	if s := h["status"]; s != "" {
+		info["status"] = s
+	}
+	if c := h["representative-claim"]; c != "" {
+		info["rateLimitType"] = c
+		if at, err := strconv.ParseFloat(h["reset"], 64); err == nil {
+			info["resetsAt"] = int64(at + 0.5)
+		}
+	}
+	if len(windows) == 0 && info["status"] != "rejected" {
+		return nil // nothing the bridge keeps (claudeLimits)
+	}
+	return info
+}
+
 // going says whether a stream is open, one with no message yet if bare.
 func (t *tap) going(bare bool) bool {
 	for _, st := range t.open {
diff --git a/internal/claudetui/tap.js b/internal/claudetui/tap.js
