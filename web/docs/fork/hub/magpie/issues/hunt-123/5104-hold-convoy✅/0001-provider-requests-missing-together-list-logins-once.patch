 	}
+	gen := held.gen
+	c := &heldCall{done: make(chan struct{})}
+	flight[key] = c
 	held.Unlock()
+	var v T
+	func() {
+		defer func() {
+			held.Lock()
+			delete(flight, key)
+			held.Unlock()
+			close(c.done)
+		}()
+		v = build()
+		held.Lock()
+		if held.holds > 0 && held.gen == gen {
+			if held.built == nil {
+				held.built = map[string]heldValue{}
+			}
+			held.built[key] = heldValue{v, time.Now()}
+		}
+		held.Unlock()
+	}()
