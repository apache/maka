@@ -479,7 +477,11 @@ func (s *shim) ready() error {
 		s.doing.Store(doing)
 		switch {
 		case strings.Contains(p, "trust this folder") && os.Getenv(TrustEnv) != "1":
-			return errUntrusted
+			// the folder named, or the user doesn't know what to trust,
