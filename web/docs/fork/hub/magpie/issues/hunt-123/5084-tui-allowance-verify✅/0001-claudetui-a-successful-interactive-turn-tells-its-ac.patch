+++ b/docs/subsystems/claude-subscription-bridge.md
@@ -219,8 +219,11 @@ connection and TLS left as they were, and tees the body of each reply to
 a request with `x-claude-code-request-class: main`, a `/v1/messages` path
 and a `text/event-stream` reply. Claude Code reads one branch as before.
 The tap parses the other and writes one JSON line per event to the file:
-`{s, open}` when a stream starts, `{s, e}` for each event other than
-`ping`, and `{s, end: "done"|"cut"}` when it ends. At load it writes
+`{s, open}` when a stream starts, with `h`, the reply's
+`anthropic-ratelimit-unified-*` headers, when it has any, `{s, e}` for
+each event other than `ping`, and `{s, end: "done"|"cut"}` when it ends.
+The tap only reads the reply's headers; the request is sent as Claude
+Code made it. At load it writes
 `{tap: "on"}`, or `{tap: "none"}` when there is no `FetchSession` to
 replace.
 
@@ -235,6 +238,19 @@ while a stream is open, and tells each event as `-p` does: a
 - Before a turn's result, `tap.settle` waits up to 1s for the open
   streams to end, and ends the rest there.
 
+The headers become the `rate_limit_event` `-p` tells from them
+(`rateLimitInfo`, as Claude Code 2.1.291 builds it): `status` and
+`unifiedWindows` with each of `five_hour`, `seven_day` and
+`seven_day_overage_included` (`5h`, `7d`, `7d_oi`) whose utilization and
+reset are both said, the reset rounded to a second. A streamed message
+tells it before its `message_start`, so the bridge keeps it
+(`NoteClaudeLimits`) before the reply begins. A reply whose message was
+told whole, or that never started one, tells it at the turn's end
+(`tap.settle`), and only when it is the latest: a later reply's told
+with its stream is never followed by an older one's. A `<synthetic>` API error's own
+`rate_limit_info` is told after that, as the newest. Before this, a
+successful turn in the interactive mode told no allowance (T-076).
+
 A stream cut short gets a `message_stop` with no `message_delta`, as `-p`
 ends such a stream, and the bridge counts it as an attempt and asks
 again. In the bridge, a message that was streamed (`streamed`, by id) has
@@ -1449,7 +1465,8 @@ doesn't by default; that path is unchanged.
 ## The account's allowance on the reply (#1257)
 
 Claude Code tells a run's account allowance in its stream-json
-`rate_limit_event`, not as HTTP headers. The bridge keeps it
+`rate_limit_event`, not as HTTP headers; in the interactive mode the
+helper tells the same event from the tap (see above). The bridge keeps it
 (`provider.NoteClaudeLimits`) and says it again on the reply as the
 `anthropic-ratelimit-unified-{5h,7d,7d_oi}-{utilization,reset}` headers
 Anthropic sends (`limitHeaders`, from `provider.KeptClaudeLimits`): a share
diff --git a/internal/claudetui/tap.go b/internal/claudetui/tap.go
index ae499823e..c8d85728c 100644
--- a/internal/claudetui/tap.go
+++ b/internal/claudetui/tap.go
@@ -4,6 +4,7 @@ import (
 	"bufio"
 	_ "embed"
 	"encoding/json"
+	"math"
 	"os"
 	"path/filepath"
 	"runtime"
@@ -68,11 +69,20 @@ type tap struct {
 	dropped map[string]bool
 	out     emitter
 	sid     string
+	// limits is the allowance a reply told whose message was told whole
+	// or never began, of stream limitsOf: told before the turn's end
+	limits   json.RawMessage
+	limitsOf int
+	// toldOf is the latest stream whose allowance was told with it: an
+	// older one's is never told after it
+	toldOf int
 }
 
 type tapStream struct {
 	id      string
 	stopped bool
+	// limits is the rate_limit_info its reply's headers tell, until told
+	limits json.RawMessage
 }
 
 // newTap writes tap.js and the file it writes to in a folder of the
@@ -151,6 +161,8 @@ func (t *tap) line(b []byte) {
 		Open  bool            `json:"open"`
 		End   string          `json:"end"`
 		Event json.RawMessage `json:"e"`
+		// the reply's anthropic-ratelimit-unified-* headers
+		Headers map[string]string `json:"h"`
 	}
 	if json.Unmarshal(b, &l) != nil || t.ended[l.S] {
 		return
@@ -159,7 +171,7 @@ func (t *tap) line(b []byte) {
 	case l.Tap != "":
 		t.on = l.Tap == "on"
 	case l.Open:
-		t.open[l.S] = &tapStream{}
+		t.open[l.S] = &tapStream{limits: rateLimitInfo(l.Headers)}
 	case len(l.Event) > 0:
 		var e struct {
 			Type    string `json:"type"`
@@ -172,12 +184,27 @@ func (t *tap) line(b []byte) {
 		}
 		st := t.open[l.S]
 		if e.Type == "message_start" {
-			st = &tapStream{id: e.Message.ID}
+			var limits json.RawMessage
+			if st != nil {
+				limits = st.limits
+			}
+			st = &tapStream{id: e.Message.ID, limits: limits}
 			t.open[l.S] = st
 			if t.dropped[st.id] {
+				t.keepLimits(l.S, st)
 				return
 			}
 			t.started[st.id] = true
+			// as -p tells it, before the reply: the bridge says it on
+			// the reply's headers (limitHeaders)
+			if st.limits != nil && l.S > t.toldOf {
+				t.out.emit(map[string]any{"type": "rate_limit_event", "rate_limit_info": st.limits})
+				t.toldOf = l.S
+				if t.limitsOf < l.S {
+					t.limits, t.limitsOf = nil, 0
+				}
+			}
+			st.limits = nil
 		}
 		if st == nil || st.id == "" || t.dropped[st.id] {
 			return
@@ -198,6 +225,7 @@ func (t *tap) end(n int) {
 	st := t.open[n]
 	delete(t.open, n)
 	t.ended[n] = true
+	t.keepLimits(n, st)
 	if st != nil && st.id != "" && !st.stopped && !t.dropped[st.id] {
 		t.event(json.RawMessage(`{"type":"message_stop"}`))
 	}
@@ -254,4 +282,59 @@ func (t *tap) settle() {
 	for n := range t.open {
 		t.end(n)
 	}
+	if t.limits != nil {
+		t.out.emit(map[string]any{"type": "rate_limit_event", "rate_limit_info": t.limits})
+		t.limits, t.limitsOf = nil, 0
+	}
+}
+
+// keepLimits keeps what stream n's reply told of the allowance, not
+// told with its stream, for the turn's end, as a stream told mid-message
+// would end it in the bridge: the latest reply's, and only when no later
+// reply's was told already.
+func (t *tap) keepLimits(n int, st *tapStream) {
+	if st == nil || st.limits == nil {
+		return
+	}
+	if n > t.toldOf && n >= t.limitsOf {
+		t.limits, t.limitsOf = st.limits, n
+	}
+	st.limits = nil
+}
+
+// limitWindows are the windows Anthropic tells on a reply, as
+// anthropic-ratelimit-unified-<window>-*, by the kind -p names them in
+// its rate_limit_event (Claude Code 2.1.291).
+var limitWindows = []struct{ kind, window string }{
+	{"five_hour", "5h"},
+	{"seven_day", "7d"},
+	{"seven_day_overage_included", "7d_oi"},
+}
+
+// rateLimitInfo is a reply's allowance, from its headers, as -p tells it
+// in a rate_limit_event's rate_limit_info: each window that says both its
+// share used and when it renews. Nil when none does.
+func rateLimitInfo(h map[string]string) json.RawMessage {
+	num := func(name string) (float64, bool) {
+		v := strings.TrimSpace(h["anthropic-ratelimit-unified-"+name])
+		f, err := strconv.ParseFloat(v, 64)
+		return f, v != "" && err == nil && !math.IsInf(f, 0) && !math.IsNaN(f)
+	}
+	ws := map[string]any{}
+	for _, w := range limitWindows {
+		used, ok := num(w.window + "-utilization")
+		reset, ok2 := num(w.window + "-reset")
+		if ok && ok2 {
+			ws[w.kind] = map[string]any{"utilization": used, "resetsAt": int64(math.Round(reset))}
+		}
+	}
+	if len(ws) == 0 {
+		return nil
+	}
+	info := map[string]any{"unifiedWindows": ws}
+	if s := h["anthropic-ratelimit-unified-status"]; s != "" {
+		info["status"] = s
+	}
+	b, _ := json.Marshal(info)
+	return b
 }
