From: ggbdpq <ggbdpq@gmail.com>
Date: Sun, 8 Nov 2026 03:03:02 +0800
Subject: [PATCH] mcp router: an agent whose server is slow to start the first
 time is given its tools (#5638)

---
 internal/library/mcp_check_test.go         |  15 ++
 internal/library/mcp_hub.go                |  34 +++-
 internal/library/mcp_hub_slowstart_test.go | 182 +++++++++++++++++++++
 3 files changed, 227 insertions(+), 4 deletions(-)
 create mode 100644 internal/library/mcp_hub_slowstart_test.go

diff --git a/internal/library/mcp_check_test.go b/internal/library/mcp_check_test.go
index e00ea7c74..fff965b0b 100644
--- a/internal/library/mcp_check_test.go
+++ b/internal/library/mcp_check_test.go
@@ -117,6 +117,21 @@ func TestFakeMCPServer(t *testing.T) {
 			text, _ := json.Marshal(said)
 			fmt.Printf(`{"jsonrpc":"2.0","id":%d,"result":{"content":[{"type":"text","text":%s}]}}`+"\n", *m.ID, text)
 		case "initialize":
+			// MAGPIE_FAKE_MCP_FIRSTINIT: a marker file; the first process
+			// started writes it and takes MAGPIE_FAKE_MCP_SLOW_INIT to
+			// answer initialize, a start again answers at once (a cold
+			// first start, #5638)
+			if f := os.Getenv("MAGPIE_FAKE_MCP_FIRSTINIT"); f != "" {
+				if _, err := os.Stat(f); err != nil {
+					os.WriteFile(f, []byte("yes"), 0o644)
+					if d, err := time.ParseDuration(os.Getenv("MAGPIE_FAKE_MCP_SLOW_INIT")); err == nil && d > 0 {
+						time.Sleep(d)
+					}
+				}
+			} else if d, err := time.ParseDuration(os.Getenv("MAGPIE_FAKE_MCP_SLOW_INIT")); err == nil && d > 0 {
+				// a server that is slow to answer initialize at all
+				time.Sleep(d)
+			}
 			fmt.Printf(`{"jsonrpc":"2.0","id":%d,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"fake","version":"1"}}}`+"\n", *m.ID)
 		case "notifications/initialized":
 			os.WriteFile(os.Getenv("MAGPIE_FAKE_MCP_INIT"), []byte("yes"), 0o644)
diff --git a/internal/library/mcp_hub.go b/internal/library/mcp_hub.go
index 0ed601263..b6b38e17d 100644
--- a/internal/library/mcp_hub.go
+++ b/internal/library/mcp_hub.go
@@ -477,6 +477,7 @@ type backend struct {
 	conn    hubConn
 	ready   chan struct{} // while it is being connected to
 	err     error         // why the last connection failed
+	slow    bool          // the last start ran out of its step's budget, so it may answer next time
