@@ -0,0 +1,18 @@
+package gateway
+
+import (
+	"net/http"
+	"time"
+)
+
+// quotaRecheck bounds only a Codex client's next look at routing, without
+// changing the account/key cooldowns chosen from the original headers. A
+// long Retry-After otherwise leaves Codex asleep after a fresh allowance
+// reading has already brought an account back (#2526). It neither renews
+// an allowance nor changes Codex's retry budget or a terminal error.
+// Call only for a quota refusal, never for a rate limit or credit failure.
+func quotaRecheck(h http.Header) {
+	if h.Get("Retry-After") != "" && retryAfter(h, time.Now()) > time.Minute {
+		h.Set("Retry-After", "60")
+	}
+}
diff --git a/internal/gateway/codex_quota_recheck_test.go b/internal/gateway/codex_quota_recheck_test.go
