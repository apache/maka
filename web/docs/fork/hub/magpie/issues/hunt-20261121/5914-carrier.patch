new file mode 100644
index 000000000..a74ec1797
--- /dev/null
+++ b/internal/filelock/strict.go
@@ -0,0 +1,167 @@
+package filelock
+
+import (
+	"fmt"
+	"io"
+	"log"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Strict is a Mutex that never goes on without the file's lock: a
+// change to a file the user's own settings are in is better not made at
+// all than made over another magpie's. Take waits for another magpie to
+// let go, tries once more, and then answers BusyError, for the change to
+// be refused and the user asked to make it again. On a file system with
+// no locks at all it goes on without one, as Mutex does: nothing could
+// ever be changed there otherwise. A lock file that can't be opened is
+// not such a system (too many files open, one another user made): it is
+// tried once more and the change refused with the open's error, which a
+// caller tells apart as it would the file's own (a folder not the user's).
+//
+// The lock is the system's own (flock, LockFileEx), on the open file: it
+// is let go when the process holding it ends, however it ends, so a magpie
+// that crashed or was killed never keeps another from it. The holder's pid
+// is written in the lock file while it is held, to say who held it; one
+// left there by a magpie that ended holding it is cleared as the next one
+// starts (Clear).
+type Strict struct {
+	mu sync.Mutex
+	// Path is the lock file: the file guarded, with ".lock".
+	Path func() string
+	// Locked, when set, is called once both locks are held: to have the
+	// file guarded read afresh.
+	Locked func()
+	// wait is how long each of the two tries waits for another magpie;
+	// 0 is half of Wait, so both together wait as long as Mutex does.
+	wait time.Duration
+	f    *os.File
+}
+
+// SetWait sets how long each of the two tries waits.
+func (s *Strict) SetWait(d time.Duration) {
+	s.mu.Lock()
+	s.wait = d
+	s.mu.Unlock()
+}
+
+// BusyError is a change refused because another magpie held the file's
+// lock through a try and the one after it. The change wasn't made.
+type BusyError struct {
+	// Path is the lock file; Pid the magpie said to hold it, 0 unknown.
+	Path string
+	Pid  int
+}
+
+func (e *BusyError) Error() string {
+	return "another magpie is changing " + e.File() + " right now, so this change wasn't saved: try again in a moment"
+}
+
+// File is the name of the file guarded, as the user knows it.
+func (e *BusyError) File() string { return strings.TrimSuffix(filepath.Base(e.Path), ".lock") }
+
+// Take takes the lock, or answers *BusyError with neither lock held.
+func (s *Strict) Take() error {
+	s.mu.Lock()
+	path := s.Path()
+	wait := s.wait
+	if wait <= 0 {
+		wait = Wait / 2
+	}
+	f, got, err := take(path, wait)
+	switch got {
+	case timedOut:
+		log.Printf("%s: another magpie%s held it for %v; trying once more", path, pidSaid(holder(path)), wait)
+		f, got, err = take(path, wait)
+	case openFailed:
+		log.Printf("%s: %v; trying once more", path, err)
+		time.Sleep(100 * time.Millisecond) // no other magpie to wait for
+		f, got, err = take(path, wait)
+	}
+	switch got {
+	case openFailed:
+		s.mu.Unlock()
+		log.Printf("%s: %v, a try and one more; the change wasn't saved", path, err)
+		return fmt.Errorf("this change wasn't saved: %w", err)
+	case timedOut:
+		s.mu.Unlock()
+		e := &BusyError{Path: path, Pid: holder(path)}
+		log.Printf("%s: another magpie%s held it through a try and one more; the change wasn't saved", path, pidSaid(e.Pid))
+		return e
+	case taken:
+		s.f = f
+		// who holds it, for another magpie to say: only ever said, so a
+		// write that fails costs nothing but the name
+		f.Truncate(0)
+		f.WriteAt([]byte(strconv.Itoa(os.Getpid())+"\n"), 0)
+	}
+	if s.Locked != nil {
+		s.Locked()
+	}
+	return nil
+}
+
+// Unlock lets go of what Take took.
+func (s *Strict) Unlock() {
+	if f := s.f; f != nil {
+		s.f = nil
+		f.Truncate(0) // held by no one now
+		Unlock(f)
+		f.Close()
+	}
+	s.mu.Unlock()
+}
+
+// Clear looks at the lock file at path as a magpie starts, and clears
+// what a magpie that ended while holding it left there: the pid it wrote.
+// The lock itself went with that magpie (the system lets go of it); the
+// file is kept, as Lock says why. Held now, it is another magpie's that is
+// running, and left alone. left is the pid cleared, -1 for a record that
+// says none, 0 for nothing cleared.
+func Clear(path string) (left int) {
+	f, err := os.OpenFile(path, os.O_RDWR, 0)
+	if err != nil {
+		return 0 // none there, or not to be opened: nothing left in it either
+	}
+	defer f.Close()
+	if ok, err := TryLock(f); err != nil || !ok {
+		return 0
+	}
+	defer Unlock(f)
+	b, err := io.ReadAll(f)
+	if err != nil || len(b) == 0 {
+		return 0
+	}
+	if f.Truncate(0) != nil {
+		return 0
+	}
+	left = -1
+	if pid, err := strconv.Atoi(strings.TrimSpace(string(b))); err == nil && pid > 0 {
+		left = pid
+	}
+	// nothing logged: magpie's log isn't open yet as it starts, and a
+	// terminal's command isn't to print it
+	return left
+}
+
+// holder is the pid written in the lock file at path, 0 when it can't be
+// read: on Windows another process's lock keeps the file from being read.
+func holder(path string) int {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return 0
+	}
+	pid, _ := strconv.Atoi(strings.TrimSpace(string(b)))
+	return pid
+}
+
+func pidSaid(pid int) string {
+	if pid <= 0 {
+		return ""
+	}
+	return " (pid " + strconv.Itoa(pid) + ")"
+}
diff --git a/internal/filelock/strict_test.go b/internal/filelock/strict_test.go
new file mode 100644
index 000000000..75991e278
--- /dev/null
+++ b/internal/filelock/strict_test.go
@@ -0,0 +1,142 @@
+package filelock
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"testing"
+	"time"
+)
+
+// TestStrictHolder is the other magpie of TestStrictAcrossProcesses: it
+// takes a Strict, says so, and holds it until its stdin is closed or it is
+// killed.
+func TestStrictHolder(t *testing.T) {
+	path := os.Getenv("MAGPIE_FILELOCK_STRICT")
+	if path == "" {
+		t.Skip("run by TestStrictAcrossProcesses")
+	}
+	s := Strict{Path: func() string { return path }}
+	if err := s.Take(); err != nil {
+		t.Fatal(err)
+	}
+	os.Stdout.WriteString("locked\n")
+	io.Copy(io.Discard, os.Stdin)
+}
+
+// A Strict held by another magpie is waited for, tried once more,
+// then refused with BusyError naming it; the magpie killed, Clear clears
+// the pid it left and the lock is taken again.
+func TestStrictAcrossProcesses(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "f.json.lock")
+	holder := exec.Command(os.Args[0], "-test.run=^TestStrictHolder$", "-test.count=1")
+	holder.Env = append(os.Environ(), "MAGPIE_FILELOCK_STRICT="+path)
+	in, _ := holder.StdinPipe()
+	out, _ := holder.StdoutPipe()
+	if err := holder.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { in.Close(); holder.Process.Kill(); holder.Wait() })
+	if line, _ := bufio.NewReader(out).ReadString('\n'); line != "locked\n" {
+		t.Fatalf("the other magpie: %q", line)
+	}
+
+	s := Strict{Path: func() string { return path }}
+	s.SetWait(200 * time.Millisecond)
+	start := time.Now()
+	err := s.Take()
+	var busy *BusyError
+	if !errors.As(err, &busy) {
+		s.Unlock()
+		t.Fatalf("taken while another magpie held it: %v", err)
+	}
+	if took := time.Since(start); took < 400*time.Millisecond {
+		t.Errorf("refused after %v: not after a try and one more", took)
+	}
+	// on Windows the holder's lock keeps its pid from being read
+	if (busy.Pid != holder.Process.Pid && !(runtime.GOOS == "windows" && busy.Pid == 0)) || busy.File() != "f.json" {
+		t.Errorf("said %q held by %d, want f.json by %d", busy.File(), busy.Pid, holder.Process.Pid)
+	}
+	// refused, it holds nothing: the next Take isn't kept on its mutex
+	done := make(chan error, 1)
+	go func() { done <- s.Take() }()
+	select {
+	case err := <-done:
+		if !errors.As(err, &busy) {
+			t.Fatalf("second take: %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("a refused Take kept its mutex")
+	}
+
+	// in Clear, a lock held by a magpie still running is left alone
+	if left := Clear(path); left != 0 {
+		t.Fatalf("cleared %d while its magpie ran", left)
+	}
+	holder.Process.Kill()
+	holder.Wait()
+	// the system lets go of a killed process's lock at once on Unix, and
+	// soon after on Windows
+	left := Clear(path)
+	for deadline := time.Now().Add(5 * time.Second); left == 0 && time.Now().Before(deadline); left = Clear(path) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if left != holder.Process.Pid {
+		t.Fatalf("cleared %d, want the killed magpie's %d", left, holder.Process.Pid)
+	}
+	if b, _ := os.ReadFile(path); len(b) != 0 {
+		t.Fatalf("left in the lock file: %q", b)
+	}
+	if left := Clear(path); left != 0 {
+		t.Fatalf("cleared %d from a lock file left empty", left)
+	}
+	if left := Clear(filepath.Join(t.TempDir(), "none.lock")); left != 0 {
+		t.Fatalf("cleared %d from no file", left)
+	}
+
+	if err := s.Take(); err != nil {
+		t.Fatalf("not taken once the other magpie ended: %v", err)
+	}
+	if b, _ := os.ReadFile(path); string(b) != strconv.Itoa(os.Getpid())+"\n" {
+		t.Errorf("held, the lock file says %q", b)
+	}
+	s.Unlock()
+	if b, _ := os.ReadFile(path); len(b) != 0 {
+		t.Errorf("let go, the lock file says %q", b)
+	}
+}
+
+// A lock file that can't be opened is no file system without locks: the
+// change is tried once more and refused, never made without the lock.
+func TestStrictRefusesALockFileItCantOpen(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("a folder's permissions are ACLs there")
+	}
+	dir := filepath.Join(t.TempDir(), "locked")
+	if err := os.Mkdir(dir, 0o500); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Chmod(dir, 0o700) })
+	if f, err := os.Create(filepath.Join(dir, "probe")); err == nil {
+		f.Close()
+		t.Skip("this user writes into a folder it can't write to (root)")
+	}
+	s := Strict{Path: func() string { return filepath.Join(dir, "f.json.lock") }}
+	s.SetWait(50 * time.Millisecond)
+	err := s.Take()
+	if err == nil {
+		s.Unlock()
+	}
+	// the open's own error, for a caller to tell a folder not the user's
+	if !errors.Is(err, fs.ErrPermission) {
+		t.Fatalf("a lock file that can't be opened answered %v", err)
+	}
+	// refused, it holds nothing: this would wait on its mutex
+	s.SetWait(50 * time.Millisecond)
+}
