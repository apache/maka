diff --git a/internal/provider/edit.go b/internal/provider/edit.go
new file mode 100644
index 000000000..3dfcb2ee6
--- /dev/null
+++ b/internal/provider/edit.go
@@ -0,0 +1,197 @@
+package provider
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// Edit changes the provider id as change changes it and saves it, checked
+// and normalized as Save saves it, but writes only what change changed onto
+// the record providers.json has when its lock is taken: a command
+// or a TUI key that sets a setting or a few, so that what was written since
+// the provider was read (another setting set from the GUI or another
+// magpie, an account's day noted, a key added) stays, as Save of the
+// provider read would write it over. A provider removed meanwhile isn't
+// made again. It answers the provider as read and as changed.
+//
+// What is written is field by field: a field the change changed is
+// written whole, a map or list too (its headers, its windows), so only
+// another change to that same field made meanwhile is written over.
+func Edit(id string, change func(p *Provider) error) (was, now Provider, err error) {
+	p, err := Find(id)
+	if err != nil {
+		return Provider{}, Provider{}, err
+	}
+	was, now = p.clone(), p.clone()
+	if err := change(&now); err != nil {
+		return was, now, err
+	}
+	return was, now, saveEdit(was, now)
+}
+
+// keptStored are the fields magpie keeps of a provider, never one a change
+// sets: as the record has them, the picks' list worked out again as Save
+// works it out when the picks changed.
+var keptStored = []string{"pickedFrom", "delisted", "delistedAt", "accountAdded", "was", "gave"}
+
+// pickFields are those whose change has the picks' list worked out again.
+var pickFields = []string{"models", "noModels", "bestInFamily"}
+
+// saveEdit saves p, read as was, writing only the fields of it Save would
+// write otherwise than was's.
+func saveEdit(was, p Provider) error {
+	next, account, err := prepare(p)
+	if err != nil {
+		return err
+	}
+	base, _, err := prepare(was)
+	if err != nil {
+		// the provider read is one Save refuses (put in by hand, a key
+		// gone): what was changed can't be told, so it is saved whole, as
+		// it was before
+		return Save(p)
+	}
+	changed, err := storedChanges(base, next)
+	if err != nil || len(changed) == 0 {
+		return err
+	}
+	var now *listing
+	picks := slices.ContainsFunc(pickFields, func(k string) bool { return changed[k] })
+	if picks && len(next.Models) > 0 { // listedWith asks it only of picks
+		now = listedNow(next) // the accounts are read before the lock
+	}
+	wrote := false
+	err = editRecord(next.ID, account, func(q *Provider) (bool, error) {
+		cur := *q
+		if !account {
+			// as Find reads it and Save writes it
+			cur = normalize(cur)
+			cur.AccountProxies = keyProxies(cur)
+		}
+		before, err := json.Marshal(cur)
+		if err != nil {
+			return false, err
+		}
+		merged, err := withChanges(cur, next, changed)
+		if err != nil {
+			return false, err
+		}
+		if !account {
+			merged.AccountProxies = keyProxies(merged)
+			// what Save checks of one field against another, on the
+			// record as it is now: another change meanwhile can have
+			// changed the other (a preset given, Vertex AI picked)
+			if err := checkMerged(&merged); err != nil {
+				return false, err
+			}
+		}
+		if picks {
+			merged.PickedFrom, _ = listedWith(merged, &cur, account, now)
+			merged.Delisted = delistedWith(merged, &cur)
+			merged.DelistedAt = delistedAtWith(merged, &cur)
+		}
+		after, err := json.Marshal(merged)
+		if err != nil || bytes.Equal(before, after) {
+			return false, err
+		}
+		*q = merged
+		wrote = true
+		return true, nil
+	})
+	if err == nil && wrote && next.ID == "claude" {
+		syncClaudeProxyEnvNow() // as Save does (#1807)
+	}
+	return err
+}
+
+// checkMerged refuses p as Save would for what one field of it says of
+// another, and drops a picture's source from an icon that isn't one, as
+// Save does; nothing it checks reads the accounts, so it is made under
+// providersMu.
+func checkMerged(p *Provider) error {
+	// as Save refuses them: a key of Vertex AI's own, or a base URL with
+	// no key (Google credentials are sent only to Google's own address)
+	if p.IsVertex() && len(p.Keys) > 0 {
+		return errors.New("Google Vertex AI takes one API key")
+	}
+	if p.IsVertex() && p.Vertex != nil && strings.TrimSpace(p.Vertex.BaseURL) != "" && strings.TrimSpace(p.Key) == "" {
+		return errors.New("a base URL is for an API key: Google credentials are sent only to Google's own address")
+	}
+	if p.InsecureTLS && !p.TakesInsecureTLS() {
+		return fmt.Errorf("%s is a preset's: only a provider you added with your own base URL can skip the certificate check", p.Name)
+	}
+	if !strings.HasPrefix(p.Icon, iconPrefix) {
+		p.IconFrom = ""
+	}
+	return nil
+}
+
+// storedChanges are the fields of providers.json's record a and b are
+// written with otherwise, but those magpie keeps (keptStored).
+func storedChanges(a, b Provider) (map[string]bool, error) {
+	x, err := fields(a)
+	if err != nil {
+		return nil, err
+	}
+	y, err := fields(b)
+	if err != nil {
+		return nil, err
+	}
+	changed := map[string]bool{}
+	for k, v := range x {
+		if !bytes.Equal(v, y[k]) {
+			changed[k] = true
+		}
+	}
+	for k := range y {
+		if _, ok := x[k]; !ok {
+			changed[k] = true
+		}
+	}
+	for _, k := range keptStored {
+		delete(changed, k)
+	}
+	return changed, nil
+}
+
+// withChanges is cur with the fields changed as next has them: one next
+// leaves out (cleared) left out too.
+func withChanges(cur, next Provider, changed map[string]bool) (Provider, error) {
+	m, err := fields(cur)
+	if err != nil {
+		return Provider{}, err
+	}
+	n, err := fields(next)
+	if err != nil {
+		return Provider{}, err
+	}
+	for k := range changed {
+		if v, ok := n[k]; ok {
+			m[k] = v
+		} else {
+			delete(m, k)
+		}
+	}
+	b, err := json.Marshal(m)
+	if err != nil {
+		return Provider{}, err
+	}
+	var out Provider
+	err = json.Unmarshal(b, &out)
+	return out, err
+}
+
+// fields are p's fields as providers.json has them, by name.
+func fields(p Provider) (map[string]json.RawMessage, error) {
+	b, err := json.Marshal(p)
+	if err != nil {
+		return nil, err
+	}
+	var m map[string]json.RawMessage
+	err = json.Unmarshal(b, &m)
+	return m, err
+}
diff --git a/internal/provider/edit_test.go b/internal/provider/edit_test.go
new file mode 100644
index 000000000..d57bafe54
--- /dev/null
+++ b/internal/provider/edit_test.go
@@ -0,0 +1,218 @@
+package provider
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/filelock"
+)
+
+// Edit, what a command or a TUI key changes a provider with, writes
+// only what its change changed onto providers.json as it is when written:
+// a setting set between its read of the provider and its write stays.
+
+func editRelay(t *testing.T) {
+	t.Helper()
+	providersLockHome(t)
+	if err := Save(Provider{ID: "relay", Name: "Relay", Chat: "https://relay.test/v1", Key: "sk-personal-1111", Models: []string{"a", "b"}}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// A provider of the user's own: Unlisted, a fallback, a key and its picks
+// changed while its queue, its limit a minute and a key's weight are set.
+func TestEditKeepsWhatWasSetMeanwhile(t *testing.T) {
+	editRelay(t)
+	_, now, err := Edit("relay", func(p *Provider) error {
+		// meanwhile: the GUI, or another magpie
+		if err := SetQueue("relay", 5, 60); err != nil {
+			t.Fatal(err)
+		}
+		if err := SetKeyWeight("relay", keyID("sk-personal-1111"), 4); err != nil {
+			t.Fatal(err)
+		}
+		p.Unlisted = true
+		p.Fallback = []string{"relay/a"}
+		p.Models = []string{"b"}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !now.Unlisted || len(now.Fallback) != 1 {
+		t.Fatalf("Edit answered %+v", now)
+	}
+	s, _ := storedPicks("relay")
+	if !s.Unlisted || !slices.Equal(s.Fallback, []string{"relay/a"}) || !slices.Equal(s.Models, []string{"b"}) {
+		t.Errorf("the change wasn't written: unlisted %v fallback %v models %v", s.Unlisted, s.Fallback, s.Models)
+	}
+	if s.QueueLimit != 5 || s.QueueWait != 60 {
+		t.Errorf("the queue set meanwhile was written over: %d, %ds", s.QueueLimit, s.QueueWait)
+	}
+	if p, _ := Find("relay"); p.KeyWeight != 4 {
+		t.Errorf("the key's weight set meanwhile was written over: %d", p.KeyWeight)
+	}
+}
+
+// A subscription's own settings, changed as an account's name and another's
+// cap are given: all stay.
+func TestEditOfAnAccountKeepsWhatWasSetMeanwhile(t *testing.T) {
+	providersLockHome(t)
+	if _, _, err := Edit("codex", func(p *Provider) error {
+		if err := SetAccountName("codex", "new@example.com", "Work"); err != nil {
+			t.Fatal(err)
+		}
+		if err := SetAccountCap("codex", "me@example.com", 70); err != nil {
+			t.Fatal(err)
+		}
+		p.Unlisted = true
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	s, _ := storedPicks("codex")
+	if !s.Unlisted {
+		t.Error("Unlisted wasn't written")
+	}
+	if s.AccountNames["new@example.com"] != "Work" {
+		t.Errorf("the name given meanwhile was written over: %+v", s.AccountNames)
+	}
+	if s, _ := AccountCapsOf("codex", "me@example.com").Of("5 hours"); s != 70 {
+		t.Errorf("the cap set meanwhile was written over: %d%%", s)
+	}
+}
+
+// A change Save refuses is refused, and one to a provider removed meanwhile
+// doesn't make it again: providers.json byte for byte as it was.
+func TestEditRefusedWritesNothing(t *testing.T) {
+	editRelay(t)
+	file := filepath.Join(appdir.Config(), "providers.json")
+	was, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := Edit("relay", func(p *Provider) error {
+		p.Chat = ""
+		return nil
+	}); err == nil || !strings.Contains(err.Error(), "base URL") {
+		t.Fatalf("a provider left with no base URL: %v", err)
+	}
+	if now, _ := os.ReadFile(file); !bytes.Equal(was, now) {
+		t.Fatalf("a refused change wrote providers.json:\n%s", now)
+	}
+	if _, _, err := Edit("relay", func(p *Provider) error {
+		if err := Delete("relay"); err != nil {
+			t.Fatal(err)
+		}
+		p.Unlisted = true
+		return nil
+	}); err == nil || !strings.Contains(err.Error(), "removed meanwhile") {
+		t.Fatalf("a change to a provider removed meanwhile: %v", err)
+	}
+	if _, ok := storedPicks("relay"); ok {
+		t.Fatal("a provider removed meanwhile was made again")
+	}
+}
+
+// A change that changes nothing writes nothing, and a field cleared is
+// cleared.
+func TestEditClearsAndLeavesAlone(t *testing.T) {
+	editRelay(t)
+	if _, _, err := Edit("relay", func(p *Provider) error { p.Fallback = []string{"relay/a"}; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(appdir.Config(), "providers.json")
+	st, err := os.Stat(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	was, _ := os.ReadFile(file)
+	if _, _, err := Edit("relay", func(p *Provider) error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if now, _ := os.ReadFile(file); !bytes.Equal(was, now) {
+		t.Fatal("a change of nothing rewrote providers.json")
+	}
+	if st2, _ := os.Stat(file); !st2.ModTime().Equal(st.ModTime()) {
+		t.Fatal("a change of nothing wrote providers.json")
+	}
+	if _, _, err := Edit("relay", func(p *Provider) error { p.Fallback = nil; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if s, _ := storedPicks("relay"); len(s.Fallback) != 0 {
+		t.Fatalf("the fallback cleared stayed: %v", s.Fallback)
+	}
+}
+
+// The picks changed by Edit are saved with the list they were picked from,
+// as Save saves them.
+func TestEditPicksAsSaveDoes(t *testing.T) {
+	editRelay(t)
+	if _, _, err := Edit("relay", func(p *Provider) error { p.Models = []string{"b"}; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	byEdit, _ := storedPicks("relay")
+	p, err := Find("relay")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.Models = []string{"a"}
+	if err := Save(*p); err != nil {
+		t.Fatal(err)
+	}
+	p.Models = []string{"b"}
+	if err := Save(*p); err != nil {
+		t.Fatal(err)
+	}
+	bySave, _ := storedPicks("relay")
+	if !slices.Equal(byEdit.PickedFrom, bySave.PickedFrom) || !slices.Equal(byEdit.Delisted, bySave.Delisted) {
+		t.Fatalf("Edit saved the picks from %v (set aside %v), Save from %v (%v)", byEdit.PickedFrom, byEdit.Delisted, bySave.PickedFrom, bySave.Delisted)
+	}
+}
+
+// What Save checks of one field against another is checked on the record
+// as it is when written: a certificate check skipped on a provider made a
+// preset's meanwhile is refused, nothing written.
+func TestEditChecksTheRecordAsItIsThen(t *testing.T) {
+	editRelay(t)
+	_, _, err := Edit("relay", func(p *Provider) error {
+		if err := editStored("relay", func(q *Provider) bool { q.Preset = "openai"; return true }); err != nil {
+			t.Fatal(err)
+		}
+		p.InsecureTLS = true
+		return nil
+	})
+	if err == nil || !strings.Contains(err.Error(), "certificate check") {
+		t.Fatalf("a certificate check skipped on a preset's provider: %v", err)
+	}
+	if s, _ := storedPicks("relay"); s.InsecureTLS {
+		t.Fatal("the refused change was written")
+	}
+}
+
+// while another magpie holds providers.json, Edit is
+// refused with BusyError and providers.json is as it was.
+func TestEditRefusedWhileAnotherMagpieHolds(t *testing.T) {
+	editRelay(t)
+	before, err := os.ReadFile(Path())
+	if err != nil {
+		t.Fatal(err)
+	}
+	shortWait(t, 200*time.Millisecond)
+	holdProviders(t)
+	_, _, err = Edit("relay", func(p *Provider) error { p.Unlisted = true; return nil })
+	var busy *filelock.BusyError
+	if !errors.As(err, &busy) || !strings.Contains(err.Error(), "another magpie is changing providers.json") {
+		t.Fatalf("an edit while another magpie held providers.json answered %v", err)
+	}
+	if now, _ := os.ReadFile(Path()); !bytes.Equal(before, now) {
+		t.Fatalf("a refused edit wrote providers.json:\n%s", now)
+	}
+}
