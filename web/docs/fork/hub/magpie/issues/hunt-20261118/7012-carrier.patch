@@ -139,10 +170,23 @@ func (rw *Writer) Write(p []byte) (int, error) {
 		if err := rw.event(ev); err != nil {
 			return len(p), err
 		}
+		// the held comment rides after the frame its line closed
+		if rw.heldComment != nil {
+			if _, err := rw.w.Write(rw.heldComment); err != nil {
