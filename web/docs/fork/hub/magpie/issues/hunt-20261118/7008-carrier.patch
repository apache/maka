@@ -286,13 +288,52 @@ func sharedLogins() []savedLogin {
 		if b, ferr := lastgood.Fallback(loginsPath(), unreadBytes(loginsPath()), validLogins); ferr == nil {
 			ls, _ = parseLogins(b)
 			lastLogins, loginsKnown = ls, true
+			loginsReadOkay()
