+	}
+	if k, _ := edit.GetEnvFile(filepath.Join(home, ".qwen", ".env"), "MAGPIE_QWEN_API_KEY"); k != "" {
+		t.Fatalf("key left in .env")
+	}
+	if got := a.Values()["model"]; got != "idealab/glm-5" {
+		t.Fatalf("reset model: %q", got)
+	}
