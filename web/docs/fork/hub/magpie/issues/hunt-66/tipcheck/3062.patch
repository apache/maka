+func TestRelayUnreadableItemKeepsOtherInput(t *testing.T) {
+	body := []byte(`{"model":"gpt-5.4","input":[` + bareConversation + `]}`)
+	msg := []byte(`{"error":{"message":"OpenCode Go: Referenced reasoning item 'rs_18dbe693b3dce4800000003c' was not found or has expired.","type":"invalid_request_error"}}`)
