+			return nil, fmt.Errorf("%s has no valid SKILL.md", e.Name())
+		}
+		out = append(out, Candidate{Path: e.Name(), Name: nameFor(e.Name(), m), Description: m.Description})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	return out, nil
+}
