+		if r.Header.Get("Authorization") != "" || r.Header.Get("Cookie") != "" {
+			t.Error("a public skill download carried credentials")
+		}
+		mu.RLock()
+		body, ok := initial[r.URL.Path]
+		mu.RUnlock()
+		if !ok {
+			http.NotFound(w, r)
+			return
+		}
+		if strings.HasSuffix(r.URL.Path, ".json") {
