---
 internal/gateway/search.go          | 22 ++++++++++----
 internal/gateway/small_kept_test.go | 47 +++++++++++++++++++++++++++++
 2 files changed, 63 insertions(+), 6 deletions(-)

diff --git a/internal/gateway/search.go b/internal/gateway/search.go
index 5747aa199..6cc15961b 100644
--- a/internal/gateway/search.go
+++ b/internal/gateway/search.go
@@ -560,18 +560,28 @@ type smallCand struct {
 }
 
 // smallCands is the provider's models smallModel picks among, of those
-// keep holds, in the order it picks them (rankSmall).
+// keep holds, in the order it picks them (rankSmall). What the user said
+// of a model named in full (ImageOverride) is their word that the ID is
+// the vendor's own, not one of the shapes guessed at below: their model
+// stays in the pool though its ID carries a namespace colon (a relay's
+// cn:deepseek-v4.1-flash, #4359) or one of the words, and keep has said
+// whether it sees. An ID that starts a group, a found group or, on a
+// subscription, what magpie wrote into its agent, is magpie's own shape
+// whatever the user said of it, and stays out.
 func smallCands(p provider.Provider, keep func(catalog.Model) bool) []smallCand {
 	var ms []catalog.Model
+	s := settings.Shared()
 	for _, m := range p.Exposed() {
 		if keep != nil && !keep(m) {
 			continue
 		}
-		l := strings.ToLower(m.ID)
-		// a subscription's list can have what magpie wrote into its agent
-		if strings.HasPrefix(m.ID, provider.GroupPrefix) || strings.HasPrefix(m.ID, provider.AutoPrefix) || (p.Account != nil && strings.Contains(m.ID, "/")) ||
-			strings.ContainsAny(l, ":~") || slices.ContainsFunc([]string{"nano", "lite", "image", "audio", "tts", "embed", "free"}, func(w string) bool { return strings.Contains(l, w) }) {
-			continue
+		if _, said := provider.ImageOverrideIn(s, p.ID, m.ID); !said {
+			l := strings.ToLower(m.ID)
+			// a subscription's list can have what magpie wrote into its agent
+			if strings.HasPrefix(m.ID, provider.GroupPrefix) || strings.HasPrefix(m.ID, provider.AutoPrefix) || (p.Account != nil && strings.Contains(m.ID, "/")) ||
+				strings.ContainsAny(l, ":~") || slices.ContainsFunc([]string{"nano", "lite", "image", "audio", "tts", "embed", "free"}, func(w string) bool { return strings.Contains(l, w) }) {
+				continue
+			}
 		}
 		ms = append(ms, m)
 	}
diff --git a/internal/gateway/small_kept_test.go b/internal/gateway/small_kept_test.go
index 1f276fb1c..fdc7a957a 100644
--- a/internal/gateway/small_kept_test.go
+++ b/internal/gateway/small_kept_test.go
@@ -177,6 +177,53 @@ func TestAutoVisionKeptListsAskAllowanceEachTime(t *testing.T) {
 	}
 }
 
+// A relay's model IDs can carry a namespace colon, cn:deepseek-v4.1-flash
+// and the like (#4359). The pool the small models are picked from leaves
+// IDs with a colon out, as magpie's own effort-suffixed ones have one;
+// the user's answer about a model named in full is about one of the
+// vendor's models, not one of magpie's shapes: their "it takes images"
+// keeps it in the pool, for AutoVision to pick, and their "it takes
+// none" keeps it out. Without an answer of theirs, it stays out as it
+// was.
+func TestAutoVisionPicksANamespacedIDTheUserSaidSees(t *testing.T) {
+	fresh(t)
+	if err := provider.Save(provider.Provider{ID: "relay", Name: "Relay", Chat: "http://relay.invalid/v1", Key: "k",
+		Models: []string{"cn:deepseek-v4.1-flash", "cn:glm-5v-turbo"}}); err != nil {
+		t.Fatal(err)
+	}
+	// the vendor's list, as a relay's is, says nothing of images
+	if err := catalog.SaveLive("relay", "http://relay.invalid/v1", []catalog.Model{
+		{ID: "cn:deepseek-v4.1-flash", Price: &catalog.Price{Input: 0.1, Output: 0.1}},
+		{ID: "cn:glm-5v-turbo", Price: &catalog.Price{Input: 0.2, Output: 0.2}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if m := AutoVision(); m != "" {
+		t.Fatalf("AutoVision = %q though no model of the relay is known to see and the user said nothing", m)
+	}
+
+	// the user marks the relay's models as taking images (#4359's
+	// settings.json): the one with flash in its ID is picked
+	st := settings.Load()
+	st.ModelImages = map[string]bool{"relay/cn:deepseek-v4.1-flash": true, "relay/cn:glm-5v-turbo": true}
+	if err := settings.Save(st); err != nil {
+		t.Fatal(err)
+	}
+	if m := AutoVision(); m != "relay/cn:deepseek-v4.1-flash" {
+		t.Fatalf("AutoVision = %q, want relay/cn:deepseek-v4.1-flash, the model the user said sees", m)
+	}
+
+	// the user's "takes no images" keeps it out again
+	st = settings.Load()
+	st.ModelImages = map[string]bool{"relay/cn:deepseek-v4.1-flash": false}
+	if err := settings.Save(st); err != nil {
+		t.Fatal(err)
+	}
+	if m := AutoVision(); m != "" {
+		t.Fatalf("AutoVision = %q, a model the user said takes no images", m)
+	}
+}
+
 // rankSmall's order is pickSmall's pick of every subset, as pickSmall
 // was before the ranking: the first of a subset is its pick.
 func TestRankSmallIsPickSmall(t *testing.T) {
