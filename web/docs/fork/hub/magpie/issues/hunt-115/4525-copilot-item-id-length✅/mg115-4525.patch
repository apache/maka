+func checkBoundSent(t *testing.T, input []map[string]any) {
+	t.Helper()
+	var types []string
+	for _, it := range input {
+		types = append(types, it["type"].(string))
+		id, _ := it["id"].(string)
+		if id == "" {
+			continue
+		}
+		if len(id) > 64 {
