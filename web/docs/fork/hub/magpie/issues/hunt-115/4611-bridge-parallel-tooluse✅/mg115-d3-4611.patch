diff --git a/internal/gateway/claude_subscription.go b/internal/gateway/claude_subscription.go
index 63b7888e5..41732b421 100644
--- a/internal/gateway/claude_subscription.go
+++ b/internal/gateway/claude_subscription.go
@@ -3042,9 +3042,13 @@ func (r *subscriptionRun) readOutput(rd io.Reader) {
 	// its MCP calls one at a time), and the message written later is left
 	// out, its usage told with the next reply's. That message is the first
 	// written after such a call: Claude Code writes no other before it.
+	// Calls of one message may now come in side by side (#4611), and a
+	// second one before its input is written: such a call is held back and
+	// told by the message itself, which carries its input whole.
 	told := map[string]bool{}    // the client's calls it was shown
 	awaited := map[string]bool{} // calls told by themselves, their message not written yet
 	written := map[string]bool{} // calls in a message left out, not made yet
+	unheard := map[string]bool{} // calls held back: no reply to tell them in, or their input not written yet
 	lateID := ""                 // the message left out
 	over := false                // the output has ended
 	if r.tui {
@@ -3060,7 +3064,13 @@ func (r *subscriptionRun) readOutput(rd io.Reader) {
 				r.mu.Lock()
 				waits := r.segment != nil && r.pending[id] != nil
 				r.mu.Unlock()
-				if !waits {
+				if !waits || len(args) == 0 || string(args) == "null" {
+					// A call the client is not hearing now, or one with no
+					// arguments to run (#4611: Claude Code calls a second
+					// tool while its input is still being streamed), would
+					// reach the client broken. The message written after it
+					// carries its input whole: it tells the call from there.
+					unheard[id] = true
 					return
 				}
 				begin("msg_"+strings.ReplaceAll(newUUID(), "-", ""), r.model, cliUsage{})
@@ -3310,17 +3320,24 @@ func (r *subscriptionRun) readOutput(rd io.Reader) {
 			if !next {
 				return
 			}
+			anyUnheard := false
+			for _, c := range whole.Content {
+				if c.Type == "tool_use" && unheard[c.ID] {
+					anyUnheard = true
+					break
+				}
+			}
 			if whole.ID != lateID && whole.ID != unstreamed {
 				if lateID != "" && len(awaited) > 0 {
 					log.Printf("claude: %d calls told by themselves were not in the message written after them", len(awaited))
 					clear(awaited)
 				}
 				lateID = ""
-				if len(awaited) > 0 {
+				if len(awaited) > 0 && !anyUnheard {
 					lateID = whole.ID
 				}
 			}
-			if whole.ID == lateID {
+			if whole.ID == lateID && !anyUnheard {
 				lateUsage = whole.Usage
 				for _, c := range whole.Content {
 					if c.Type != "tool_use" {
@@ -3367,6 +3384,12 @@ func (r *subscriptionRun) readOutput(rd io.Reader) {
 				case "text":
 					said(c.Text)
 				case "tool_use":
+					delete(awaited, c.ID)
+					if told[c.ID] {
+						continue // its call told the client itself already
+					}
+					// a call held back (#4611) is told here, whole
+					delete(unheard, c.ID)
 					name, theirs := toolStart(index, c.Name)
 					if !theirs {
 						continue
diff --git a/internal/gateway/claude_tui_call_test.go b/internal/gateway/claude_tui_call_test.go
index db68ac692..fc3d2a8c2 100644
--- a/internal/gateway/claude_tui_call_test.go
+++ b/internal/gateway/claude_tui_call_test.go
@@ -59,13 +59,19 @@ func (c *tuiCalls) write(lines ...string) {
 }
 
 // call makes Claude Code's call of a client's tool; it returns once the
-// client's result is in.
+// client's result is in. args "" makes the call carry no arguments field
+// at all, as it does while its input is still being written (#4611).
 func (c *tuiCalls) call(id, args string) {
 	done := make(chan struct{})
 	c.called[id] = done
 	go func() {
 		defer close(done)
-		r := httptest.NewRequest("POST", "/", strings.NewReader(`{"tool_call_id":"`+id+`","name":"Read","arguments":`+args+`}`))
+		body := `{"tool_call_id":"` + id + `","name":"Read"`
+		if args != "" {
+			body += `,"arguments":` + args
+		}
+		body += `}`
+		r := httptest.NewRequest("POST", "/", strings.NewReader(body))
 		r.SetPathValue("token", "run")
 		c.bridge.mcpCall(httptest.NewRecorder(), r)
 	}()
@@ -254,6 +260,32 @@ func TestClaudeTUIParallelCallsBeforeTheirMessage(t *testing.T) {
 	}
 }
 
+// A message's second call may come in before its input is written: Claude
+// Code makes the calls of one message side by side, and the input of one
+// still being streamed is left out of the call it hands over (#4611). Told
+// as it came, it reaches the client with no arguments and fails; held, it
+// is told whole by the message written after it.
+func TestClaudeTUICallWithNoInputYetWaitsForItsMessage(t *testing.T) {
+	c := newTUICalls(t)
+	first := c.run.segment
+	c.call("toolu_a", `{"p":1}`)
+	if _, calls, _, _, raw := c.reply(first); len(calls) != 1 || calls[0] != `toolu_a{"p":1}` {
+		t.Fatalf("first reply %v:\n%s", calls, raw)
+	}
+	seg := c.answer("toolu_a")
+	c.call("toolu_b", "")     // its input not written yet: no arguments at all
+	time.Sleep(3 * callFirst) // the call's own turn to tell the client passes
+	c.write(
+		tuiRow("msg_late", tuiCall("toolu_a", 1), "tool_use", 40),
+		tuiRow("msg_late", tuiCall("toolu_b", 2), "tool_use", 40),
+	)
+	text, calls, stop, _, raw := c.reply(seg)
+	if text != "" || len(calls) != 1 || calls[0] != `toolu_b{"p":2}` || stop != "tool_use" {
+		t.Fatalf("second reply %q %v %q:\n%s", text, calls, stop, raw)
+	}
+	c.answer("toolu_b") // the result, once the client has run it
+}
+
 // se is a stream_event line, as the helper tells what its tap read.
 func se(event string) string { return `{"type":"stream_event","event":` + event + `}` }
 
