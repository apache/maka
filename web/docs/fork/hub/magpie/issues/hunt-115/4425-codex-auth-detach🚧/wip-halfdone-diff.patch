+// An explicit import takes the account over, Codex's own sign-in included
+// (#4425): the sign-in the file brings is refreshed into one only magpie
+// holds, kept in logins.json and renewed there, and nothing goes back into
+// Codex's auth.json — which `codex logout` empties, revoking the token it
+// held. Before, an import of a sign-in magpie held already was left as it
+// was, still sharing Codex's refresh token, and the account died with
+// `codex logout`.
+func TestImportCodexTakeOver(t *testing.T) {
+	home := claudeHome(t)
+	codexImportFake(t)
+
+	codexSignIn(t, home, "a@example.com", "r-a")
+	authPath := filepath.Join(home, ".codex", "auth.json")
+	rs, err := ImportLogins(context.Background(), "codex", []string{`{"type":"codex","refresh_token":"r-a","email":"a@example.com"}`})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if importStatuses(rs) != "a@example.com:updated" {
+		t.Fatalf("take-over: %s", importStatuses(rs))
+	}
+	// auth.json is Codex's still, its refresh token spent by the import
+	var a codexAuth
+	readJSON(authPath, &a)
+	if a.Tokens.RefreshToken != "r-a" {
+		t.Fatalf("auth.json changed: %s", a.Tokens.RefreshToken)
+	}
+	// magpie's copy is a sign-in of its own — the new token, in use
+	loginsMu.Lock()
+	ls := readLogins()
+	loginsMu.Unlock()
+	if len(ls) != 1 || json.Unmarshal(ls[0].Auth, &a) != nil || a.Tokens.RefreshToken != "n-a" || !ls[0].On {
+		t.Fatalf("kept %+v %+v", ls, a)
+	}
+
+	// `codex logout`: auth.json gone, the token it held revoked with it.
+	// The account keeps working, renewed from logins.json.
+	os.Remove(authPath)
+	tok, _, err := savedLoginToken(context.Background(), "codex", "a@example.com")
+	if err != nil || tok == "" {
+		t.Fatalf("after logout: tok %q, err %v", tok, err)
+	}
+}
+
+// An import made while Codex is signed out (a fresh CODEX_HOME's file,
+// say) keeps hands off Codex: before (#4425) the account was written into
+// auth.json as it was added — Codex signed back in — and a later
+// `codex logout` revoked the account's own sign-in with it.
+func TestImportCodexSignedOutAlone(t *testing.T) {
+	home := claudeHome(t)
+	codexImportFake(t)
+
+	rs, err := ImportLogins(context.Background(), "codex", []string{`{"type":"codex","refresh_token":"r-b","email":"b@example.com"}`})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if importStatuses(rs) != "b@example.com:added" {
+		t.Fatalf("added: %s", importStatuses(rs))
+	}
+	if _, err := os.Stat(filepath.Join(home, ".codex", "auth.json")); !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("auth.json written: %v", err)
+	}
+}
