 }
 
 func (f *fakeHub) On() bool { f.mu.Lock(); defer f.mu.Unlock(); return f.on }
 
-func (f *fakeHub) Tools(_ context.Context, agent string) []HubTool {
+func (f *fakeHub) Tools(ctx context.Context, agent string) []HubTool {
+	f.mu.Lock()
+	tf := f.toolsFunc
+	f.mu.Unlock()
