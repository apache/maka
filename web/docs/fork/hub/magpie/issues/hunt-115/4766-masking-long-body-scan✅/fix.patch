+
+// TestMaskLongSessionStaysFlat sits beside the benchmark above: masking a
+// turn of a long session must not read the body again for every value it
+// finds in it. What names a module an error could not load (missingModuleAt)
+// read everything before the quoted name and lowered it, once for each
+// place a known value turned up in the history, so a long session paid the
+// body's length again for every known value in it — a 555 KB turn held past
+// the unrouted budget and was answered 504 (#4766). The allocations say so:
+// each such place made a string of the whole text before it.
+func TestMaskLongSessionStaysFlat(t *testing.T) {
+	for _, s := range sessions {
+		t.Run(s.name, func(t *testing.T) {
+			Forget()
+			resetRuleMemo()
+			o := Options{Secrets: true, Personal: true, Route: "openai"}
+			const turns, kb = 60, 4
+			MaskJSON(s.body(turns, kb), o) // the turns before it, as the benchmark has them
+			body := s.body(turns+1, kb)
+			if n := testing.AllocsPerRun(3, func() { MaskJSON(body, o) }); n > 3000 {
+				t.Fatalf("masking one turn of a long %s session made %.0f allocations, 3000 at most: the body is being read again for each value in it", s.name, n)
+			}
+		})
+	}
+}
