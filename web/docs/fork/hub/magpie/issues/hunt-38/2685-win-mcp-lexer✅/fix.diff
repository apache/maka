diff --git a/internal/proc/nodever.go b/internal/proc/nodever.go
new file mode 100644
index 00000000..88be0954
--- /dev/null
+++ b/internal/proc/nodever.go
@@ -0,0 +1,114 @@
+package proc
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+// A Node version manager keeps one folder per version, and a terminal runs
+// the one it was told to use, not the one whose name sorts last. magpie
+// picked nvm's "newest-looking" folder by name, and in plain string order
+// v9.11.2 comes after v22.12.0: a codex, claude or gemini installed under a
+// Node the terminal doesn't use was found, run and updated in place of the
+// terminal's (found while answering 悠悠哥 on Discord, 9f407cafa). The
+// folders are taken in the order a terminal would reach them instead: the
+// manager's default first, then the highest version. fnm and mise lay this
+// out the same way on every system (nvm's, in nodever_other.go, is its
+// own), so their code is shared; only where the tool itself sits inside a
+// version's folder differs: fnm's is installation/bin on macOS and Linux,
+// installation alone (no bin inside) on Windows.
+
+// fnmBins are the bin folders of the Node versions fnm keeps in dir, the
+// default alias's (aliases/default, a link to the version's folder) first,
+// then the rest newest first. bin is where the tool itself sits inside a
+// version's folder: installation/bin on macOS and Linux, installation
+// alone on Windows.
+func fnmBins(dir, bin string) []string {
+	root := filepath.Join(dir, "node-versions")
+	var bins []string
+	for _, n := range nodeVersions(root, filepath.Join("installation", bin)) {
+		bins = append(bins, filepath.Join(root, n, "installation", bin))
+	}
+	if to, err := filepath.EvalSymlinks(filepath.Join(dir, "aliases", "default")); err == nil {
+		if real, err := filepath.EvalSymlinks(root); err == nil {
+			if rel, err := filepath.Rel(real, to); err == nil && !strings.HasPrefix(rel, "..") {
+				def := filepath.Join(root, rel, bin)
+				if isDir(def) {
+					bins = slices.DeleteFunc(bins, func(b string) bool { return b == def })
+					bins = append([]string{def}, bins...)
+				}
+			}
+		}
+	}
+	return bins
+}
+
+// nodeBins are the bin folders of a manager that keeps each version as
+// root/<version>/bin (mise's installs), newest first.
+func nodeBins(root string) []string {
+	var bins []string
+	for _, n := range nodeVersions(root, "bin") {
+		bins = append(bins, filepath.Join(root, n, "bin"))
+	}
+	return bins
+}
+
+// nodeVersions are the names of the version folders under root that have
+// a folder bin (root/<version>/<bin>), highest version first (nodeVersionLess); a name that is
+// no version (mise's "lts", "latest") after every one that is.
+func nodeVersions(root, bin string) []string {
+	es, _ := os.ReadDir(root)
+	var names []string
+	for _, e := range es {
+		if st, err := os.Stat(filepath.Join(root, e.Name(), bin)); err == nil && st.IsDir() {
+			names = append(names, e.Name())
+		}
+	}
+	slices.SortStableFunc(names, func(a, b string) int {
+		switch {
+		case nodeVersionLess(b, a):
+			return -1
+		case nodeVersionLess(a, b):
+			return 1
+		}
+		return strings.Compare(a, b)
+	})
+	return names
+}
+
+// parseNodeVersion reads v22.12.0 (or 22.12.0, mise's, or 22, a partial
+// one) as its numbers; false for a name that isn't one.
+func parseNodeVersion(s string) ([3]int, int, bool) {
+	var v [3]int
+	parts := strings.Split(strings.TrimPrefix(s, "v"), ".")
+	if len(parts) > 3 || parts[0] == "" {
+		return v, 0, false
+	}
+	for i, p := range parts {
+		n, err := strconv.Atoi(p)
+		if err != nil || n < 0 {
+			return v, 0, false
+		}
+		v[i] = n
+	}
+	return v, len(parts), true
+}
+
+// nodeVersionLess says a is a lower version than b, by number: v9 before
+// v22. A name that is no version is lower than one that is.
+func nodeVersionLess(a, b string) bool {
+	va, _, oka := parseNodeVersion(a)
+	vb, _, okb := parseNodeVersion(b)
+	if oka != okb {
+		return okb
+	}
+	return oka && slices.Compare(va[:], vb[:]) < 0
+}
+
+func isDir(p string) bool {
+	st, err := os.Stat(p)
+	return err == nil && st.IsDir()
+}
