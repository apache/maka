diff --git a/internal/gui/tests/mcp-command-lexer.test.cjs b/internal/gui/tests/mcp-command-lexer.test.cjs
new file mode 100644
index 00000000..25bf3fde
--- /dev/null
+++ b/internal/gui/tests/mcp-command-lexer.test.cjs
@@ -0,0 +1,146 @@
+// Run with Node's test runner and Playwright on the module path; see README.md.
+// yetone/magpie#2685: the MCP editor's command field splits a line the way a
+// shell would, and on Windows a backslash is a path separator, not an escape,
+// so a saved command came back with every \ folded away and an absolute path
+// never started. What is typed is kept whole on Windows, quoted words
+// included; a saved server reopens as it was saved; the shell's own escape
+// and quoting are kept on POSIX. In English, Chromium and WebKit. No
+// backend: the API is faked here.
+const assert = require("node:assert/strict");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { test } = require("node:test");
+const { chromium, webkit } = require("playwright");
+
+const assets = path.resolve(__dirname, "../assets");
+const HOME = "/Users/xv";
+const agent = (id, name) => ({ id, name, icon: "", skills: `${HOME}/.${id}/skills`, mcp: `${HOME}/.${id}/mcp.json` });
+const NPX = "C:\\Users\\xxx\\AppData\\Roaming\\fnm\\aliases\\default\\npx.cmd";
+
+function server(lang, saved) {
+  const lib = {
+    dir: `${HOME}/.magpie/library`, backups: `${HOME}/.magpie/backups`, home: HOME,
+    agents: [agent("claude", "Claude Code")],
+    instructions: { agents: [], sets: [] }, foundServers: [], projects: [], foundSkills: [], skills: [],
+    // a server saved with an absolute Windows command, the reporter's shape
+    servers: [{ name: "devtools", transport: "stdio", command: NPX, args: ["-y", "chrome-devtools-mcp@latest"], agents: ["claude"] }],
+  };
+  return async (route) => {
+    const req = route.request(), url = new URL(req.url());
+    if (url.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: `window.bootPrefs = {lang:"${lang}",theme:"light",web:true};` });
+    if (url.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
+    if (url.pathname === "/api/state") return route.fulfill({ json: { agents: [], profiles: [], settings: { lang, theme: "light" } } });
+    if (url.pathname === "/api/plugins") return route.fulfill({ json: { plugins: [] } });
+    if (url.pathname === "/api/library") return route.fulfill({ json: lib });
+    if (url.pathname === "/api/library/mcp/check") return route.fulfill({ json: { servers: {} } });
+    if (url.pathname === "/api/library/servers/save") {
+      saved.push(req.postDataJSON());
+      const { old, server: s } = req.postDataJSON();
+      const i = lib.servers.findIndex((x) => x.name === old);
+      if (i >= 0) lib.servers[i] = { ...lib.servers[i], ...s };
+      return route.fulfill({ json: { ...lib, result: { changed: ["claude"] } } });
+    }
+    if (url.pathname === "/api/usage/quotas") return route.fulfill({ json: [] });
+    if (url.pathname === "/api/groups") return route.fulfill({ json: { groups: [] } });
+    if (url.pathname === "/api/providers") return route.fulfill({ json: { providers: [], gateway: { running: true } } });
+    if (url.pathname.startsWith("/api/")) return route.fulfill({ json: {} });
+    const file = path.join(assets, url.pathname === "/" ? "index.html" : url.pathname);
+    const contentType = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml", ".png": "image/png" }[path.extname(file)];
+    await route.fulfill({ body: await fs.readFile(file), contentType });
+  };
+}
+
+for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium", "webkit"])) {
+  test(engine + ": the MCP command field keeps a Windows path whole", async (t) => {
+    assert(["chromium", "webkit"].includes(engine), "BROWSER must be chromium or webkit");
+    const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: process.env.PLAYWRIGHT_CHANNEL || "chromium" }));
+    const errors = [];
+    t.after(async () => {
+      if (errors.length) console.log(errors);
+      await browser.close();
+    });
+    const saved = [];
+    const ctx = await browser.newContext({ viewport: { width: 1100, height: 800 } });
+    await ctx.addInitScript(() => { try { localStorage.setItem("magpie.libTab", "mcp"); } catch {} });
+    const page = await ctx.newPage();
+    page.setDefaultTimeout(5000);
+    page.on("pageerror", (e) => errors.push(e.message));
+    await page.route("**/*", server("en", saved));
+    await page.goto("http://magpie.test/");
+    await page.locator('button[data-view="library"]').click();
+    const ed = page.locator("#modal .lib-editor");
+    const line = ed.locator("input.mono").first();
+    const save = async () => {
+      // the button reads Save for an edit, Add for a new server
+      await ed.locator("> .bar button.primary").click();
+      await ed.waitFor({ state: "detached" });
+    };
+    const savedServer = (i) => saved[i]?.server || {};
+
+    // a saved server reopens as it was saved, absolute path and all
+    await page.locator("#view-library .lib-server .name", { hasText: "devtools" }).click();
+    await ed.waitFor();
+    assert.equal(await line.inputValue(), `${NPX} -y chrome-devtools-mcp@latest`);
+
+    // typing it again (the reporter's line) keeps it, backslashes and colon
+    await line.fill(`${NPX} -y chrome-devtools-mcp@latest`);
+    await save();
+    assert.equal(savedServer(0).command, NPX);
+    assert.deepEqual(savedServer(0).args, ["-y", "chrome-devtools-mcp@latest"]);
+
+    // double quotes keep a path with spaces in it whole
+    await page.locator("#view-library .lib-server .name", { hasText: "devtools" }).click();
+    await ed.waitFor();
+    await line.fill(`"${NPX.replace("xxx", "me with space")}" -y pkg`);
+    await save();
+    assert.equal(savedServer(1).command, NPX.replace("xxx", "me with space"));
+    assert.deepEqual(savedServer(1).args, ["-y", "pkg"]);
+
+    // a new server typed straight in, the way the placeholder suggests it
+    const add = page.locator("#view-library .after-list button");
+    await page.locator("#view-library").hover();
+    await page.mouse.wheel(0, 2000);
+    await page.waitForFunction(() => { const v = document.querySelector("#view-library"); return v.scrollTop + v.clientHeight >= v.scrollHeight - 1; });
+    await add.click();
+    await ed.waitFor();
+    await ed.locator("input").first().fill("fresh");
+    await line.fill(`"${NPX}" -y pkg`);
+    await save();
+    assert.equal(savedServer(2).command, NPX);
+    assert.deepEqual(savedServer(2).args, ["-y", "pkg"]);
+    await ctx.close();
+
+    // the shell's own semantics stay POSIX: a backslash escapes there
+    const posix = await browser.newContext({ viewport: { width: 1100, height: 800 } });
+    await posix.addInitScript(() => {
+      Object.defineProperty(Navigator.prototype, "platform", { get: () => "MacIntel", configurable: true });
+    });
+    await posix.addInitScript(() => { try { localStorage.setItem("magpie.libTab", "mcp"); } catch {} });
+    const pp = await posix.newPage();
+    pp.setDefaultTimeout(5000);
+    pp.on("pageerror", (e) => errors.push(e.message));
+    const psaved = [];
+    await pp.route("**/*", server("en", psaved));
+    await pp.goto("http://magpie.test/");
+    await pp.locator('button[data-view="library"]').click();
+    const ped = pp.locator("#modal .lib-editor");
+    const pline = ped.locator("input.mono").first();
+    const psave = async () => {
+      await ped.locator("> .bar button.primary").click();
+      await ped.waitFor({ state: "detached" });
+    };
+    await pp.locator("#view-library .lib-server .name", { hasText: "devtools" }).click();
+    await ped.waitFor();
+    await pline.fill(`C:\\Users\\me\\npx.cmd -y pkg`);
+    await psave();
+    assert.equal(psaved[0].server.command, "C:Usersmenpx.cmd", "on POSIX a backslash still escapes");
+    await pp.locator("#view-library .lib-server .name", { hasText: "devtools" }).click();
+    await ped.waitFor();
+    await pline.fill(`/tmp/a\\ b`);
+    await psave();
+    assert.equal(psaved[1].server.command, "/tmp/a b", "on POSIX a backslash escapes a space");
+    await posix.close();
+
+    assert.deepEqual(errors, []);
+  });
+}
