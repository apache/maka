@@ -0,0 +1,43 @@
+package proc
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// fnm on Windows keeps each Node version as
+// node-versions/<v>/installation (node.exe and npx.cmd directly inside,
+// no bin folder), with aliases/default a link to the default version's
+// installation. UserBinDirs offers them, so a bare npx a terminal has
+// through fnm is found without the registry's PATH reaching it (#2685).
+func TestUserBinDirsHasFnmsNode(t *testing.T) {
+	dir := t.TempDir()
+	inst := filepath.Join(dir, "node-versions", "v24.21.0", "installation")
+	old := filepath.Join(dir, "node-versions", "v18.20.8", "installation")
+	for _, d := range []string{inst, old} {
+		if err := os.MkdirAll(d, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// fnm's default alias is a link to the version's installation; the
+	// default's folder comes first when the link can be made, and here it
+	// names the highest version, which comes first either way
+	aliases := filepath.Join(dir, "aliases")
+	if err := os.MkdirAll(aliases, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(inst, filepath.Join(aliases, "default")); err != nil {
+		t.Log("no symlink privilege:", err)
+	}
+	t.Setenv("FNM_DIR", dir)
+	// the sandbox's own folders of the managers whose dirs UserBinDirs
+	// also lists stay empty, so only fnm's two folders exist here
+	t.Setenv("PATH", t.TempDir())
+	have := UserBinDirs()
+	want := []string{inst, old}
+	if !slices.Equal(have, want) {
+		t.Fatalf("UserBinDirs = %q, want %q", have, want)
+	}
+}
