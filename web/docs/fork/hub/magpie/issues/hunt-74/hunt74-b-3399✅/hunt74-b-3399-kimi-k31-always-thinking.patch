+++ b/internal/agent/kimi_efforts_test.go
@@ -62,8 +62,10 @@ func TestKimiEfforts(t *testing.T) {
 	}
 	ms := read(path)
 	for k, want := range map[string]model{
+		// wide has no none among its levels: its thinking can't go off
