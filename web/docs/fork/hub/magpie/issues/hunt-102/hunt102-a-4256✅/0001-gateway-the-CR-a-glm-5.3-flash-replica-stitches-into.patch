+			if ch == nil {
+				continue
+			}
+			delta, _ := ch["delta"].(map[string]any)
+			if delta == nil {
+				continue
+			}
+			calls, _ := delta["tool_calls"].([]any)
+			for _, k := range calls {
+				call, _ := k.(map[string]any)
+				if call == nil {
+					continue
+				}
+				fn, _ := call["function"].(map[string]any)
+				if fn == nil {
+					continue
+				}
+				if a, _ := fn["arguments"].(string); a != "" {
+					pieces = append(pieces, a)
+				}
+			}
+		}
+	}
+	return strings.Join(pieces, "")
