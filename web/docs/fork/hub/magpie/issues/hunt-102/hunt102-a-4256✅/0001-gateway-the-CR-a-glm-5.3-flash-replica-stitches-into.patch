+// crSpy is a stream encoder that records what it is told, for the
+// crEncoder's own tests.
+type crSpy struct {
+	said []Event
+}
+
+func (s *crSpy) event(ev Event) { s.said = append(s.said, ev) }
+func (s *crSpy) finish()        {}
+func (s *crSpy) keepalive()     {}
