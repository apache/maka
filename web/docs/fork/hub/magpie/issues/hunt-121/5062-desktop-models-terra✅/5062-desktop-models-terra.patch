-	if u == nil || model == "" || piGateway(provider) {
+	if u == nil || model == "" || piGateway(agent, provider) {
 		return Call{}, false
 	}
 	if u.Input < 0 || u.Output < 0 || u.CacheRead < 0 || u.CacheWrite < 0 {
