diff --git a/internal/catalog/live.go b/internal/catalog/live.go
index bef54b155..a38b58656 100644
--- a/internal/catalog/live.go
+++ b/internal/catalog/live.go
@@ -590,7 +590,18 @@ func fetchPage(ctx context.Context, url, key string, anthropic bool, headers map
 			return nil, nil, err
 		}
 		defer res.Body.Close()
-		b, _ := io.ReadAll(io.LimitReader(res.Body, 8<<20))
+		b, err := io.ReadAll(io.LimitReader(res.Body, 8<<20))
+		if err != nil {
+			// the read was cut (a deadline, a reset): what arrived is not
+			// a body of the wrong shape, and saying so of it sends the user
+			// looking at the JSON when the body was fine, only short (#5457)
+			return nil, nil, fmt.Errorf("%s: incomplete response: %w", url, err)
+		}
+		if n := res.ContentLength; n > int64(len(b)) {
+			// the connection closed before the body it declared arrived:
+			// the read ended cleanly, so only the count tells the cut
+			return nil, nil, fmt.Errorf("%s: incomplete response: %d of %d bytes", url, len(b), n)
+		}
 		return res, b, nil
 	}
 	res, b, err := ask(auth.only)
diff --git a/internal/catalog/live_incomplete_test.go b/internal/catalog/live_incomplete_test.go
new file mode 100644
index 000000000..a413bcdbb
--- /dev/null
+++ b/internal/catalog/live_incomplete_test.go
@@ -0,0 +1,65 @@
+package catalog
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+// A body the link cut before it ended — a slow relay stops the transfer
+// mid-string — is its own failure, and the message says so: what arrived
+// is not a list of any shape, and pointing at the JSON's shape sends the
+// user looking at the body when the body is fine, only short (#5457).
+func TestFetchURLCutBodySaysIncomplete(t *testing.T) {
+	full := `{"object":"list","data":[{"id":"m1"},{"id":"m2"}]}`
+	srv := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		rw.Header().Set("Content-Type", "application/json")
+		// declared whole, sent cut, the connection closed: what a relay
+		// that gives up mid-body leaves the reader with
+		rw.Header().Set("Content-Length", strconv.Itoa(len(full)))
+		rw.Write([]byte(full[:len(full)/2]))
+	}))
+	defer srv.Close()
+	_, err := FetchURL(context.Background(), srv.URL, "", false, nil)
+	if err == nil {
+		t.Fatal("a cut body was taken for a model list")
+	}
+	if !strings.Contains(err.Error(), "incomplete") {
+		t.Fatalf("a cut body is not told from a body of the wrong shape: %v", err)
+	}
+	if strings.Contains(err.Error(), "not a model list") {
+		t.Fatalf("a cut body is reported as the shape's failure: %v", err)
+	}
+}
+
+// A body still arriving when the fetch's time is up is the same failure:
+// the read is cut with the deadline, and what arrived is no list of any
+// shape (#5457).
+func TestFetchURLStalledBodySaysIncomplete(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		rw.Header().Set("Content-Type", "application/json")
+		rw.Write([]byte(`{"object":"list","data":[{"id":"m1"}`))
+		rw.(http.Flusher).Flush()
+		<-blockStalledBody // the tail never comes within the fetch's time
+	}))
+	defer srv.Close() // registered first, so it runs after the unblock
+	defer close(blockStalledBody)
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+	_, err := FetchURL(ctx, srv.URL, "", false, nil)
+	if err == nil {
+		t.Fatal("a stalled body was taken for a model list")
+	}
+	if !strings.Contains(err.Error(), "incomplete") {
+		t.Fatalf("a stalled body is not told from a body of the wrong shape: %v", err)
+	}
+	if strings.Contains(err.Error(), "not a model list") {
+		t.Fatalf("a stalled body is reported as the shape's failure: %v", err)
+	}
+}
+
+var blockStalledBody = make(chan struct{})
diff --git a/internal/provider/models.go b/internal/provider/models.go
index c6139a6e7..70c3c5ef8 100644
--- a/internal/provider/models.go
+++ b/internal/provider/models.go
@@ -768,6 +768,22 @@ type fetched struct {
 	answered map[string]bool
 }
 
+// fetchPlainAgain is a remote magpie's plain model list asked after its
+// extended catalog's fetch failed: without the X-Magpie-* headers the
+// answer is the plain list, whose body is small enough to come through
+// whole where the catalog's was cut (a slow link, #5457) — the models,
+// without the prices, drawers and decision models, which the next whole
+// fetch brings back. It says whether the plain list answered.
+func (p Provider) fetchPlainAgain(ctx context.Context) (fetched, bool) {
+	if !p.IsRemoteMagpie() || p.plainList {
+		return fetched{}, false
+	}
+	plain := p
+	plain.plainList = true
+	pl, err := plain.fetchOne(ctx)
+	return pl, err == nil
+}
+
 // fetchOne asks every endpoint the provider speaks with p's key, and merges
 // the lists (#904): a vendor serves its models on several protocols, and
 // each protocol's base lists its own (Kimi's Claude models at its Anthropic
@@ -785,6 +801,11 @@ func (p Provider) fetchOne(ctx context.Context) (fetched, error) {
 		}
 		ms, err := catalog.FetchURL(ctx, u, p.Key, anthropic, p.listHeadersAt(u))
 		if err != nil {
+			// a remote magpie whose catalog is cut is asked for its plain
+			// list before the fetch is given up on (#5457)
+			if pl, ok := p.fetchPlainAgain(ctx); ok {
+				return pl, nil
+			}
 			return fetched{}, err
 		}
 		return fetched{catalog.WithDrawers(p.planModels(ms), catalog.PublicDrawers(ctx, u)), u, nil, nil}, nil
@@ -942,6 +963,11 @@ func (p Provider) fetchOne(ctx context.Context) (fetched, error) {
 		if len(errs) == 0 {
 			return fetched{}, errorf("%s has no endpoint to ask", p.Name)
 		}
+		// a remote magpie whose catalog is cut at every endpoint is asked
+		// for its plain list before the fetch is given up on (#5457)
+		if pl, ok := p.fetchPlainAgain(ctx); ok {
+			return pl, nil
+		}
 		// the endpoints are kept as they were: a vendor with no list (or one
 		// that wants what the key can't give) still serves the models typed in
 		return fetched{}, errorf("%s — type its model ids in by hand, or give the URL its list is at", strings.Join(errs, "; "))
diff --git a/internal/provider/provider.go b/internal/provider/provider.go
index 6ddf1bafe..317829980 100644
--- a/internal/provider/provider.go
+++ b/internal/provider/provider.go
@@ -195,6 +195,14 @@ type Provider struct {
 	// magpie that is not that one (hanslin1666 on Discord).
 	KeepSelf bool `json:"keepSelf,omitempty"`
 
+	// plainList, on a Remote magpie, is a fetch asking its plain model
+	// list: without the X-Magpie-* headers, whose answer is the extended
+	// catalog — a far bigger body, which a slow link cuts before it ends,
+	// while the plain list comes through (#5457). Set for the one fetch
+	// that asks the plain list after the catalog's fetch failed; it is not
+	// saved, and the next fetch asks the catalog as always.
+	plainList bool
+
 	// MaxConcurrency is how many requests may be out at the vendor at once
 	// on each of its keys or accounts (Discord, Lemon: a Codex account is
 	// risk-controlled past five or six at once); the rest wait their turn,
diff --git a/internal/provider/remote_magpie.go b/internal/provider/remote_magpie.go
index 19c0304e7..549e20757 100644
--- a/internal/provider/remote_magpie.go
+++ b/internal/provider/remote_magpie.go
@@ -127,6 +127,12 @@ func (p Provider) listHeaders() map[string]string {
 			delete(h, k)
 		}
 	}
+	// the plain list (plainList) is asked without the four headers below:
+	// their answer is the extended catalog, the far bigger body a slow
+	// link cuts before it ends (#5457)
+	if p.plainList {
+		return h
+	}
 	h[DrawersHeader] = "1"
 	h[VideomakersHeader] = "1"
 	h[PricesHeader] = "1"
diff --git a/internal/provider/remote_magpie_slowlist_test.go b/internal/provider/remote_magpie_slowlist_test.go
new file mode 100644
index 000000000..2dc596682
--- /dev/null
+++ b/internal/provider/remote_magpie_slowlist_test.go
@@ -0,0 +1,102 @@
+package provider
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/agentenv"
+)
+
+// The extended catalog a remote magpie answers the X-Magpie-* headers with
+// is a far bigger body than its plain list: over a slow link the transfer
+// is cut before it ends, every time. The plain list — asked without those
+// headers — comes through, and a remote whose catalog can't arrive whole
+// is still added by it: the models, without the prices, drawers and
+// decision models, which the next whole fetch brings back (#5457).
+func TestRemoteMagpieCutCatalogFallsBackToPlainList(t *testing.T) {
+	isolate(t)
+	h := t.TempDir()
+	t.Setenv("HOME", h)
+	t.Setenv("USERPROFILE", h)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(h, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(h, ".cache"))
+	t.Setenv("PATH", h)
+	for _, v := range agentenv.Vars {
+		t.Setenv(v, "")
+	}
+
+	whole := `{"object":"list","data":[` + strings.Repeat(`{"id":"p/big"},`, 500) + `{"id":"p/last"}]}`
+	srv := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Magpie-Deciders") != "" {
+			// the extended catalog: declared whole, sent cut, closed
+			rw.Header().Set("Content-Type", "application/json")
+			rw.Header().Set("Content-Length", strconv.Itoa(len(whole)))
+			rw.Write([]byte(whole[:4096]))
+			return
+		}
+		rw.Header().Set("Content-Type", "application/json")
+		rw.Write([]byte(`{"object":"list","data":[{"id":"p/gpt-6"},{"id":"p/qwen3.6-max"}]}`))
+	}))
+	defer srv.Close()
+
+	if err := Save(Provider{ID: "remote", Name: "Remote", Preset: RemoteMagpiePreset, Chat: srv.URL, Key: "sk-remote"}); err != nil {
+		t.Fatal(err)
+	}
+	p, err := Find("remote")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ms, err := p.Fetch(context.Background())
+	if err != nil {
+		t.Fatalf("a remote whose catalog is cut is added by its plain list: %v", err)
+	}
+	var ids []string
+	for _, m := range ms {
+		ids = append(ids, m.ID)
+	}
+	if len(ids) != 2 {
+		t.Fatalf("the plain list's models: %v", ids)
+	}
+}
+
+// When the plain list is cut too, every endpoint's fetch fails, and what
+// the user is told is that the bodies were cut, not that their shape was
+// wrong (#5457).
+func TestRemoteMagpieCutEverywhereSaysIncomplete(t *testing.T) {
+	isolate(t)
+	h := t.TempDir()
+	t.Setenv("HOME", h)
+	t.Setenv("USERPROFILE", h)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(h, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(h, ".cache"))
+	t.Setenv("PATH", h)
+	for _, v := range agentenv.Vars {
+		t.Setenv(v, "")
+	}
+
+	whole := `{"object":"list","data":[{"id":"p/gpt-6"}]}`
+	srv := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		rw.Header().Set("Content-Type", "application/json")
+		rw.Header().Set("Content-Length", strconv.Itoa(len(whole)))
+		rw.Write([]byte(whole[:10]))
+	}))
+	defer srv.Close()
+
+	if err := Save(Provider{ID: "remote", Name: "Remote", Preset: RemoteMagpiePreset, Chat: srv.URL, Key: "sk-remote"}); err != nil {
+		t.Fatal(err)
+	}
+	p, err := Find("remote")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Fetch(context.Background()); err == nil {
+		t.Fatal("a remote whose every list is cut was taken for fetched")
+	} else if !strings.Contains(err.Error(), "incomplete") || strings.Contains(err.Error(), "not a model list") {
+		t.Fatalf("the cut is not told from the shape: %v", err)
+	}
+}
