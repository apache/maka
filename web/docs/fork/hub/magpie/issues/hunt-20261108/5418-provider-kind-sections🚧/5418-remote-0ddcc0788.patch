+}
+
+// EmbeddingHidden is whether the user unticked p's embedding or rerank
+// model in its editor (HiddenEmbeddings), as SpeechHidden its speech
+// ones (#5418).
+func (p Provider) EmbeddingHidden(model string) bool {
+	return slices.Contains(p.HiddenEmbeddings, model)
+}
diff --git a/internal/provider/plugin_serving_test.go b/internal/provider/plugin_serving_test.go
new file mode 100644
index 0000000000..36e3ac9009
--- /dev/null
+++ b/internal/provider/plugin_serving_test.go
@@ -0,0 +1,44 @@
+package provider
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/catalog"
+)
+
+// Fish-under-sea (#5418): a plugin that says what its models give gets
+// each one its section without a new API. What #3279 drops from the chat
+// lists — an embedding ({"text": false}) and a TTS (audio alone) — is
+// kept apart instead, tagged with its API (Model.Serves), so it sits in
+// its editor section, is listed on /v1/models with its kind, and is
+// found on its API's route. A model said nothing of stays out of all of
+// that whatever its id (embedder-chat), and an image keeps its place
+// (#2792's to place), as the speechless tests hold.
+func TestPluginServingMapsWhatThePluginSays(t *testing.T) {
+	gaiPlugin(t)
+	p, err := Find("google-ai-studio")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids := func(kind string) []string {
+		t.Helper()
+		var out []string
+		for _, m := range PluginServing(*p, kind) {
+			out = append(out, m.ID)
+		}
+		return out
+	}
+	if got := ids(catalog.ServesEmbedding); !slices.Equal(got, []string{"gemini-embedding-001", "bge-m3"}) {
+		t.Fatalf("embeddings %v", got)
+	}
+	if got := ids(catalog.ServesSpeech); !slices.Equal(got, []string{"gemini-2.5-flash-preview-tts"}) {
+		t.Fatalf("speech %v", got)
+	}
+	if got := ids(catalog.ServesRerank); len(got) != 0 {
+		t.Fatalf("rerank %v", got)
+	}
+	if got := ids(""); !slices.Equal(got, []string{"gemini-embedding-001", "bge-m3", "gemini-2.5-flash-preview-tts"}) {
+		t.Fatalf("every serving model %v", got)
+	}
+}
diff --git a/internal/provider/plugins.go b/internal/provider/plugins.go
index f96a0159ca..4bb1db6975 100644
--- a/internal/provider/plugins.go
+++ b/internal/provider/plugins.go
@@ -423,6 +423,51 @@ func pluginTalks(m plugin.Model) bool {
 	return slices.ContainsFunc(m.Outputs, func(k string) bool { return k == "text" || k == "image" || k == "video" })
 }
 
+// PluginServing are the models p, a plugin's provider, lists that its
+// plugin says are made for the API kind names (Model.Serves), in the
+// plugin's order; "" is every such model, whatever its API. What #3279
+// drops from the chat lists is kept apart here instead (Fish-under-sea,
+// #5418): an embedding ({"text": false}) and a TTS (audio alone) are told
+// by what the plugin declares, not the model's id, so one whose id names
+// nothing is still found, and a model said nothing of is none of them.
+func PluginServing(p Provider, kind string) []catalog.Model {
+	if !p.IsPlugin() {
+		return nil
+	}
+	pp, ok := PluginOf(p.ID)
+	if !ok {
+		return nil
+	}
+	var out []catalog.Model
+	for _, m := range pp.Models {
+		serves := pluginServesOf(m)
+		if serves == "" || kind != "" && serves != kind {
+			continue
+		}
+		name := m.Name
+		if name == "" || name == m.ID {
+			name = m.ID
+		}
+		out = append(out, catalog.Model{ID: m.ID, Name: name, Provider: p.ID, Serves: serves})
+	}
+	return out
+}
+
+// pluginServesOf is the API a plugin's model is made for, as its plugin
+// declares (capabilities.output): audio alone is speech, outputs said and
+// none given ({"text": false}) is an embedding. A model to talk with (a
+// text among the outputs, an image's or a video's place, or nothing said)
+// is made for none.
+func pluginServesOf(m plugin.Model) string {
+	if pluginTalks(m) {
+		return ""
+	}
+	if slices.Contains(m.Outputs, "audio") {
+		return catalog.ServesSpeech
+	}
+	return catalog.ServesEmbedding
+}
+
 // pluginPrice is m's price as its plugin gives it (m.Cost), if it gives
 // one: OpenCode's price of a model it has none for is 0, so only an input
 // or output price above it is one. A cache price of 0 is none given.
