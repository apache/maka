+// 原生 compact 没有自己的 Routing turn；它的失败不能占用上一轮的 route。
+func TestCodexCompactFailureKeepsTheTurnRoute(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		auth   string
+		status int
+		body   string
+	}{
+		{name: "api-key-refused", auth: "Bearer sk-synthetic", status: http.StatusUnauthorized, body: `{"error":{"message":"invalid_api_key"}}`},
+		{name: "api-key-empty-failure", auth: "Bearer sk-synthetic", status: http.StatusInternalServerError},
+		{name: "chatgpt-empty-failure", auth: "Bearer chatgpt-token", status: http.StatusInternalServerError},
+		{name: "chatgpt-refused", auth: "Bearer chatgpt-token", status: http.StatusForbidden, body: `{"error":{"message":"denied"}}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			setup(t, provider.Chat, &fake{t: t})
+			up := chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+				if strings.HasSuffix(r.URL.Path, "/responses/compact") {
+					w.Header().Set("Content-Type", "application/json")
+					w.WriteHeader(tc.status)
+					io.WriteString(w, tc.body)
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				io.WriteString(w, sse(`data: {"type":"response.completed","response":{"id":"r1","usage":{"input_tokens":4,"output_tokens":1}}}`))
+			})
+			was := codexAPIBase
+			codexAPIBase = up.URL + "/v1"
+			t.Cleanup(func() { codexAPIBase = was })
+			s := New()
+			req := httptest.NewRequest("POST", CodexPath+"/responses", strings.NewReader(`{"model":"gpt-5.5","stream":true,"input":"hi"}`))
+			req.Header.Set("Authorization", tc.auth)
+			rec := httptest.NewRecorder()
+			s.Handler().ServeHTTP(rec, req)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("turn: %d %s", rec.Code, rec.Body.String())
+			}
+			before := s.Trace(t.Context(), 0, 0)
+			if len(before.Routes) != 1 {
+				t.Fatalf("turn has %d routes, want 1", len(before.Routes))
+			}
+			route := before.Routes[0].ID
+			turn, ok := s.RouteCall(route)
+			if !ok || turn.Status != http.StatusOK {
+				t.Fatalf("turn route %d: call %+v, found %v", route, turn, ok)
+			}
+			req = httptest.NewRequest("POST", CodexPath+"/responses/compact", strings.NewReader(`{"model":"gpt-5.5","input":"hi"}`))
+			req.Header.Set("Authorization", tc.auth)
+			rec = httptest.NewRecorder()
+			s.Handler().ServeHTTP(rec, req)
+			if rec.Code != tc.status {
+				t.Fatalf("compact: %d %s, want %d", rec.Code, rec.Body.String(), tc.status)
+			}
+			if tc.status != http.StatusUnauthorized && rec.Body.String() != tc.body {
+				t.Errorf("compact body %q, want upstream's %q", rec.Body.String(), tc.body)
+			}
+			after := s.Trace(t.Context(), 0, 0)
+			if len(after.Routes) != 1 || after.Routes[0].ID != route || after.Routes[0].Status != http.StatusOK {
+				t.Fatalf("compact changed the turn's routes: %+v", after.Routes)
+			}
+			got, ok := s.RouteCall(route)
+			if !ok || got.ID != turn.ID || got.Status != http.StatusOK {
+				t.Errorf("compact replaced turn call %d with %+v (found %v)", turn.ID, got, ok)
+			}
+			if _, ok := s.RouteCall(0); ok {
+				t.Error("compact without a route became a Routing request")
+			}
+			for _, call := range s.Recent() {
+				if call.ID != turn.ID && call.Route != 0 {
+					t.Errorf("compact call acquired turn route: %+v", call)
+				}
+			}
+		})
 	}
 }
 
