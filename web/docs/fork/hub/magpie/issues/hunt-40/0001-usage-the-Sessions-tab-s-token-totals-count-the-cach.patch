+        top: { tokens: TOPS, cost: TOPS, active: TOPS },
+        messages: days.map((d) => d.usage.length ? 10 : 0), output: days.map(() => 0),
+        shape: {
+          messages: { edges: [1, 6, 16, 31, 61, 121], counts: [2], total: 2 },
