diff --git a/internal/gateway/codex_backend_test.go b/internal/gateway/codex_backend_test.go
index 781a0d17..1f75b5fa 100644
--- a/internal/gateway/codex_backend_test.go
+++ b/internal/gateway/codex_backend_test.go
@@ -1139,3 +1139,131 @@ func TestCodexModelListOwnOnlyForFailover(t *testing.T) {
 		t.Errorf("%d X-Models-Etag %q", rec.Code, got)
 	}
 }
+
+// poolBackend stands in for the ChatGPT backend in a test that has already
+// signed its Codex in: chatgpt() moves HOME, which takes that sign-in with
+// it, and the pool would dissolve (usedUp, newResetBackend don't move it).
+func poolBackend(t *testing.T, h http.HandlerFunc) *httptest.Server {
+	t.Helper()
+	up := httptest.NewServer(h)
+	t.Cleanup(up.Close)
+	was := provider.CodexBase
+	provider.CodexBase = up.URL + "/backend-api/codex"
+	t.Cleanup(func() { provider.CodexBase = was })
+	return up
+}
+
+// One of Codex's own models served through magpie's account pool asks the
+// compaction policy there, as a magpie model does (#2582): with the toggle
+// off, the trigger is answered magpie's portable summary and the backend
+// is never asked Codex's compaction, so the conversation it seals follows
+// any account on; with the toggle on, the trigger is relayed as it came.
+func TestCodexOwnModelCompactionThroughThePoolFollowsTheToggle(t *testing.T) {
+	codexSignedIn(t, "spare@example.com")
+	var got [][]byte
+	var accts []string
+	nextOut := false
+	poolBackend(t, func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		got = append(got, b)
+		acct := r.Header.Get("chatgpt-account-id")
+		accts = append(accts, acct)
+		if strings.Contains(string(b), "compaction_trigger") {
+			// the backend compacts natively when it is asked to
+			w.Header()["Content-Type"] = nil
+			io.WriteString(w, nativeSealedReply("gAAAAB-native-seal"))
+			return
+		}
+		if nextOut && acct == "acct-1" {
+			w.WriteHeader(429)
+			io.WriteString(w, `{"error":{"type":"usage_limit_reached","message":"The usage limit has been reached","plan_type":"plus","resets_in_seconds":7200}}`)
+			return
+		}
+		w.Header()["Content-Type"] = nil
+		io.WriteString(w, sse(
+			`data: {"type":"response.output_item.done","output_index":0,"item":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"SUMMARY TEXT"}]}}`,
+			`data: {"type":"response.completed","response":{"id":"r1","status":"completed","output":[],"usage":{"input_tokens":7,"output_tokens":1}}}`))
+	})
+
+	// off: magpie summarises, the trigger never reaches the backend
+	turn := `{"model":"gpt-5.5","stream":true,"tools":[{"type":"web_search"}],"input":[{"type":"message","role":"user","content":[{"type":"input_text","text":"fix the bug"}]},{"type":"compaction_trigger"}]}`
+	code, body := codexPost(t, turn)
+	if code != 200 || !strings.Contains(body, magpieCompaction) {
+		t.Fatalf("off: %d %s", code, body)
+	}
+	if len(got) != 1 || strings.Contains(string(got[0]), "compaction_trigger") || !strings.Contains(string(got[0]), "CONTEXT CHECKPOINT COMPACTION") {
+		t.Fatalf("the backend wasn't asked magpie's summary request: %d, %s", len(got), string(got[len(got)-1]))
+	}
+	var item map[string]any
+	for _, e := range events(body) {
+		if e["type"] == "response.output_item.done" {
+			item = e["item"].(map[string]any)
+		}
+	}
+	enc, _ := item["encrypted_content"].(string)
+	if item["type"] != "compaction" || !strings.HasPrefix(enc, magpieCompaction) {
+		t.Fatalf("the summary isn't magpie's portable one: %v", item)
+	}
+
+	// the conversation follows the next account on: the writer is out of
+	// its allowance, the spare reads the summary as text
+	nextOut = true
+	code, body = codexPost(t, `{"model":"gpt-5.5","stream":true,"input":[{"type":"compaction","encrypted_content":"`+enc+`"},{"type":"message","role":"user","content":[{"type":"input_text","text":"go on"}]}]}`)
+	if code != 200 {
+		t.Fatalf("next turn: %d %s", code, body)
+	}
+	followed := false
+	for _, a := range accts {
+		if a == "acct-2" {
+			followed = true
+		}
+	}
+	if !followed {
+		t.Errorf("the conversation didn't follow the spare: %v", accts)
+	}
+	last := string(got[len(got)-1])
+	if strings.Contains(last, magpieCompaction) || strings.Contains(last, "compaction") ||
+		!strings.Contains(last, codexSummaryPrefix) || !strings.Contains(last, "SUMMARY TEXT") {
+		t.Errorf("the summary didn't go to the spare as text: %s", last)
+	}
+
+	// on: the trigger is relayed as it came, the seal going back as it came
+	got, accts = nil, nil
+	nativeOn(t, "codex")
+	code, body = codexPost(t, turn)
+	if code != 200 || !strings.Contains(body, `"encrypted_content":"gAAAAB-native-seal"`) || strings.Contains(body, magpieCompaction) {
+		t.Fatalf("on: %d %s", code, body)
+	}
+	if len(got) != 1 || !strings.Contains(string(got[0]), "compaction_trigger") {
+		t.Errorf("the backend wasn't asked Codex's own compaction: %d, %s", len(got), string(got[len(got)-1]))
+	}
+}
+
+// The legacy compact endpoint, asked of one of Codex's own models served
+// through the pool, follows the toggle too (#2582): refused with the way
+// on when it is off, as a magpie model's is, relayed as it came when on.
+func TestCodexOwnModelCompactEndpointFollowsTheToggle(t *testing.T) {
+	codexSignedIn(t, "spare@example.com")
+	var asked int
+	poolBackend(t, func(w http.ResponseWriter, r *http.Request) {
+		asked++
+		io.WriteString(w, `{"id":"r1","output":[]}`)
+	})
+	post := func() (int, string) {
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest("POST", CodexPath+"/responses/compact", strings.NewReader(`{"model":"gpt-5.5","input":"hi","stream":true}`))
+		req.Header.Set("Authorization", "Bearer chatgpt-token")
+		req.Header.Set("chatgpt-account-id", "acct-1")
+		New().Handler().ServeHTTP(rec, req)
+		return rec.Code, rec.Body.String()
+	}
+	code, body := post()
+	if code != 400 || !strings.Contains(body, "compaction_trigger") || asked != 0 {
+		t.Fatalf("off: %d %s, asked %d", code, body, asked)
+	}
+	nativeOn(t, "codex")
+	code, body = post()
+	if code != 200 || asked != 1 {
+		t.Fatalf("on: %d %s, asked %d", code, body, asked)
+	}
+}
