+		nativeOn(t, "codex")
+		wroteCheckpoint("gAAAAB-sealed-by-me", account("me@example.com"))
+		code, body, seen := compact("gAAAAB-sealed-by-me", "")
+		if code != 200 || seen != "" { // relayed as it came: no account id added
