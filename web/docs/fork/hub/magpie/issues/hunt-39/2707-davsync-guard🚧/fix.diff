+// GitHub judges a commit by the Base64-encoded request, not the raw file
+// (issue #2707): the reporter's 57,333,552-byte sealed backup (76,444,736
+// characters encoded) passed magpie's raw-file guard and came back as a
+// bare HTTP 422. The refusal now happens before the upload, with the ways
+// out; GitHub's exact threshold is undocumented, so the cap is what magpie
+// commits, not a limit GitHub is known to take.
+func TestGitHubUploadOverTheEncodedLimit(t *testing.T) {
+	f := newGithubFixture(t)
+	g, err := newGitHub(githubConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	_, err = g.put(ctx, make([]byte, 57333552), "")
+	if err == nil || f.writes != 0 {
+		t.Fatalf("a backup GitHub would refuse must be stopped before upload: %v, writes %d", err, f.writes)
+	}
+	if !strings.Contains(err.Error(), "Base64") || !strings.Contains(err.Error(), "WebDAV or S3") {
+		t.Fatalf("the refusal should explain the encoded upload and the ways out: %v", err)
+	}
+	v, err := g.put(ctx, make([]byte, githubMaxFile/4*3), "")
+	if err != nil {
+		t.Fatalf("a backup whose encoded form is exactly the cap must still commit: %v", err)
+	}
+	if _, err := g.put(ctx, make([]byte, githubMaxFile/4*3+1), v.ETag); err == nil || f.writes != 1 {
+		t.Fatalf("one byte over the encoded cap must be refused: %v, writes %d", err, f.writes)
+	}
+}
