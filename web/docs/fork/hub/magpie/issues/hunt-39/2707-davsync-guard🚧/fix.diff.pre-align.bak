diff --git a/internal/davsync/github.go b/internal/davsync/github.go
index e593f570..b8f72080 100644
--- a/internal/davsync/github.go
+++ b/internal/davsync/github.go
@@ -18,6 +18,12 @@ import (
 
 const githubMaxFile = 64 << 20
 
+// GitHub receives a committed file Base64-encoded inside the JSON body, and
+// refuses an upload whose encoded form is too large (HTTP 422, issue #2707):
+// what the API judges is the request, not the raw file, so at most
+// githubMaxFile/4*3 of backup data is committed in one call.
+const githubMaxUpload = githubMaxFile / 4 * 3
+
 type github struct {
 	repo, prefix, branch, token string
 	ready                       bool
@@ -267,8 +273,9 @@ func (g *github) get(ctx context.Context, have version) ([]byte, version, error)
 }
 
 func (g *github) commit(ctx context.Context, name string, data []byte, sha string, remove bool) (version, error) {
-	if len(data) > githubMaxFile {
-		return version{}, errors.New("the GitHub sync file exceeds 64 MiB")
+	if len(data) > githubMaxUpload {
+		return version{}, fmt.Errorf("the GitHub sync file is %d MiB, over the %d MiB magpie commits through the Contents API: GitHub receives the file Base64-encoded, and refuses an upload whose encoded form is over %d MiB. Sync less, for example without the library, or update the backup in a local clone and push it",
+			len(data)>>20, githubMaxUpload>>20, githubMaxFile>>20)
 	}
 	if err := g.prepare(ctx); err != nil {
 		return version{}, err
@@ -305,6 +312,13 @@ func (g *github) commit(ctx context.Context, name string, data []byte, sha strin
 		if strings.Contains(string(body), `\"sha\" wasn't supplied`) {
 			return version{}, errChanged
 		}
+		// GitHub's own refusal text (no documented size, issue #2707) names
+		// the way out; the sync adds the magpie-side lever.
+		var refused struct{ Message string }
+		json.Unmarshal(body, &refused)
+		if strings.Contains(refused.Message, "too large") {
+			return version{}, fmt.Errorf("GitHub refused the sync file as too large (HTTP 422): %s. Sync less to fit, for example without the library", refused.Message)
+		}
 		res.Body = io.NopCloser(bytes.NewReader(body))
 	}
 	if res.StatusCode != http.StatusOK && res.StatusCode != http.StatusCreated {
diff --git a/internal/davsync/github_test.go b/internal/davsync/github_test.go
index 60313c03..c19e7aa9 100644
--- a/internal/davsync/github_test.go
+++ b/internal/davsync/github_test.go
@@ -559,6 +559,58 @@ func TestGitHubFailures(t *testing.T) {
 	})
 }
 
+// GitHub judges a commit by the Base64-encoded request, not the raw file
+// (issue #2707): the reporter's 57,333,552-byte sealed backup (76,444,736
+// characters encoded) passed magpie's raw-file guard and came back as a
+// bare HTTP 422. The refusal now happens before the upload, with the way out.
+func TestGitHubUploadOverTheEncodedLimit(t *testing.T) {
+	f := newGithubFixture(t)
+	g, err := newGitHub(githubConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	_, err = g.put(ctx, make([]byte, 57333552), "")
+	if err == nil || f.writes != 0 {
+		t.Fatalf("a backup GitHub would refuse must be stopped before upload: %v, writes %d", err, f.writes)
+	}
+	if !strings.Contains(err.Error(), "Base64") || !strings.Contains(err.Error(), "local clone") {
+		t.Fatalf("the refusal should explain the encoded upload and the way out: %v", err)
+	}
+	v, err := g.put(ctx, make([]byte, githubMaxFile/4*3), "")
+	if err != nil {
+		t.Fatalf("a backup whose encoded form is exactly the cap must still commit: %v", err)
+	}
+	if _, err := g.put(ctx, make([]byte, githubMaxFile/4*3+1), v.ETag); err == nil || f.writes != 1 {
+		t.Fatalf("one byte over the encoded cap must be refused: %v, writes %d", err, f.writes)
+	}
+}
+
+// A too-large refusal that gets past the guard (GitHub documents no exact
+// threshold) must not reach the user as a bare HTTP 422: GitHub's own text
+// names the way out, and the sync adds the magpie-side lever.
+func TestGitHub422TooLargeExplained(t *testing.T) {
+	f := newGithubFixture(t)
+	g, err := newGitHub(githubConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	if _, _, err := g.get(ctx, version{}); err != nil {
+		t.Fatal(err)
+	}
+	f.mu.Lock()
+	f.status, f.message = 422, "Sorry, the file is too large to be processed. Consider creating/updating the file in a local clone and pushing it to GitHub."
+	f.mu.Unlock()
+	_, err = g.put(ctx, []byte("sealed fixture"), "")
+	if err == nil || errors.Is(err, errChanged) || f.writes != 0 {
+		t.Fatalf("a too-large refusal must not become a racing write: %v, writes %d", err, f.writes)
+	}
+	if !strings.Contains(err.Error(), "too large to be processed") || !strings.Contains(err.Error(), "without the library") {
+		t.Fatalf("GitHub's refusal and the way out should reach the user: %v", err)
+	}
+}
+
 // A public repository would give anyone every sealed version of the setup,
 // its whole history, to try passphrases on: sync refuses it before writing.
 func TestGitHubPublicRepositoryRefused(t *testing.T) {
