---
 internal/library/projects.go      |  7 ++++++
 internal/library/projects_test.go | 39 +++++++++++++++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/internal/library/projects.go b/internal/library/projects.go
index b9b04854..f316f7cc 100644
--- a/internal/library/projects.go
+++ b/internal/library/projects.go
@@ -389,6 +389,13 @@ func RemoveProject(dir string, keep bool) (*Result, error) {
 			l.Projects = slices.DeleteFunc(l.Projects, func(x *Project) bool { return x == p })
 			return nil
 		}
+		// a folder that's gone has nothing of magpie's on disk to take
+		// back: the records of what it placed and wrote go with the
+		// entry, as a skill's do when its folder is gone already (#3510)
+		if fi, err := os.Stat(p.Dir); err != nil || !fi.IsDir() {
+			l.Projects = slices.DeleteFunc(l.Projects, func(x *Project) bool { return x == p })
+			return nil
+		}
 		p.Skills, p.Servers = nil, nil
 		l.syncProject(p, &Result{})
 		if len(p.Placed) == 0 && len(p.Wrote) == 0 {
diff --git a/internal/library/projects_test.go b/internal/library/projects_test.go
index e21a8b13..2053ffb2 100644
--- a/internal/library/projects_test.go
+++ b/internal/library/projects_test.go
@@ -250,3 +250,42 @@ func TestRemoveSkillWhoseFolderIsGone(t *testing.T) {
 		t.Error("pdf still listed")
 	}
 }
+
+// #3510: a project whose folder was deleted outside magpie comes off the
+// list when it's removed: there's nothing of magpie's on disk to take
+// back, so the records of what it placed go with the entry, and the
+// removal says nothing failed. keep takes a gone project off the list as
+// it always did (#514).
+func TestRemoveProjectWhoseFolderIsGone(t *testing.T) {
+	_, proj := projectLib(t)
+	ok(t)(ProjectSkill(proj, "pdf", []string{"claude", "codex"}))
+	if v, _ := Read(nil); len(v.Projects) != 1 || len(v.Projects[0].Placed) == 0 {
+		t.Fatalf("projects: %+v", v.Projects)
+	}
+	if err := os.RemoveAll(proj); err != nil {
+		t.Fatal(err)
+	}
+	r, err := RemoveProject(proj, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Problems) != 0 {
+		t.Errorf("the removal said: %+v", r.Problems)
+	}
+	if v, _ := Read(nil); len(v.Projects) != 0 {
+		t.Errorf("projects: %+v", v.Projects)
+	}
+	if v, _ := Read(nil); len(v.Skills) != 2 {
+		t.Errorf("skills: %+v", v.Skills)
+	}
+
+	_, proj = projectLib(t)
+	ok(t)(ProjectSkill(proj, "docx", []string{"claude"}))
+	if err := os.RemoveAll(proj); err != nil {
+		t.Fatal(err)
+	}
+	ok(t)(RemoveProject(proj, true))
+	if v, _ := Read(nil); len(v.Projects) != 0 {
+		t.Errorf("kept projects: %+v", v.Projects)
+	}
+}
