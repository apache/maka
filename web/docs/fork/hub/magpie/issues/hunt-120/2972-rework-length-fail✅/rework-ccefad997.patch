+		{"anthropic", "/v1/messages", `{"model":"qo/dfmodel","stream":true,"max_tokens":100,"messages":[{"role":"user","content":"hi"}]}`, `"stop_reason":"max_tokens"`},
+	} {
+		calls = 0
