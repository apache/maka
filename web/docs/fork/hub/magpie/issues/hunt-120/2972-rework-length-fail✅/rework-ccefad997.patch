+		if code != 200 || !strings.Contains(body, a.ended) || strings.Contains(body, "an empty reply") || calls != 1 {
+			t.Errorf("%s: a short probe's void answered %d after %d calls, not relayed as it came: %s", a.name, code, calls, body)
+		}
+	}
+}
