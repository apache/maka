@@ -373,6 +373,125 @@ func TestWSLStoppedSinceNotOpened(t *testing.T) {
 	}
 }
 
+// A dsh in a WSL distro keeps its sessions in the distro's ~/.dsh (#2771,
+// li1how): they are listed with the distro as this computer's are, the
+// subagent counts in its parent's session, its calls count in usage, and a
+// session is deleted and restored from the distro's own folders and cached
+// rows, not this computer's.
+func TestWSLDshSessionsListed(t *testing.T) {
+	setup(t)
+	dir := t.TempDir()
+	t.Setenv("DSH_HOME", filepath.Join(dir, "own-dsh")) // this computer's, empty
+	if err := os.MkdirAll(filepath.Join(dir, "own-dsh"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	home := filepath.Join(dir, "Ubuntu", "home", "me")
+	dsh := filepath.Join(home, ".dsh")
+	dshSession(t, dsh, dshP, `{"type":"session","version":4,"id":"`+dshP+`","createdAt":1790503200000,"cwd":"/work/app","isSeeded":false,"delegationDepth":0}`, "Tidy the build script")
+	dshSession(t, dsh, dshC, `{"type":"session","version":4,"id":"`+dshC+`","createdAt":1790503230000,"cwd":"/work/app","isSeeded":false,"delegationDepth":1,"parentSession":"`+dshP+`","origin":"subagent"}`, "Find the flaky test")
+	dshSession(t, dsh, dshO, `{"type":"session","version":4,"id":"`+dshO+`","createdAt":1790503300000,"cwd":"/work/app","isSeeded":false,"delegationDepth":0}`, "Write the release notes")
+	old := time.Now().Add(-time.Hour)
+	filepath.WalkDir(home, func(p string, _ os.DirEntry, _ error) error { return os.Chtimes(p, old, old) })
+	WSLHomes = func() []WSLHome { return []WSLHome{{Distro: "Ubuntu", Home: home, Running: true}} }
+	t.Cleanup(func() { wslSettle(); WSLHomes = nil; Reset() })
+	Reset()
+
+	ss := List(0)
+	var d *Session
+	for i := range ss {
+		if ss[i].Agent != "dsh" {
+			continue
+		}
+		if ss[i].WSL != "Ubuntu" {
+			t.Fatalf("a dsh session not from the distro: %+v", ss[i])
+		}
+		d = &ss[i]
+	}
+	if d == nil {
+		t.Fatalf("no dsh session from the distro in %+v", ss)
+	}
+	if d.ID != dshP || d.Cwd != "/work/app" || d.Title != "Tidy the build script" || d.Tokens.zero() {
+		t.Fatalf("the distro's dsh session: %+v", d)
+	}
+	// the subagent counts in its parent's session, as it does here
+	for _, s := range ss {
+		if s.Agent == "dsh" && s.ID == dshC {
+			t.Fatalf("the subagent is listed as its own session: %+v", s)
+		}
+	}
+	calls := map[string]int{}
+	for _, c := range Calls(time.Time{}) {
+		calls[c.Agent]++
+	}
+	if calls["dsh"] == 0 {
+		t.Fatalf("the distro's dsh calls aren't counted: %v", calls)
+	}
+	in := false
+	for _, dir := range Dirs() {
+		in = in || dir == dsh
+	}
+	if !in {
+		t.Fatalf("the distro's .dsh isn't among the dirs: %v", Dirs())
+	}
+
+	wslSettle()
+	m, ok := findManaged(ListAgent("dsh"), dshP)
+	if !ok || m.WSL != "Ubuntu" || !m.Deletable {
+		t.Fatalf("the WSL dsh session listed as %+v, %v", m, ok)
+	}
+	tr, err := Delete("dsh", dshP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(tr.Items) != 4 {
+		t.Fatalf("trashed %+v, want the session's folder, its subagent's and their two cached rows", tr)
+	}
+	proj := filepath.Join(dsh, "sessions", dshProjD)
+	cache := filepath.Join(dsh, "storages", "session_projcache", "sessions")
+	for _, p := range []string{
+		m.Path,
+		filepath.Join(proj, dshC, "session.v4.jsonl.zstd"),
+		filepath.Join(cache, dshP+".json"),
+		filepath.Join(cache, dshC+".json"),
+	} {
+		if _, err := os.Lstat(p); err == nil {
+			t.Fatalf("%s is still there", p)
+		}
+	}
+	// the other session's files and row in the distro are as they were
+	for _, p := range []string{
+		filepath.Join(proj, dshO, "session.v4.jsonl.zstd"),
+		filepath.Join(cache, dshO+".json"),
+	} {
+		if _, err := os.Stat(p); err != nil {
+			t.Fatalf("another session's %s: %v", p, err)
+		}
+	}
+	// nothing of this computer's .dsh was moved
+	if es, err := os.ReadDir(filepath.Join(dir, "own-dsh")); err != nil || len(es) != 0 {
+		t.Fatalf("this computer's own dsh folder: %v, %d entries", err, len(es))
+	}
+	if _, ok := findManaged(ListAgent("dsh"), dshP); ok {
+		t.Fatal("still listed")
+	}
+	if _, err := Restore(tr.Key); err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range []string{
+		m.Path,
+		filepath.Join(proj, dshC, "session.v4.jsonl.zstd"),
+		filepath.Join(cache, dshP+".json"),
+		filepath.Join(cache, dshC+".json"),
+	} {
+		if _, err := os.Stat(p); err != nil {
+			t.Fatalf("%s wasn't restored: %v", p, err)
+		}
+	}
+	if m, ok := findManaged(ListAgent("dsh"), dshP); !ok || m.WSL != "Ubuntu" || m.Title != "Tidy the build script" {
+		t.Fatalf("restored session listed as %+v, %v", m, ok)
+	}
+}
