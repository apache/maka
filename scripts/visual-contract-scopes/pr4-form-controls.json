{
  "slice": "pr4-form-controls",
  "scopes": [
    {
      "name": "composer-textarea",
      "selectors": ["[data-maka-contract=\"composer-input\"]"]
    },
    {
      "name": "astryx-form-controls",
      "selectors": [
        ":is(.astryx-field, .astryx-switch, .astryx-checkbox-input, .astryx-radio-list, .astryx-radio-list-item, .astryx-selectable-card)"
      ]
    },
    {
      "name": "general-personalization-card",
      "selectors": [".settingsStructuredPage > .settingsStructuredPage"]
    },
    {
      "name": "general-privacy-card",
      "selectors": [
        ".settingsStructuredPage:has(> .settingsStructuredPage) > .settingsRows:nth-child(2)"
      ]
    },
    {
      "name": "general-defaults-card",
      "selectors": [
        ".settingsStructuredPage:has(> .settingsStructuredPage) > .settingsRows:nth-child(3)"
      ]
    },
    {
      "name": "general-proxy-card",
      "selectors": [
        ".settingsStructuredPage:has(> .settingsStructuredPage) > .settingsRows:nth-child(4)"
      ]
    },
    {
      "name": "general-page-layout",
      "selectors": [".settingsStructuredPage:has(> .settingsStructuredPage)"]
    },
    {
      "name": "general-scroll-layout",
      "selectors": [
        ".settingsPageContentInner:has(> .settingsStructuredPage > .settingsStructuredPage)"
      ]
    },
    {
      "name": "provider-catalog-search",
      "selectors": [".providerCatalogSearch"]
    },
    {
      "name": "mcp-catalog-search",
      "selectors": [".maka-mcp-search"]
    }
  ]
}
