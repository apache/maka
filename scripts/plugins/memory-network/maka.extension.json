{
  "schemaVersion": 1,
  "id": "dev.maka.memory-network",
  "displayName": "历史信息网",
  "description": "多维 index、原文引用和未覆盖增量；与持续任务独立。",
  "runtime": {
    "entry": "dist/host.mjs"
  },
  "configuration": {
    "properties": {
      "dataDirectory": {
        "type": "string",
        "description": "独立 SQLite 数据目录，留空自动创建。"
      },
      "tickMs": {
        "type": "number",
        "default": 30000
      },
      "intervalMs": {
        "type": "number",
        "default": 43200000,
        "description": "定时维护周期，默认 12 小时；到期才扫描来源。"
      },
      "threshold": {
        "type": "number",
        "default": 100,
        "description": "兼容旧配置；定时维护不再使用数量阈值。"
      },
      "retryMs": {
        "type": "number",
        "default": 60000
      },
      "runTimeoutMs": {
        "type": "number",
        "default": 600000
      }
    }
  },
  "composition": {
    "patch": "maka.composition.json"
  }
}
