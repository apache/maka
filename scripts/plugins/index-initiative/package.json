{
  "name": "@maka/index-initiative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare:test": "npm run build --prefix ../memory-network && node scripts/main-api.mjs",
