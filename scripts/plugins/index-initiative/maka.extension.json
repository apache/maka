{
  "schemaVersion": 1,
  "id": "dev.maka.index-initiative",
  "displayName": "个人助手",
  "description": "统一聊天入口、主动探索和任务反馈；无需预先导入历史。",
  "runtime": {
    "entry": "dist/host.mjs"
  },
  "configuration": {
    "properties": {
      "dataDirectory": {
        "type": "string"
      },
      "tickMs": {
        "type": "number",
        "default": 5000
      },
      "runTimeoutMs": {
        "type": "number",
        "default": 600000
      }
    }
  },
  "composition": {
    "patch": "maka.composition.json"
  },
  "client": {
    "entry": "dist/client.js"
  }
}
