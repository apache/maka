<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows10.0.22621.0 pulls in the Windows SDK projection
         (Windows.Graphics.Capture etc.). Plain net8.0-windows has none. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>MakaCuWindows</RootNamespace>
    <AssemblyName>maka-cu-windows</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Spike v0: dev loop is framework-dependent. Single-file self-contained
         publish is exercised separately (see README, D3). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides System.Windows.Automation (UIAutomationClient) without pulling
         in WinForms/WPF. Part of the Windows Desktop shared framework. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>